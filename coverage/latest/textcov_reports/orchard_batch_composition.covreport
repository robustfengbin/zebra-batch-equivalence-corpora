  116|      6|        meta.create_gate("Running sum coordinates check", |meta| {
  117|       |            let q_mul_fixed_running_sum =
  118|       |                meta.query_selector(self.running_sum_config.q_range_check());
  119|       |
  120|       |            let z_cur = meta.query_advice(self.window, Rotation::cur());
  121|       |            let z_next = meta.query_advice(self.window, Rotation::next());
  122|       |
  123|       |            //    z_{i+1} = (z_i - a_i) / 2^3
  124|       |            // => a_i = z_i - z_{i+1} * 2^3
  125|       |            let word = z_cur - z_next * pallas::Base::from(H as u64);
  126|       |
