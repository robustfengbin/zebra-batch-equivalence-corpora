 1321|     12|                let j_prime_check = j + two_pow_130 - t_p - j_prime;
 1322|       |
 1323|     12|                iter::empty()
 1324|     12|                    .chain(Some(("k3_check", k3_check)))
 1325|     12|                    .chain(Some(("j_check", j_check)))
 1326|     12|                    .chain(Some(("y_check", y_check)))
 1327|     12|                    .chain(Some(("j_prime_check", j_prime_check)))
