  561|     24|    fn assign(
  562|     24|        &self,
  563|     24|        layouter: &mut impl Layouter<pallas::Base>,
  564|     24|        g: NoteCommitPiece,
  565|     24|        g_0: RangeConstrained<pallas::Base, Value<pallas::Base>>,
  566|     24|        g_1: RangeConstrained<pallas::Base, AssignedCell<pallas::Base, pallas::Base>>,
  567|     24|        z1_g: AssignedCell<pallas::Base, pallas::Base>,
  568|     24|    ) -> Result<AssignedCell<pallas::Base, pallas::Base>, Error> {
  569|     24|        layouter.assign_region(
  570|       |            || "NoteCommit MessagePiece g",
  571|       |            |mut region| {
  572|       |                self.q_notecommit_g.enable(&mut region, 0)?;
  573|       |
  574|       |                g.inner()
  575|       |                    .cell_value()
  576|       |                    .copy_advice(|| "g", &mut region, self.col_l, 0)?;
  577|       |                let g_0 = region.assign_advice(|| "g_0", self.col_m, 0, || *g_0.inner())?;
  578|       |
  579|       |                g_1.inner()
  580|       |                    .copy_advice(|| "g_1", &mut region, self.col_l, 1)?;
  581|       |                z1_g.copy_advice(|| "g_2 = z1_g", &mut region, self.col_m, 1)?;
  582|       |
  583|       |                Ok(g_0)
  584|       |            },
  585|       |        )
  586|     24|    }
