   88|      0|            "add and add_incomplete are used internally in mul_fixed."
   89|       |        );
   90|     12|        for advice in [config.window, config.u].iter() {
   91|     12|            assert_ne!(
   92|       |                *advice, config.add_config.x_qr,
   93|      0|                "Do not overlap with output columns of add."
   94|       |            );
   95|     12|            assert_ne!(
   96|       |                *advice, config.add_config.y_qr,
   97|      0|                "Do not overlap with output columns of add."
   98|       |            );
   99|       |        }
