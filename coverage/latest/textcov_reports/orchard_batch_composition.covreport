  470|  34.0k|                // enough input because `offset < fin_offset`.
  471|  34.0k|                block = &*(input.as_ptr().add(offset) as *const [u8; BLOCKBYTES]);
  472|  34.0k|                count_delta = BLOCKBYTES;
  473|  34.0k|                last_block = flag_word(false);
  474|  34.0k|                last_node = flag_word(false);
  475|  34.0k|            };
