  132|     24|    fn decompose(
  133|     24|        lookup_config: &LookupRangeCheckConfig<pallas::Base, 10>,
  134|     24|        chip: SinsemillaChip<OrchardHashDomains, OrchardCommitDomains, OrchardFixedBases>,
  135|     24|        layouter: &mut impl Layouter<pallas::Base>,
  136|     24|        g_d: &NonIdentityEccPoint,
  137|     24|        pk_d: &NonIdentityEccPoint,
  138|     24|    ) -> Result<
  139|     24|        (
  140|     24|            NoteCommitPiece,
  141|     24|            RangeConstrained<pallas::Base, AssignedCell<pallas::Base, pallas::Base>>,
  142|     24|            RangeConstrained<pallas::Base, Value<pallas::Base>>,
  143|     24|            RangeConstrained<pallas::Base, Value<pallas::Base>>,
  144|     24|            RangeConstrained<pallas::Base, AssignedCell<pallas::Base, pallas::Base>>,
  145|     24|        ),
  146|     24|        Error,
  147|     24|    > {
  148|     24|        let (gd_x, gd_y) = (g_d.x(), g_d.y());
  149|       |
  150|       |        // Constrain b_0 to be 4 bits
  151|     24|        let b_0 = RangeConstrained::witness_short(
  152|     24|            lookup_config,
  153|     24|            layouter.namespace(|| "b_0"),
  154|     24|            gd_x.value(),
  155|     24|            250..254,
  156|      0|        )?;
  157|       |
  158|       |        // b_1, b_2 will be boolean-constrained in the gate.
  159|     24|        let b_1 = RangeConstrained::bitrange_of(gd_x.value(), 254..255);
  160|     24|        let b_2 = RangeConstrained::bitrange_of(gd_y.value(), 0..1);
  161|       |
  162|       |        // Constrain b_3 to be 4 bits
  163|     24|        let b_3 = RangeConstrained::witness_short(
  164|     24|            lookup_config,
  165|     24|            layouter.namespace(|| "b_3"),
  166|     24|            pk_d.x().value(),
  167|     24|            0..4,
  168|      0|        )?;
  169|       |
  170|     24|        let b = MessagePiece::from_subpieces(
  171|     24|            chip,
  172|     24|            layouter.namespace(|| "b"),
  173|     24|            [b_0.value(), b_1, b_2, b_3.value()],
  174|      0|        )?;
  175|       |
  176|     24|        Ok((b, b_0, b_1, b_2, b_3))
  177|     24|    }
