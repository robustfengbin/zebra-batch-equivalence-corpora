 1200|      6|    pub fn create_gate<C: Into<Constraint<F>>, Iter: IntoIterator<Item = C>>(
 1201|      6|        &mut self,
 1202|      6|        name: &'static str,
 1203|      6|        constraints: impl FnOnce(&mut VirtualCells<'_, F>) -> Iter,
 1204|      6|    ) {
 1205|      6|        let mut cells = VirtualCells::new(self);
