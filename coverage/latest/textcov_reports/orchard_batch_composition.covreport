 1683|     24|                    b.clone(),
 1684|     24|                    c.clone(),
 1685|     24|                    d.clone(),
 1686|     24|                    e.clone(),
 1687|     24|                    f.clone(),
 1688|     24|                    g.clone(),
 1689|     24|                    h.clone(),
