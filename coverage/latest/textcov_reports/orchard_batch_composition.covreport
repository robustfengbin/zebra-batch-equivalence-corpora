  390|     12|            b: b.inner().cell_value(),
  391|     12|            c: c.inner().cell_value(),
  392|     12|            d: d.inner().cell_value(),
  393|     12|            ak,
  394|     12|            nk,
  395|     12|            b_0,
  396|     12|            b_1,
  397|     12|            b_2,
  398|     12|            d_0,
  399|     12|            d_1,
  400|     12|            z13_a,
  401|     12|            a_prime,
  402|     12|            z13_a_prime,
  403|     12|            z13_c,
  404|     12|            b2_c_prime,
  405|     12|            z14_b2_c_prime,
