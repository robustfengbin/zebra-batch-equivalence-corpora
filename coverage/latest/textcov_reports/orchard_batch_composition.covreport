  965|     12|    ) -> Self {
  966|     12|        let q_notecommit_value = meta.selector();
  967|       |
  968|     12|        meta.create_gate("NoteCommit input value", |meta| {
  969|       |            let q_notecommit_value = meta.query_selector(q_notecommit_value);
  970|       |
  971|       |            let value = meta.query_advice(col_l, Rotation::cur());
  972|       |            // d_2 has been constrained to 8 bits outside this gate.
  973|       |            let d_2 = meta.query_advice(col_m, Rotation::cur());
  974|       |            // z1_d has been constrained to 50 bits by the Sinsemilla hash.
  975|       |            let z1_d = meta.query_advice(col_r, Rotation::cur());
  976|       |            let d_3 = z1_d;
  977|       |            // `e_0` has been constrained to 6 bits outside this gate.
  978|       |            let e_0 = meta.query_advice(col_z, Rotation::cur());
  979|       |
  980|       |            // value = d_2 + (2^8)d_3 + (2^58)e_0
  981|       |            let value_check = d_2 + d_3 * two_pow_8 + e_0 * two_pow_58 - value;
  982|       |
  983|       |            Constraints::with_selector(q_notecommit_value, Some(("value_check", value_check)))
  984|       |        });
  985|       |
  986|     12|        Self {
  987|     12|            q_notecommit_value,
  988|     12|            col_l,
  989|     12|            col_m,
  990|     12|            col_r,
  991|     12|            col_z,
  992|     12|        }
  993|     12|    }
