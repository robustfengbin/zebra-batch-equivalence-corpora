  422|       |
  423|       |        // Constrain e_1 to be 4 bits.
  424|     24|        let e_1 = RangeConstrained::witness_short(
  425|     24|            lookup_config,
  426|     24|            layouter.namespace(|| "e_1"),
  427|     24|            rho.value(),
  428|     24|            0..4,
  429|      0|        )?;
  430|       |
  431|     24|        let e = MessagePiece::from_subpieces(
  432|     24|            chip,
  433|     24|            layouter.namespace(|| "e"),
  434|     24|            [e_0.value(), e_1.value()],
  435|      0|        )?;
  436|       |
  437|     24|        Ok((e, e_0, e_1))
  438|     24|    }
