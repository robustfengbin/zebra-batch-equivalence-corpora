  488|     36|    pub fn commit(
  489|     36|        &self,
  490|     36|        mut layouter: impl Layouter<C::Base>,
  491|     36|        message: Message<C, SinsemillaChip, K, MAX_WORDS>,
  492|     36|        r: ecc::ScalarFixed<C, EccChip>,
  493|     36|    ) -> Result<
  494|     36|        (
  495|     36|            ecc::Point<C, EccChip>,
  496|     36|            Vec<SinsemillaChip::RunningSum>,
  497|     36|        ),
  498|     36|        Error,
  499|     36|    > {
  500|     36|        assert_eq!(self.M.sinsemilla_chip, message.chip);
  501|     36|        let (blind, _) = self.R.mul(layouter.namespace(|| "[r] R"), r)?;
  502|     36|        let (p, zs) = self.M.hash_to_point(layouter.namespace(|| "M"), message)?;
  503|     36|        let commitment = p.add(layouter.namespace(|| "M + [r] R"), &blind)?;
