  109|  26.4k|pub fn map_to_curve_simple_swu<F: PrimeField, C: CurveExt<Base = F>, I: CurveExt<Base = F>>(
  110|  26.4k|    u: &F,
  111|  26.4k|    theta: F,
  112|  26.4k|    z: F,
  113|  26.4k|) -> I {
  114|       |    // 1. tv1 = inv0(Z^2 * u^4 + Z * u^2)
  115|       |    // 2. x1 = (-B / A) * (1 + tv1)
  116|       |    // 3. If tv1 == 0, set x1 = B / (Z * A)
  117|       |    // 4. gx1 = x1^3 + A * x1 + B
  118|       |    //
  119|       |    // We use the "Avoiding inversions" optimization in [WB2019, section 4.2]
  120|       |    // (not to be confused with section 4.3):
  121|       |    //
  122|       |    //   here       [WB2019]
  123|       |    //   -------    ---------------------------------
  124|       |    //   Z          ξ
  125|       |    //   u          t
  126|       |    //   Z * u^2    ξ * t^2 (called u, confusingly)
  127|       |    //   x1         X_0(t)
  128|       |    //   x2         X_1(t)
  129|       |    //   gx1        g(X_0(t))
  130|       |    //   gx2        g(X_1(t))
  131|       |    //
  132|       |    // Using the "here" names:
  133|       |    //    x1 = num_x1/div      = [B*(Z^2 * u^4 + Z * u^2 + 1)] / [-A*(Z^2 * u^4 + Z * u^2]
  134|       |    //   gx1 = num_gx1/div_gx1 = [num_x1^3 + A * num_x1 * div^2 + B * div^3] / div^3
  135|       |
  136|  26.4k|    let a = I::a();
  137|  26.4k|    let b = I::b();
  138|  26.4k|    let z_u2 = z * u.square();
  139|  26.4k|    let ta = z_u2.square() + z_u2;
  140|  26.4k|    let num_x1 = b * (ta + F::ONE);
  141|  26.4k|    let div = a * F::conditional_select(&-ta, &z, ta.is_zero());
  142|  26.4k|    let num2_x1 = num_x1.square();
  143|  26.4k|    let div2 = div.square();
  144|  26.4k|    let div3 = div2 * div;
  145|  26.4k|    let num_gx1 = (num2_x1 + a * div2) * num_x1 + b * div3;
  146|       |
  147|       |    // 5. x2 = Z * u^2 * x1
  148|  26.4k|    let num_x2 = z_u2 * num_x1; // same div
  149|       |
  150|       |    // 6. gx2 = x2^3 + A * x2 + B  [optimized out; see below]
  151|       |    // 7. If is_square(gx1), set x = x1 and y = sqrt(gx1)
  152|       |    // 8. Else set x = x2 and y = sqrt(gx2)
  153|  26.4k|    let (gx1_square, y1) = F::sqrt_ratio(&num_gx1, &div3);
