  132|      6|        meta.create_gate("LSB check", |meta| {
  133|      6|            let q_mul_lsb = meta.query_selector(self.q_mul_lsb);
  134|       |
  135|      6|            let z_1 = meta.query_advice(self.complete_config.z_complete, Rotation::cur());
  136|      6|            let z_0 = meta.query_advice(self.complete_config.z_complete, Rotation::next());
  137|      6|            let x_p = meta.query_advice(self.add_config.x_p, Rotation::cur());
  138|      6|            let y_p = meta.query_advice(self.add_config.y_p, Rotation::cur());
  139|      6|            let base_x = meta.query_advice(self.add_config.x_p, Rotation::next());
  140|      6|            let base_y = meta.query_advice(self.add_config.y_p, Rotation::next());
  141|       |
  142|       |            //    z_0 = 2 * z_1 + k_0
  143|       |            // => k_0 = z_0 - 2 * z_1
  144|      6|            let lsb = z_0 - z_1 * pallas::Base::from(2);
  145|       |
  146|      6|            let bool_check = bool_check(lsb.clone());
  147|       |
  148|       |            // `lsb` = 0 => (x_p, y_p) = (x, -y)
  149|       |            // `lsb` = 1 => (x_p, y_p) = (0,0)
  150|      6|            let lsb_x = ternary(lsb.clone(), x_p.clone(), x_p - base_x);
  151|      6|            let lsb_y = ternary(lsb, y_p.clone(), y_p + base_y);
  152|       |
  153|      6|            Constraints::with_selector(
  154|      6|                q_mul_lsb,
  155|      6|                [
  156|      6|                    ("bool_check", bool_check),
  157|      6|                    ("lsb_x", lsb_x),
  158|      6|                    ("lsb_y", lsb_y),
  159|      6|                ],
  160|       |            )
  161|      6|        });
