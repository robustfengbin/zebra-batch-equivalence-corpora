_RNvMs5_NtCskIihoeCgx9B_7orchard7circuitNtB5_8Instance17to_halo2_instance:
 1255|  26.0k|    fn to_halo2_instance(&self) -> [[vesta::Scalar; 10]; 1] {
 1256|  26.0k|        let mut instance = [vesta::Scalar::zero(); 10];
 1257|       |
 1258|  26.0k|        instance[ANCHOR] = self.anchor.inner();
 1259|  26.0k|        instance[CV_NET_X] = self.cv_net.x();
 1260|  26.0k|        instance[CV_NET_Y] = self.cv_net.y();
 1261|  26.0k|        instance[NF_OLD] = self.nf_old.inner();
 1262|       |
 1263|  26.0k|        let rk = pallas::Point::from_bytes(&self.rk.clone().into())
 1264|  26.0k|            .expect("the cached byte encoding of a VerificationKey<_> is canonical")
 1265|  26.0k|            .to_affine()
 1266|  26.0k|            .coordinates()
 1267|  26.0k|            .expect("rk is non-identity by construction");
 1268|       |
 1269|  26.0k|        instance[RK_X] = *rk.x();
 1270|  26.0k|        instance[RK_Y] = *rk.y();
 1271|  26.0k|        instance[CMX] = self.cmx.inner();
 1272|  26.0k|        instance[ENABLE_SPEND] = vesta::Scalar::from(u64::from(self.enable_spend));
 1273|  26.0k|        instance[ENABLE_OUTPUT] = vesta::Scalar::from(u64::from(self.enable_output));
 1274|       |        // Instance columns are zero-padded over the evaluation domain, so for statements
 1275|       |        // where this flag is false, this encoding is commitment-identical to the historical
 1276|       |        // nine-row encoding. Pre-NU 6.3 circuits leave this row unconstrained, which is why
 1277|       |        // restricted statements must never reach those keys (see `Proof::create` and
 1278|       |        // `Proof::verify`).
 1279|  26.0k|        instance[DISABLE_CROSS_ADDRESS] =
 1280|  26.0k|            vesta::Scalar::from(u64::from(self.cross_address_disabled));
 1281|       |
 1282|  26.0k|        [instance]
 1283|  26.0k|    }
