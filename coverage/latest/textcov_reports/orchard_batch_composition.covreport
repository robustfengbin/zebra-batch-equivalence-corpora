  375|     12|        let (a_prime, z13_a_prime) = ak_canonicity(
  376|     12|            &lookup_config,
  377|     12|            layouter.namespace(|| "ak canonicity"),
  378|     12|            a.inner().cell_value(),
  379|      0|        )?;
  380|       |
  381|     12|        let (b2_c_prime, z14_b2_c_prime) = nk_canonicity(
