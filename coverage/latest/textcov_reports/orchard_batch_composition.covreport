  324|  2.34G|        let r3 = (r3 << 1) | (r2 >> 63);
  325|  2.34G|        let r2 = (r2 << 1) | (r1 >> 63);
  326|  2.34G|        let r1 = r1 << 1;
  327|       |
  328|  2.34G|        let (r0, carry) = mac(0, self.0[0], self.0[0], 0);
  329|  2.34G|        let (r1, carry) = adc(0, r1, carry);
  330|  2.34G|        let (r2, carry) = mac(r2, self.0[1], self.0[1], carry);
  331|  2.34G|        let (r3, carry) = adc(0, r3, carry);
  332|  2.34G|        let (r4, carry) = mac(r4, self.0[2], self.0[2], carry);
  333|  2.34G|        let (r5, carry) = adc(0, r5, carry);
  334|  2.34G|        let (r6, carry) = mac(r6, self.0[3], self.0[3], carry);
  335|  2.34G|        let (r7, _) = adc(0, r7, carry);
