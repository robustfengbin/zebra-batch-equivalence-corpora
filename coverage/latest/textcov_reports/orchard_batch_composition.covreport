  294|  52.0k|                let z = other.z.square();
  295|  52.0k|                let x1 = self.x * z;
  296|  52.0k|                let z = z * other.z;
  297|  52.0k|                let y1 = self.y * z;
  298|  52.0k|                let z = self.z.square();
  299|  52.0k|                let x2 = other.x * z;
  300|  52.0k|                let z = z * self.z;
  301|  52.0k|                let y2 = other.y * z;
  302|       |
  303|  52.0k|                let self_is_zero = self.is_identity();
  304|  52.0k|                let other_is_zero = other.is_identity();
  305|       |
  306|  52.0k|                (self_is_zero & other_is_zero) // Both point at infinity
  307|  52.0k|                            | ((!self_is_zero) & (!other_is_zero) & x1.ct_eq(&x2) & y1.ct_eq(&y2))
  308|       |                // Neither point at infinity, coordinates are the same
  309|  52.0k|            }
