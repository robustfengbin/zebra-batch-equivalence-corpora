  408|    870|    pub fn invert(&self) -> CtOption<Self> {
  409|       |        #[inline(always)]
  410|       |        fn square_assign_multi(n: &mut Scalar, num_times: usize) {
  411|       |            for _ in 0..num_times {
  412|       |                *n = n.square();
  413|       |            }
  414|       |        }
  415|       |        // found using https://github.com/kwantam/addchain
  416|    870|        let mut t0 = self.square();
  417|    870|        let mut t1 = t0 * self;
  418|    870|        let mut t16 = t0.square();
  419|    870|        let mut t6 = t16.square();
  420|    870|        let mut t5 = t6 * t0;
  421|    870|        t0 = t6 * t16;
  422|    870|        let mut t12 = t5 * t16;
  423|    870|        let mut t2 = t6.square();
  424|    870|        let mut t7 = t5 * t6;
  425|    870|        let mut t15 = t0 * t5;
  426|    870|        let mut t17 = t12.square();
