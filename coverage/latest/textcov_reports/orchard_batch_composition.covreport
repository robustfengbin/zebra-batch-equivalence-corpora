  420|     12|    fn ak_canonicity(
  421|     12|        lookup_config: &LookupRangeCheckConfig<pallas::Base, 10>,
  422|     12|        mut layouter: impl Layouter<pallas::Base>,
  423|     12|        a: AssignedCell<pallas::Base, pallas::Base>,
  424|     12|    ) -> Result<
  425|     12|        (
  426|     12|            AssignedCell<pallas::Base, pallas::Base>,
  427|     12|            AssignedCell<pallas::Base, pallas::Base>,
  428|     12|        ),
  429|     12|        Error,
  430|     12|    > {
  431|       |        // `ak` = `a (250 bits) || b_0 (4 bits) || b_1 (1 bit)`
  432|       |        // - b_1 = 1 => b_0 = 0
  433|       |        // - b_1 = 1 => a < t_P
  434|       |        //     - (0 ≤ a < 2^130) => z13_a of SinsemillaHash(a) == 0
  435|       |        //     - 0 ≤ a + 2^130 - t_P < 2^130 (thirteen 10-bit lookups)
  436|       |
  437|       |        // Decompose the low 130 bits of a_prime = a + 2^130 - t_P, and output
  438|       |        // the running sum at the end of it. If a_prime < 2^130, the running sum
  439|       |        // will be 0.
  440|     12|        let a_prime = {
  441|     12|            let two_pow_130 = Value::known(pallas::Base::from_u128(1u128 << 65).square());
  442|     12|            let t_p = Value::known(pallas::Base::from_u128(T_P));
  443|     12|            a.value() + two_pow_130 - t_p
  444|       |        };
  445|     12|        let zs = lookup_config.witness_check(
  446|     12|            layouter.namespace(|| "Decompose low 130 bits of (a + 2^130 - t_P)"),
  447|     12|            a_prime,
  448|       |            13,
  449|       |            false,
  450|      0|        )?;
  451|     12|        let a_prime = zs[0].clone();
  452|     12|        assert_eq!(zs.len(), 14); // [z_0, z_1, ..., z13]
  453|       |
  454|     12|        Ok((a_prime, zs[13].clone()))
  455|     12|    }
_RINvNtNtNtCskIihoeCgx9B_7orchard7circuit10commit_ivk7gadgets13nk_canonicityINtNtCs6mFdeH4K0qJ_12halo2_proofs7circuit18NamespacedLayouterNtNtNtCs5ei4Ir5UmKx_12pasta_curves6fields2fp2FpINtNtNtB1e_13floor_planner2v16V1PassB2a_INtNtNtB1g_5plonk6keygen8AssemblyB2a_EEEEB8_:
  461|     12|    fn nk_canonicity(
  462|     12|        lookup_config: &LookupRangeCheckConfig<pallas::Base, 10>,
  463|     12|        mut layouter: impl Layouter<pallas::Base>,
  464|     12|        b_2: &RangeConstrained<pallas::Base, AssignedCell<pallas::Base, pallas::Base>>,
  465|     12|        c: AssignedCell<pallas::Base, pallas::Base>,
  466|     12|    ) -> Result<
  467|     12|        (
  468|     12|            AssignedCell<pallas::Base, pallas::Base>,
  469|     12|            AssignedCell<pallas::Base, pallas::Base>,
  470|     12|        ),
  471|     12|        Error,
  472|     12|    > {
  473|       |        // `nk` = `b_2 (5 bits) || c (240 bits) || d_0 (9 bits) || d_1 (1 bit)
  474|       |        // - d_1 = 1 => d_0 = 0
  475|       |        // - d_1 = 1 => b_2 + c * 2^5 < t_P
  476|       |        //      - 0 ≤ b_2 + c * 2^5 < 2^140
  477|       |        //          - b_2 was constrained to be 5 bits.
  478|       |        //          - z_13 of SinsemillaHash(c) constrains bits 5..=134 to 130 bits
  479|       |        //          - so b_2 + c * 2^5 is constrained to be 135 bits < 2^140.
  480|       |        //      - 0 ≤ b_2 + c * 2^5 + 2^140 - t_P < 2^140 (14 ten-bit lookups)
  481|       |
  482|       |        // Decompose the low 140 bits of b2_c_prime = b_2 + c * 2^5 + 2^140 - t_P, and output
  483|       |        // the running sum at the end of it. If b2_c_prime < 2^140, the running sum will be 0.
  484|     12|        let b2_c_prime = {
  485|     12|            let two_pow_5 = Value::known(pallas::Base::from(1 << 5));
  486|     12|            let two_pow_140 = Value::known(pallas::Base::from_u128(1u128 << 70).square());
  487|     12|            let t_p = Value::known(pallas::Base::from_u128(T_P));
  488|     12|            b_2.inner().value() + c.value() * two_pow_5 + two_pow_140 - t_p
  489|       |        };
  490|     12|        let zs = lookup_config.witness_check(
  491|     12|            layouter.namespace(|| "Decompose low 140 bits of (b_2 + c * 2^5 + 2^140 - t_P)"),
  492|     12|            b2_c_prime,
  493|       |            14,
  494|       |            false,
  495|      0|        )?;
  496|     12|        let b2_c_prime = zs[0].clone();
  497|     12|        assert_eq!(zs.len(), 15); // [z_0, z_1, ..., z14]
  498|       |
  499|     12|        Ok((b2_c_prime, zs[14].clone()))
  500|     12|    }

