 1618|     24|            DecomposeB::decompose(&lookup_config, chip.clone(), &mut layouter, g_d, pk_d)?;
 1619|       |
 1620|       |        // c = bits 4..=253 of pk★_d
 1621|     24|        let c = MessagePiece::from_subpieces(
 1622|     24|            chip.clone(),
 1623|     24|            layouter.namespace(|| "c"),
 1624|     24|            [RangeConstrained::bitrange_of(pk_d.x().value(), 4..254)],
 1625|      0|        )?;
 1626|       |
 1627|       |        // d = d_0 || d_1 || d_2 || d_3
 1628|       |        //   = (bit 254 of x(pk_d)) || (ỹ bit of pk_d) || (bits 0..=7 of v) || (bits 8..=57 of v)
 1629|     24|        let (d, d_0, d_1, d_2) =
 1630|     24|            DecomposeD::decompose(&lookup_config, chip.clone(), &mut layouter, pk_d, &value)?;
 1631|       |
 1632|       |        // e = e_0 || e_1 = (bits 58..=63 of v) || (bits 0..=3 of rho)
 1633|     24|        let (e, e_0, e_1) =
 1634|     24|            DecomposeE::decompose(&lookup_config, chip.clone(), &mut layouter, &value, &rho)?;
 1635|       |
 1636|       |        // f = bits 4..=253 inclusive of rho
