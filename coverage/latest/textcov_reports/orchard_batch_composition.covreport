   71|       |
   72|  26.4k|    for (big, buf) in [b_1, b_2].iter().zip(buf.iter_mut()) {
   73|  26.4k|        let mut little = [0u8; CHUNKLEN];
   74|  26.4k|        little.copy_from_slice(big.as_array());
