   72|       |
   73|       |            // q = 2^254 + t_q is the Pallas scalar field modulus.
   74|       |            // We cast t_q into the base field to check alpha + t_q (mod p).
   75|       |            let t_q = Expression::Constant(pallas::Base::from_u128(T_Q));
   76|       |
