  173|     48|            fn batch_normalize(p: &[Self], q: &mut [Self::AffineRepr]) {
  174|     48|                assert_eq!(p.len(), q.len());
  175|       |
  176|     48|                let mut acc = $base::one();
  177|  24.5k|                for (p, q) in p.iter().zip(q.iter_mut()) {
  178|  24.5k|                    // We use the `x` field of $name_affine to store the product
  179|  24.5k|                    // of previous z-coordinates seen.
  180|  24.5k|                    q.x = acc;
  181|  24.5k|
  182|  24.5k|                    // We will end up skipping all identities in p
  183|  24.5k|                    acc = $base::conditional_select(&(acc * p.z), &acc, p.is_identity());
  184|  24.5k|                }
  185|       |
  186|       |                // This is the inverse, as all z-coordinates are nonzero and the ones
  187|       |                // that are not are skipped.
  188|     48|                acc = acc.invert().unwrap();
  189|       |
  190|  24.5k|                for (p, q) in p.iter().rev().zip(q.iter_mut().rev()) {
  191|  24.5k|                    let skip = p.is_identity();
  192|  24.5k|
  193|  24.5k|                    // Compute tmp = 1/z
  194|  24.5k|                    let tmp = q.x * acc;
  195|  24.5k|
  196|  24.5k|                    // Cancel out z-coordinate in denominator of `acc`
  197|  24.5k|                    acc = $base::conditional_select(&(acc * p.z), &acc, skip);
  198|  24.5k|
  199|  24.5k|                    // Set the coordinates to the correct value
  200|  24.5k|                    let tmp2 = tmp.square();
  201|  24.5k|                    let tmp3 = tmp2 * tmp;
  202|  24.5k|
  203|  24.5k|                    q.x = p.x * tmp2;
  204|  24.5k|                    q.y = p.y * tmp3;
  205|  24.5k|
  206|  24.5k|                    *q = $name_affine::conditional_select(&q, &$name_affine::identity(), skip);
  207|  24.5k|                }
  208|     48|            }
