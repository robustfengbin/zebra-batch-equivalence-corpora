 1615|       |        // b = b_0 || b_1 || b_2 || b_3
 1616|       |        //   = (bits 250..=253 of x(g_d)) || (bit 254 of x(g_d)) || (ỹ bit of g_d) || (bits 0..=3 of pk★_d)
