 1335|     12|                    .chain(Some(("k_3 = 1 => z13_j = 0", z13_j)))
 1336|     12|                    .chain(Some(("k_3 = 1 => z13_j_prime = 0", z13_j_prime)))
 1337|     12|                    .map(move |(name, poly)| (name, k_3.clone() * poly))
 1338|       |            };
