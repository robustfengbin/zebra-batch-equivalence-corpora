  132|       |
  133|       |            // | x_p | y_p | x_qr  | y_qr  | z_complete |
  134|       |            // ------------------------------------------
  135|       |            // | U_x | U_y | acc_x | acc_y | z_{i + 1}  | row + offset
  136|       |            // |acc_x|acc_y|acc+U_x|acc+U_y| base_y     |
  137|       |            // |     |     | res_x | res_y | z_i        |
  138|       |
  139|       |            // Update `z`.
  140|       |            z = {
  141|       |                // z_next = z_cur * 2 + k_next
  142|     36|                let z_val = z.value() * Value::known(pallas::Base::from(2))
  143|     36|                    + k.map(|k| pallas::Base::from(k as u64));
  144|     36|                let z_cell =
  145|     36|                    region.assign_advice(|| "z", self.z_complete, row + offset + 2, || z_val)?;
  146|     36|                Z(z_cell)
