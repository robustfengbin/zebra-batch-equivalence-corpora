  139|     24|    fn decompose(
  140|     24|        &self,
  141|     24|        region: &mut Region<'_, F>,
  142|     24|        offset: usize,
  143|     24|        z_0: AssignedCell<F, F>,
  144|     24|        strict: bool,
  145|     24|        word_num_bits: usize,
  146|     24|        num_windows: usize,
  147|     24|    ) -> Result<RunningSum<F>, Error> {
  148|       |        // Make sure that we do not have more windows than required for the number
  149|       |        // of bits in the word. In other words, every window must contain at least
  150|       |        // one bit of the word (no empty windows).
  151|       |        //
  152|       |        // For example, let:
  153|       |        //      - word_num_bits = 64
  154|       |        //      - WINDOW_NUM_BITS = 3
  155|       |        // In this case, the maximum allowed num_windows is 22:
  156|       |        //                    3 * 22 < 64 + 3
  157|       |        //
  158|     24|        assert!(WINDOW_NUM_BITS * num_windows < word_num_bits + WINDOW_NUM_BITS);
  159|       |
  160|       |        // Enable selectors
  161|  1.28k|        for idx in 0..num_windows {
  162|  1.28k|            self.q_range_check.enable(region, offset + idx)?;
  163|       |        }
  164|       |
  165|       |        // Decompose base field element into K-bit words.
  166|     24|        let words = z_0
  167|     24|            .value()
  168|     24|            .map(|word| super::decompose_word::<F>(word, word_num_bits, WINDOW_NUM_BITS))
  169|     24|            .transpose_vec(num_windows);
  170|       |
  171|       |        // Initialize empty vector to store running sum values [z_0, ..., z_W].
  172|     24|        let mut zs: Vec<AssignedCell<F, F>> = vec![z_0.clone()];
  173|     24|        let mut z = z_0;
  174|       |
  175|       |        // Assign running sum `z_{i+1}` = (z_i - k_i) / (2^K) for i = 0..=n-1.
  176|       |        // Outside of this helper, z_0 = alpha must have already been loaded into the
  177|       |        // `z` column at `offset`.
  178|     24|        let two_pow_k_inv = Value::known(F::from(1 << WINDOW_NUM_BITS as u64).invert().unwrap());
  179|  1.28k|        for (i, word) in words.iter().enumerate() {
  180|       |            // z_next = (z_cur - word) / (2^K)
  181|  1.28k|            let z_next = {
  182|  1.28k|                let z_cur_val = z.value().copied();
  183|  1.28k|                let word = word.map(|word| F::from(word as u64));
  184|  1.28k|                let z_next_val = (z_cur_val - word) * two_pow_k_inv;
  185|  1.28k|                region.assign_advice(
  186|       |                    || format!("z_{:?}", i + 1),
  187|  1.28k|                    self.z,
  188|  1.28k|                    offset + i + 1,
  189|       |                    || z_next_val,
  190|      0|                )?
  191|       |            };
  192|       |
  193|       |            // Update `z`.
  194|  1.28k|            z = z_next;
  195|  1.28k|            zs.push(z.clone());
  196|       |        }
  197|     24|        assert_eq!(zs.len(), num_windows + 1);
  198|       |
  199|     24|        if strict {
  200|       |            // Constrain the final running sum output to be zero.
  201|     24|            region.constrain_constant(zs.last().unwrap().cell(), F::ZERO)?;
  202|      0|        }
  203|       |
  204|     24|        Ok(RunningSum(zs))
  205|     24|    }
