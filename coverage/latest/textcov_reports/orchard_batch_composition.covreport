   57|  13.2k|    let b_2 = {
   58|  13.2k|        let mut empty_hasher = empty_hasher;
   59|   847k|        for (l, r) in b_0.as_array().iter().zip(b_1.as_array().iter()) {
   60|   847k|            empty_hasher.update(&[*l ^ *r]);
   61|   847k|        }
   62|  13.2k|        empty_hasher
   63|  13.2k|            .update(&[2])
   64|  13.2k|            .update(domain_prefix.as_bytes())
   65|  13.2k|            .update(b"-")
   66|  13.2k|            .update(curve_id.as_bytes())
   67|  13.2k|            .update(b"_XMD:BLAKE2b_SSWU_RO_")
   68|  13.2k|            .update(&[(22 + curve_id.len() + domain_prefix.len()) as u8])
   69|  13.2k|            .finalize()
