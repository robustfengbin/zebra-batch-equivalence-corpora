   78|      6|        meta.create_gate("CommitIvk canonicity check", |meta| {
   79|      6|            let q_commit_ivk = meta.query_selector(config.q_commit_ivk);
   80|       |
   81|       |            // Useful constants
   82|      6|            let two_pow_4 = pallas::Base::from(1 << 4);
   83|      6|            let two_pow_5 = pallas::Base::from(1 << 5);
   84|      6|            let two_pow_9 = two_pow_4 * two_pow_5;
   85|      6|            let two_pow_250 = pallas::Base::from_u128(1 << 125).square();
   86|      6|            let two_pow_254 = two_pow_250 * two_pow_4;
   87|       |
   88|      6|            let ak = meta.query_advice(config.advices[0], Rotation::cur());
   89|      6|            let nk = meta.query_advice(config.advices[0], Rotation::next());
   90|       |
   91|       |            // `a` is constrained by the Sinsemilla hash to be 250 bits.
   92|      6|            let a = meta.query_advice(config.advices[1], Rotation::cur());
   93|       |            // `b` is constrained by the Sinsemilla hash to be 10 bits.
   94|      6|            let b_whole = meta.query_advice(config.advices[2], Rotation::cur());
   95|       |            // `c` is constrained by the Sinsemilla hash to be 240 bits.
   96|      6|            let c = meta.query_advice(config.advices[1], Rotation::next());
   97|       |            // `d` is constrained by the Sinsemilla hash to be 10 bits.
   98|      6|            let d_whole = meta.query_advice(config.advices[2], Rotation::next());
   99|       |
  100|       |            // b = b_0||b_1||b_2`
  101|       |            //   = (bits 250..=253 of `ak`) || (bit 254 of  `ak`) || (bits 0..=4 of  `nk`)
