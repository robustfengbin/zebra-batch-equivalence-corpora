   70|      6|    pub fn configure(
   71|      6|        meta: &mut ConstraintSystem<F>,
   72|      6|        q_range_check: Selector,
   73|      6|        z: Column<Advice>,
   74|      6|    ) -> Self {
   75|      6|        assert!(WINDOW_NUM_BITS <= 3);
   76|       |
   77|      6|        meta.enable_equality(z);
   78|       |
   79|      6|        let config = Self {
   80|      6|            q_range_check,
   81|      6|            z,
   82|      6|            _marker: PhantomData,
   83|      6|        };
   84|       |
   85|       |        // https://p.z.cash/halo2-0.1:decompose-short-range
   86|      6|        meta.create_gate("range check", |meta| {
   87|       |            let q_range_check = meta.query_selector(config.q_range_check);
   88|       |            let z_cur = meta.query_advice(config.z, Rotation::cur());
   89|       |            let z_next = meta.query_advice(config.z, Rotation::next());
   90|       |            //    z_i = 2^{K}⋅z_{i + 1} + k_i
   91|       |            // => k_i = z_i - 2^{K}⋅z_{i + 1}
   92|       |            let word = z_cur - z_next * F::from(1 << WINDOW_NUM_BITS);
   93|       |
   94|       |            Constraints::with_selector(q_range_check, Some(range_check(word, 1 << WINDOW_NUM_BITS)))
   95|       |        });
   96|       |
   97|      6|        config
   98|      6|    }
