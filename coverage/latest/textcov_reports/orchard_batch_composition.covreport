  180|       |        // Assign fixed columns for given fixed base
  181|     12|        self.assign_fixed_constants::<F, NUM_WINDOWS>(region, offset, base, coords_check_toggle)?;
  182|       |
  183|       |        // Initialize accumulator
  184|     12|        let acc = self.initialize_accumulator::<F, NUM_WINDOWS>(region, offset, base, scalar)?;
