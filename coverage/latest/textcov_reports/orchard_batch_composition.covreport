   85|    384|    fn swap(
   86|    384|        &self,
   87|    384|        mut layouter: impl Layouter<F>,
   88|    384|        pair: (Self::Var, Value<F>),
   89|    384|        swap: Value<bool>,
   90|    384|    ) -> Result<(Self::Var, Self::Var), Error> {
   91|    384|        let config = self.config();
   92|       |
   93|    384|        layouter.assign_region(
   94|       |            || "swap",
   95|       |            |mut region| {
   96|       |                // Enable `q_swap` selector
   97|       |                config.q_swap.enable(&mut region, 0)?;
   98|       |
   99|       |                // Copy in `a` value
  100|       |                let a = pair.0.copy_advice(|| "copy a", &mut region, config.a, 0)?;
  101|       |
  102|       |                // Witness `b` value
  103|       |                let b = region.assign_advice(|| "witness b", config.b, 0, || pair.1)?;
  104|       |
  105|       |                // Witness `swap` value
  106|       |                let swap_val = swap.map(|swap| F::from(swap as u64));
  107|       |                region.assign_advice(|| "swap", config.swap, 0, || swap_val)?;
  108|       |
  109|       |                // Conditionally swap a
  110|       |                let a_swapped = {
  111|       |                    let a_swapped = a
  112|       |                        .value()
  113|       |                        .zip(b.value())
  114|       |                        .zip(swap)
  115|       |                        .map(|((a, b), swap)| if swap { b } else { a })
  116|       |                        .cloned();
  117|       |                    region.assign_advice(|| "a_swapped", config.a_swapped, 0, || a_swapped)?
  118|       |                };
  119|       |
  120|       |                // Conditionally swap b
  121|       |                let b_swapped = {
  122|       |                    let b_swapped = a
  123|       |                        .value()
  124|       |                        .zip(b.value())
  125|       |                        .zip(swap)
  126|       |                        .map(|((a, b), swap)| if swap { a } else { b })
  127|       |                        .cloned();
  128|       |                    region.assign_advice(|| "b_swapped", config.b_swapped, 0, || b_swapped)?
  129|       |                };
  130|       |
  131|       |                // Return swapped pair
  132|       |                Ok((a_swapped, b_swapped))
  133|       |            },
  134|       |        )
  135|    384|    }
