 1763|     24|            b_3,
 1764|     24|            c,
 1765|     24|            d_0,
 1766|     24|            b3_c_prime,
 1767|     24|            z13_c,
 1768|     24|            z14_b3_c_prime,
 1769|      0|        )?;
