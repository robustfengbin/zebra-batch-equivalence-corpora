  147|    408|pub fn bitrange_subset<F: PrimeFieldBits>(field_elem: &F, bitrange: Range<usize>) -> F {
  148|       |    // We can allow a subsequence of length NUM_BITS, because
  149|       |    // field_elem.to_le_bits() returns canonical bitstrings.
  150|    408|    assert!(bitrange.end <= F::NUM_BITS as usize);
  151|       |
  152|    408|    field_elem
  153|    408|        .to_le_bits()
  154|    408|        .iter()
  155|    408|        .by_vals()
  156|    408|        .skip(bitrange.start)
  157|    408|        .take(bitrange.end - bitrange.start)
  158|    408|        .rev()
  159|    408|        .fold(F::ZERO, |acc, bit| {
  160|       |            if bit {
  161|       |                acc.double() + F::ONE
  162|       |            } else {
  163|       |                acc.double()
  164|       |            }
  165|       |        })
  166|    408|}
