 1594|     24|    pub(in crate::circuit) fn note_commit(
 1595|     24|        mut layouter: impl Layouter<pallas::Base>,
 1596|     24|        chip: SinsemillaChip<OrchardHashDomains, OrchardCommitDomains, OrchardFixedBases>,
 1597|     24|        ecc_chip: EccChip<OrchardFixedBases>,
 1598|     24|        note_commit_chip: NoteCommitChip,
 1599|     24|        g_d: &NonIdentityEccPoint,
 1600|     24|        pk_d: &NonIdentityEccPoint,
 1601|     24|        value: AssignedCell<NoteValue, pallas::Base>,
