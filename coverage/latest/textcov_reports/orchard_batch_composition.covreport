  341|       |                z_1 * pallas::Base::from(2) + lsb
  342|       |            });
  343|     12|            let z_0_cell = region.assign_advice(
  344|       |                || "z_0",
  345|     12|                self.complete_config.z_complete,
  346|     12|                offset + 1,
  347|       |                || z_0_val,
  348|      0|            )?;
