  454|   630k|        let (d1, borrow) = sbb(MODULUS.0[1], self.0[1], borrow);
  455|   630k|        let (d2, borrow) = sbb(MODULUS.0[2], self.0[2], borrow);
  456|   630k|        let (d3, _) = sbb(MODULUS.0[3], self.0[3], borrow);
  457|       |
