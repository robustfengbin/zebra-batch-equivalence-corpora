  306|      6|    pub fn configure(
  307|      6|        meta: &mut ConstraintSystem<pallas::Base>,
  308|      6|        advices: [Column<Advice>; 10],
  309|      6|        lagrange_coeffs: [Column<Fixed>; 8],
  310|      6|        range_check: Lookup,
  311|      6|    ) -> <Self as Chip<pallas::Base>>::Config {
  312|       |        // Create witness point gate
  313|      6|        let witness_point = witness_point::Config::configure(meta, advices[0], advices[1]);
  314|       |        // Create incomplete point addition gate
  315|      6|        let add_incomplete =
  316|      6|            add_incomplete::Config::configure(meta, advices[0], advices[1], advices[2], advices[3]);
  317|       |
  318|       |        // Create complete point addition gate
  319|      6|        let add = add::Config::configure(
  320|      6|            meta, advices[0], advices[1], advices[2], advices[3], advices[4], advices[5],
  321|      6|            advices[6], advices[7], advices[8],
  322|       |        );
  323|       |
  324|       |        // Create variable-base scalar mul gates
  325|      6|        let mul = mul::Config::configure(meta, add, range_check, advices);
  326|       |
  327|       |        // Create config that is shared across short, base-field, and full-width
  328|       |        // fixed-base scalar mul.
  329|      6|        let mul_fixed = mul_fixed::Config::<FixedPoints>::configure(
  330|      6|            meta,
  331|      6|            lagrange_coeffs,
  332|      6|            advices[4],
  333|      6|            advices[5],
  334|      6|            add,
  335|      6|            add_incomplete,
  336|       |        );
  337|       |
  338|       |        // Create gate that is only used in full-width fixed-base scalar mul.
  339|      6|        let mul_fixed_full =
  340|      6|            mul_fixed::full_width::Config::<FixedPoints>::configure(meta, mul_fixed.clone());
  341|       |
  342|       |        // Create gate that is only used in short fixed-base scalar mul.
  343|      6|        let mul_fixed_short =
  344|      6|            mul_fixed::short::Config::<FixedPoints>::configure(meta, mul_fixed.clone());
  345|       |
  346|       |        // Create gate that is only used in fixed-base mul using a base field element.
  347|      6|        let mul_fixed_base_field =
  348|      6|            mul_fixed::base_field_elem::Config::<FixedPoints, Lookup>::configure(
  349|      6|                meta,
  350|      6|                advices[6..9].try_into().unwrap(),
  351|      6|                range_check,
  352|      6|                mul_fixed,
  353|       |            );
  354|       |
  355|      6|        EccConfig {
  356|      6|            advices,
  357|      6|            add_incomplete,
  358|      6|            add,
  359|      6|            mul,
  360|      6|            mul_fixed_full,
  361|      6|            mul_fixed_short,
  362|      6|            mul_fixed_base_field,
  363|      6|            witness_point,
  364|      6|            lookup_config: range_check,
  365|      6|        }
  366|      6|    }
