   39|  13.2k|        .update(domain_prefix.as_bytes())
   40|  13.2k|        .update(b"-")
   41|  13.2k|        .update(curve_id.as_bytes())
   42|  13.2k|        .update(b"_XMD:BLAKE2b_SSWU_RO_")
