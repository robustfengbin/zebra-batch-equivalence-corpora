_RNvMNtNtNtCslACC4ZJCqa1_13halo2_gadgets3ecc4chip14add_incompleteNtB2_6Config11create_gate:
   56|      6|    fn create_gate(&self, meta: &mut ConstraintSystem<pallas::Base>) {
   57|       |        // https://p.z.cash/halo2-0.1:ecc-incomplete-addition
   58|      6|        meta.create_gate("incomplete addition", |meta| {
   59|       |            let q_add_incomplete = meta.query_selector(self.q_add_incomplete);
   60|       |            let x_p = meta.query_advice(self.x_p, Rotation::cur());
   61|       |            let y_p = meta.query_advice(self.y_p, Rotation::cur());
   62|       |            let x_q = meta.query_advice(self.x_qr, Rotation::cur());
   63|       |            let y_q = meta.query_advice(self.y_qr, Rotation::cur());
   64|       |            let x_r = meta.query_advice(self.x_qr, Rotation::next());
   65|       |            let y_r = meta.query_advice(self.y_qr, Rotation::next());
   66|       |
   67|       |            // (x_r + x_q + x_p)⋅(x_p − x_q)^2 − (y_p − y_q)^2 = 0
   68|       |            let poly1 = {
   69|       |                (x_r.clone() + x_q.clone() + x_p.clone())
   70|       |                    * (x_p.clone() - x_q.clone())
   71|       |                    * (x_p.clone() - x_q.clone())
   72|       |                    - (y_p.clone() - y_q.clone()).square()
   73|       |            };
   74|       |
   75|       |            // (y_r + y_q)(x_p − x_q) − (y_p − y_q)(x_q − x_r) = 0
   76|       |            let poly2 = (y_r + y_q.clone()) * (x_p - x_q.clone()) - (y_p - y_q) * (x_q - x_r);
   77|       |
   78|       |            Constraints::with_selector(q_add_incomplete, [("x_r", poly1), ("y_r", poly2)])
   79|       |        });
   80|      6|    }
