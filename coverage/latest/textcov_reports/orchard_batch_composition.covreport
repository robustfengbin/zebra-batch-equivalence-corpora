   11|  13.2k|pub fn hash_to_field<F: FromUniformBytes<64>>(
   12|  13.2k|    curve_id: &str,
   13|  13.2k|    domain_prefix: &str,
   14|  13.2k|    message: &[u8],
   15|  13.2k|    buf: &mut [F; 2],
   16|  13.2k|) {
   17|  13.2k|    assert!(domain_prefix.len() < 256);
   18|  13.2k|    assert!((22 + curve_id.len() + domain_prefix.len()) < 256);
   19|       |
   20|       |    // Assume that the field size is 32 bytes and k is 256, where k is defined in
   21|       |    // <https://www.ietf.org/archive/id/draft-irtf-cfrg-hash-to-curve-10.html#name-security-considerations-3>.
