   79|      6|        meta.create_gate("complete addition", |meta| {
   80|      6|            let q_add = meta.query_selector(self.q_add);
   81|      6|            let x_p = meta.query_advice(self.x_p, Rotation::cur());
   82|      6|            let y_p = meta.query_advice(self.y_p, Rotation::cur());
   83|      6|            let x_q = meta.query_advice(self.x_qr, Rotation::cur());
   84|      6|            let y_q = meta.query_advice(self.y_qr, Rotation::cur());
   85|      6|            let x_r = meta.query_advice(self.x_qr, Rotation::next());
   86|      6|            let y_r = meta.query_advice(self.y_qr, Rotation::next());
   87|      6|            let lambda = meta.query_advice(self.lambda, Rotation::cur());
   88|       |
   89|       |            // α = inv0(x_q - x_p)
   90|      6|            let alpha = meta.query_advice(self.alpha, Rotation::cur());
   91|       |            // β = inv0(x_p)
   92|      6|            let beta = meta.query_advice(self.beta, Rotation::cur());
   93|       |            // γ = inv0(x_q)
   94|      6|            let gamma = meta.query_advice(self.gamma, Rotation::cur());
   95|       |            // δ = inv0(y_p + y_q) if x_q = x_p, 0 otherwise
   96|      6|            let delta = meta.query_advice(self.delta, Rotation::cur());
   97|       |
   98|       |            // Useful composite expressions
   99|       |            // (x_q − x_p)
  100|      6|            let x_q_minus_x_p = x_q.clone() - x_p.clone();
  101|       |            // (x_p - x_r)
  102|      6|            let x_p_minus_x_r = x_p.clone() - x_r.clone();
  103|       |            // (y_q + y_p)
  104|      6|            let y_q_plus_y_p = y_q.clone() + y_p.clone();
  105|       |            // α ⋅(x_q - x_p)
  106|      6|            let if_alpha = x_q_minus_x_p.clone() * alpha;
  107|       |            // β ⋅ x_p
  108|      6|            let if_beta = x_p.clone() * beta;
  109|       |            // γ ⋅ x_q
  110|      6|            let if_gamma = x_q.clone() * gamma;
  111|       |            // δ ⋅(y_q + y_p)
  112|      6|            let if_delta = y_q_plus_y_p.clone() * delta;
  113|       |
  114|       |            // Useful constants
  115|      6|            let one = Expression::Constant(pallas::Base::one());
  116|      6|            let two = Expression::Constant(pallas::Base::from(2));
  117|      6|            let three = Expression::Constant(pallas::Base::from(3));
  118|       |
  119|       |            // (x_q − x_p)⋅((x_q − x_p)⋅λ − (y_q−y_p)) = 0
  120|      6|            let poly1 = {
  121|      6|                let y_q_minus_y_p = y_q.clone() - y_p.clone(); // (y_q − y_p)
  122|      6|                let incomplete = x_q_minus_x_p.clone() * lambda.clone() - y_q_minus_y_p; // (x_q − x_p)⋅λ − (y_q−y_p)
  123|       |
  124|       |                // q_add ⋅(x_q − x_p)⋅((x_q − x_p)⋅λ − (y_q−y_p))
  125|      6|                x_q_minus_x_p.clone() * incomplete
  126|       |            };
  127|       |
  128|       |            // (1 - (x_q - x_p)⋅α)⋅(2y_p ⋅λ - 3x_p^2) = 0
  129|      6|            let poly2 = {
  130|      6|                let three_x_p_sq = three * x_p.clone().square(); // 3x_p^2
  131|      6|                let two_y_p = two * y_p.clone(); // 2y_p
  132|      6|                let tangent_line = two_y_p * lambda.clone() - three_x_p_sq; // (2y_p ⋅λ - 3x_p^2)
  133|       |
  134|       |                // q_add ⋅(1 - (x_q - x_p)⋅α)⋅(2y_p ⋅λ - 3x_p^2)
  135|      6|                (one.clone() - if_alpha.clone()) * tangent_line
  136|       |            };
  137|       |
  138|       |            // (λ^2 - x_p - x_q - x_r)
  139|      6|            let nonexceptional_x_r =
  140|      6|                lambda.clone().square() - x_p.clone() - x_q.clone() - x_r.clone();
  141|       |            // (λ ⋅(x_p - x_r) - y_p - y_r)
  142|      6|            let nonexceptional_y_r = lambda * x_p_minus_x_r - y_p.clone() - y_r.clone();
  143|       |
  144|       |            // x_p⋅x_q⋅(x_q - x_p)⋅(λ^2 - x_p - x_q - x_r) = 0
  145|      6|            let poly3a =
  146|      6|                x_p.clone() * x_q.clone() * x_q_minus_x_p.clone() * nonexceptional_x_r.clone();
  147|       |
  148|       |            // x_p⋅x_q⋅(x_q - x_p)⋅(λ ⋅(x_p - x_r) - y_p - y_r) = 0
  149|      6|            let poly3b = x_p.clone() * x_q.clone() * x_q_minus_x_p * nonexceptional_y_r.clone();
  150|       |
  151|       |            // x_p⋅x_q⋅(y_q + y_p)⋅(λ^2 - x_p - x_q - x_r) = 0
  152|      6|            let poly3c = x_p.clone() * x_q.clone() * y_q_plus_y_p.clone() * nonexceptional_x_r;
  153|       |
  154|       |            // x_p⋅x_q⋅(y_q + y_p)⋅(λ ⋅(x_p - x_r) - y_p - y_r) = 0
  155|      6|            let poly3d = x_p.clone() * x_q.clone() * y_q_plus_y_p * nonexceptional_y_r;
  156|       |
  157|       |            // (1 - x_p * β) * (x_r - x_q) = 0
  158|      6|            let poly4a = (one.clone() - if_beta.clone()) * (x_r.clone() - x_q);
  159|       |
  160|       |            // (1 - x_p * β) * (y_r - y_q) = 0
  161|      6|            let poly4b = (one.clone() - if_beta) * (y_r.clone() - y_q);
  162|       |
  163|       |            // (1 - x_q * γ) * (x_r - x_p) = 0
  164|      6|            let poly5a = (one.clone() - if_gamma.clone()) * (x_r.clone() - x_p);
  165|       |
  166|       |            // (1 - x_q * γ) * (y_r - y_p) = 0
  167|      6|            let poly5b = (one.clone() - if_gamma) * (y_r.clone() - y_p);
  168|       |
  169|       |            // ((1 - (x_q - x_p) * α - (y_q + y_p) * δ)) * x_r
  170|      6|            let poly6a = (one.clone() - if_alpha.clone() - if_delta.clone()) * x_r;
  171|       |
  172|       |            // ((1 - (x_q - x_p) * α - (y_q + y_p) * δ)) * y_r
  173|      6|            let poly6b = (one - if_alpha - if_delta) * y_r;
  174|       |
  175|      6|            Constraints::with_selector(
  176|      6|                q_add,
  177|      6|                [
  178|      6|                    ("1", poly1),
  179|      6|                    ("2", poly2),
  180|      6|                    ("3a", poly3a),
  181|      6|                    ("3b", poly3b),
  182|      6|                    ("3c", poly3c),
  183|      6|                    ("3d", poly3d),
  184|      6|                    ("4a", poly4a),
  185|      6|                    ("4b", poly4b),
  186|      6|                    ("5a", poly5a),
  187|      6|                    ("5b", poly5b),
  188|      6|                    ("6a", poly6a),
  189|      6|                    ("6b", poly6b),
  190|      6|                ],
  191|       |            )
  192|      6|        });
