  127|  24.6k|    pub fn sqrt_ratio(&self, num: &F, div: &F) -> (Choice, F) {
  128|       |        // Based on:
  129|       |        // * [Sarkar2020](https://eprint.iacr.org/2020/1407)
  130|       |        // * [BDLSY2012](https://cr.yp.to/papers.html#ed25519)
  131|       |        //
  132|       |        // We need to calculate uv and v, where v = u^((T-1)/2), u = num/div, and p-1 = T * 2^S.
  133|       |        // We can rewrite as follows:
  134|       |        //
  135|       |        //      v = (num/div)^((T-1)/2)
  136|       |        //        = num^((T-1)/2) * div^(p-1 - (T-1)/2)    [Fermat's Little Theorem]
  137|       |        //        =       "       * div^(T * 2^S - (T-1)/2)
  138|       |        //        =       "       * div^((2^(S+1) - 1)*(T-1)/2 + 2^S)
  139|       |        //        = (num * div^(2^(S+1) - 1))^((T-1)/2) * div^(2^S)
  140|       |        //
  141|       |        // Let  w = (num * div^(2^(S+1) - 1))^((T-1)/2) * div^(2^S - 1).
  142|       |        // Then v = w * div, and uv = num * v / div = num * w.
  143|       |        //
  144|       |        // We calculate:
  145|       |        //
  146|       |        //      s = div^(2^S - 1) using an addition chain
  147|       |        //      t = div^(2^(S+1) - 1) = s^2 * div
  148|       |        //      w = (num * t)^((T-1)/2) * s using another addition chain
  149|       |        //
  150|       |        // then u and uv as above. The addition chains are given in
  151|       |        // https://github.com/zcash/pasta/blob/master/addchain_sqrt.py .
  152|       |        // The overall cost of this part is similar to a single full-width exponentiation,
  153|       |        // regardless of S.
  154|       |
  155|  24.6k|        let sqr = |x: F, i: u32| (0..i).fold(x, |x, _| x.square());
  156|       |
  157|       |        // s = div^(2^S - 1)
  158|  24.6k|        let s = (0..5).fold(*div, |d: F, i| sqr(d, 1 << i) * d);
  159|       |
  160|       |        // t == div^(2^(S+1) - 1)
  161|  24.6k|        let t = s.square() * div;
  162|       |
  163|       |        // w = (num * t)^((T-1)/2) * s
  164|  24.6k|        let w = (t * num).pow_by_t_minus1_over2() * s;
  165|       |
  166|       |        // v == u^((T-1)/2)
  167|  24.6k|        let v = w * div;
  168|       |
  169|       |        // uv = u * v
  170|  24.6k|        let uv = w * num;
  171|       |
  172|  24.6k|        let res = self.sqrt_common(&uv, &v);
  173|       |
  174|  24.6k|        let sqdiv = res.square() * div;
  175|  24.6k|        let is_square = (sqdiv - num).is_zero();
  176|  24.6k|        let is_nonsquare = (sqdiv - F::ROOT_OF_UNITY * num).is_zero();
  177|  24.6k|        assert!(bool::from(
  178|  24.6k|            num.is_zero() | div.is_zero() | (is_square ^ is_nonsquare)
  179|  24.6k|        ));
  180|       |
  181|  24.6k|        (is_square, res)
  182|  24.6k|    }
_RNvMs_NtNtCs5ei4Ir5UmKx_12pasta_curves10arithmetic6fieldsINtB4_10SqrtTablesNtNtNtB8_6fields2fq2FqE11sqrt_commonB8_:
  200|   538k|    fn sqrt_common(&self, uv: &F, v: &F) -> F {
  201|   538k|        let sqr = |x: F, i: u32| (0..i).fold(x, |x, _| x.square());
  202|   538k|        let inv = |x: F| self.inv[self.hasher.hash(&x)] as usize;
  203|       |
  204|   538k|        let x3 = *uv * v;
  205|   538k|        let x2 = sqr(x3, 8);
  206|   538k|        let x1 = sqr(x2, 8);
  207|   538k|        let x0 = sqr(x1, 8);
  208|       |
  209|       |        // i = 0, 1
  210|   538k|        let mut t_ = inv(x0); // = t >> 16
  211|       |                              // 1 == x0 * ROOT_OF_UNITY^(t_ << 24)
  212|   538k|        assert!(t_ < 0x100);
  213|   538k|        let alpha = x1 * self.g2[t_];
  214|       |
  215|       |        // i = 2
  216|   538k|        t_ += inv(alpha) << 8; // = t >> 8
  217|       |                               // 1 == x1 * ROOT_OF_UNITY^(t_ << 16)
  218|   538k|        assert!(t_ < 0x10000);
  219|   538k|        let alpha = x2 * self.g1[t_ & 0xFF] * self.g2[t_ >> 8];
  220|       |
  221|       |        // i = 3
  222|   538k|        t_ += inv(alpha) << 16; // = t
  223|       |                                // 1 == x2 * ROOT_OF_UNITY^(t_ << 8)
  224|   538k|        assert!(t_ < 0x1000000);
  225|   538k|        let alpha = x3 * self.g0[t_ & 0xFF] * self.g1[(t_ >> 8) & 0xFF] * self.g2[t_ >> 16];
  226|       |
  227|   538k|        t_ += inv(alpha) << 24; // = t << 1
  228|       |                                // 1 == x3 * ROOT_OF_UNITY^t_
  229|   538k|        t_ = (((t_ as u64) + 1) >> 1) as usize;
  230|   538k|        assert!(t_ <= 0x80000000);
  231|       |
  232|   538k|        *uv * self.g0[t_ & 0xFF]
  233|   538k|            * self.g1[(t_ >> 8) & 0xFF]
  234|   538k|            * self.g2[(t_ >> 16) & 0xFF]
  235|   538k|            * self.g3[t_ >> 24]
  236|   538k|    }
