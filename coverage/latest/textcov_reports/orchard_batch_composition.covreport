  151|     36|            let y_p = {
  152|     36|                let base_y = base.y.copy_advice(
  153|       |                    || "Copy `base.y`",
  154|     36|                    region,
  155|     36|                    self.z_complete,
  156|     36|                    row + offset + 1,
  157|      0|                )?;
  158|       |
  159|       |                // If the bit is set, use `y`; if the bit is not set, use `-y`
