   56|      6|    pub(super) fn configure(
   57|      6|        meta: &mut ConstraintSystem<pallas::Base>,
   58|      6|        lagrange_coeffs: [Column<Fixed>; H],
   59|      6|        window: Column<Advice>,
   60|      6|        u: Column<Advice>,
   61|      6|        add_config: add::Config,
   62|      6|        add_incomplete_config: add_incomplete::Config,
   63|      6|    ) -> Self {
   64|      6|        meta.enable_equality(window);
   65|      6|        meta.enable_equality(u);
   66|       |
   67|      6|        let q_running_sum = meta.selector();
