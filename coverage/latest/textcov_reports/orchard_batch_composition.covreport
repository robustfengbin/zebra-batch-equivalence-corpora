  842|     12|    fn configure(
  843|     12|        meta: &mut ConstraintSystem<pallas::Base>,
  844|     12|        col_l: Column<Advice>,
  845|     12|        col_m: Column<Advice>,
  846|     12|        col_r: Column<Advice>,
  847|     12|        col_z: Column<Advice>,
  848|     12|        two_pow_4: pallas::Base,
  849|     12|        two_pow_140: Expression<pallas::Base>,
  850|     12|        two_pow_254: pallas::Base,
  851|     12|        t_p: Expression<pallas::Base>,
  852|     12|    ) -> Self {
  853|     12|        let q_notecommit_pk_d = meta.selector();
  854|       |
  855|     12|        meta.create_gate("NoteCommit input pk_d", |meta| {
  856|       |            let q_notecommit_pk_d = meta.query_selector(q_notecommit_pk_d);
  857|       |
  858|       |            let pkd_x = meta.query_advice(col_l, Rotation::cur());
  859|       |
  860|       |            // `b_3` has been constrained to 4 bits outside this gate.
  861|       |            let b_3 = meta.query_advice(col_m, Rotation::cur());
  862|       |            // d_0 has been constrained to be boolean outside this gate.
  863|       |            let d_0 = meta.query_advice(col_m, Rotation::next());
  864|       |
  865|       |            // `c` has been constrained to 250 bits by the Sinsemilla hash.
  866|       |            let c = meta.query_advice(col_r, Rotation::cur());
  867|       |            let b3_c_prime = meta.query_advice(col_r, Rotation::next());
  868|       |
  869|       |            let z13_c = meta.query_advice(col_z, Rotation::cur());
  870|       |            let z14_b3_c_prime = meta.query_advice(col_z, Rotation::next());
  871|       |
  872|       |            // x(pk_d) = b_3 + (2^4)c + (2^254)d_0
  873|       |            let decomposition_check = {
  874|       |                let sum = b_3.clone() + c.clone() * two_pow_4 + d_0.clone() * two_pow_254;
  875|       |                sum - pkd_x
  876|       |            };
  877|       |
  878|       |            // b3_c_prime = b_3 + (2^4)c + 2^140 - t_P
  879|       |            let b3_c_prime_check = b_3 + (c * two_pow_4) + two_pow_140 - t_p - b3_c_prime;
  880|       |
  881|       |            // The pkd_x_canonicity_checks are enforced if and only if `d_0` = 1.
  882|       |            // `x(pk_d)` = `b_3 (4 bits) || c (250 bits) || d_0 (1 bit)`
  883|       |            let canonicity_checks = iter::empty()
  884|       |                .chain(Some(("d_0 = 1 => z13_c", z13_c)))
  885|       |                .chain(Some(("d_0 = 1 => z14_b3_c_prime", z14_b3_c_prime)))
  886|       |                .map(move |(name, poly)| (name, d_0.clone() * poly));
  887|       |
  888|       |            Constraints::with_selector(
  889|       |                q_notecommit_pk_d,
  890|       |                iter::empty()
  891|       |                    .chain(Some(("decomposition", decomposition_check)))
  892|       |                    .chain(Some(("b3_c_prime_check", b3_c_prime_check)))
  893|       |                    .chain(canonicity_checks),
  894|       |            )
  895|       |        });
  896|       |
  897|     12|        Self {
  898|     12|            q_notecommit_pk_d,
  899|     12|            col_l,
  900|     12|            col_m,
  901|     12|            col_r,
  902|     12|            col_z,
  903|     12|        }
  904|     12|    }
