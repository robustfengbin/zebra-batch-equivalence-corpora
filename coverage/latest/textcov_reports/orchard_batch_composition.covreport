  725|     12|    fn configure(
  726|     12|        meta: &mut ConstraintSystem<pallas::Base>,
  727|     12|        col_l: Column<Advice>,
  728|     12|        col_m: Column<Advice>,
  729|     12|        col_r: Column<Advice>,
  730|     12|        col_z: Column<Advice>,
  731|     12|        two_pow_130: Expression<pallas::Base>,
  732|     12|        two_pow_250: pallas::Base,
  733|     12|        two_pow_254: pallas::Base,
  734|     12|        t_p: Expression<pallas::Base>,
  735|     12|    ) -> Self {
  736|     12|        let q_notecommit_g_d = meta.selector();
  737|       |
  738|     12|        meta.create_gate("NoteCommit input g_d", |meta| {
  739|       |            let q_notecommit_g_d = meta.query_selector(q_notecommit_g_d);
  740|       |
  741|       |            let gd_x = meta.query_advice(col_l, Rotation::cur());
  742|       |
  743|       |            // b_0 has been constrained to be 4 bits outside this gate.
  744|       |            let b_0 = meta.query_advice(col_m, Rotation::cur());
  745|       |            // b_1 has been constrained to be boolean outside this gate.
  746|       |            let b_1 = meta.query_advice(col_m, Rotation::next());
  747|       |
  748|       |            // a has been constrained to 250 bits by the Sinsemilla hash.
  749|       |            let a = meta.query_advice(col_r, Rotation::cur());
  750|       |            let a_prime = meta.query_advice(col_r, Rotation::next());
  751|       |
  752|       |            let z13_a = meta.query_advice(col_z, Rotation::cur());
  753|       |            let z13_a_prime = meta.query_advice(col_z, Rotation::next());
  754|       |
  755|       |            // x(g_d) = a + (2^250)b_0 + (2^254)b_1
  756|       |            let decomposition_check = {
  757|       |                let sum = a.clone() + b_0.clone() * two_pow_250 + b_1.clone() * two_pow_254;
  758|       |                sum - gd_x
  759|       |            };
  760|       |
  761|       |            // a_prime = a + 2^130 - t_P
  762|       |            let a_prime_check = a + two_pow_130 - t_p - a_prime;
  763|       |
  764|       |            // The gd_x_canonicity_checks are enforced if and only if `b_1` = 1.
  765|       |            // x(g_d) = a (250 bits) || b_0 (4 bits) || b_1 (1 bit)
  766|       |            let canonicity_checks = iter::empty()
  767|       |                .chain(Some(("b_1 = 1 => b_0", b_0)))
  768|       |                .chain(Some(("b_1 = 1 => z13_a", z13_a)))
  769|       |                .chain(Some(("b_1 = 1 => z13_a_prime", z13_a_prime)))
  770|       |                .map(move |(name, poly)| (name, b_1.clone() * poly));
  771|       |
  772|       |            Constraints::with_selector(
  773|       |                q_notecommit_g_d,
  774|       |                iter::empty()
  775|       |                    .chain(Some(("decomposition", decomposition_check)))
  776|       |                    .chain(Some(("a_prime_check", a_prime_check)))
  777|       |                    .chain(canonicity_checks),
  778|       |            )
  779|       |        });
  780|       |
  781|     12|        Self {
  782|     12|            q_notecommit_g_d,
  783|     12|            col_l,
  784|     12|            col_m,
  785|     12|            col_r,
  786|     12|            col_z,
  787|     12|        }
  788|     12|    }
