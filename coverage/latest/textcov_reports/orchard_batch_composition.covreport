 1115|     12|    pub(crate) unsafe fn extend_from_iter<I, const CHECK: bool>(&mut self, iterable: I)
 1116|     12|        where I: IntoIterator<Item = T>
 1117|       |    {
 1118|     12|        let take = self.capacity() - self.len();
 1119|     12|        let len = self.len();
