 1036|     12|    fn configure(
 1037|     12|        meta: &mut ConstraintSystem<pallas::Base>,
 1038|     12|        col_l: Column<Advice>,
 1039|     12|        col_m: Column<Advice>,
 1040|     12|        col_r: Column<Advice>,
 1041|     12|        col_z: Column<Advice>,
 1042|     12|        two_pow_4: pallas::Base,
 1043|     12|        two_pow_140: Expression<pallas::Base>,
 1044|     12|        two_pow_254: pallas::Base,
 1045|     12|        t_p: Expression<pallas::Base>,
 1046|     12|    ) -> Self {
 1047|     12|        let q_notecommit_rho = meta.selector();
 1048|       |
 1049|     12|        meta.create_gate("NoteCommit input rho", |meta| {
 1050|       |            let q_notecommit_rho = meta.query_selector(q_notecommit_rho);
 1051|       |
 1052|       |            let rho = meta.query_advice(col_l, Rotation::cur());
 1053|       |
 1054|       |            // `e_1` has been constrained to 4 bits outside this gate.
 1055|       |            let e_1 = meta.query_advice(col_m, Rotation::cur());
 1056|       |            let g_0 = meta.query_advice(col_m, Rotation::next());
 1057|       |
 1058|       |            // `f` has been constrained to 250 bits by the Sinsemilla hash.
 1059|       |            let f = meta.query_advice(col_r, Rotation::cur());
 1060|       |            let e1_f_prime = meta.query_advice(col_r, Rotation::next());
 1061|       |
 1062|       |            let z13_f = meta.query_advice(col_z, Rotation::cur());
 1063|       |            let z14_e1_f_prime = meta.query_advice(col_z, Rotation::next());
 1064|       |
 1065|       |            // rho = e_1 + (2^4) f + (2^254) g_0
 1066|       |            let decomposition_check = {
 1067|       |                let sum = e_1.clone() + f.clone() * two_pow_4 + g_0.clone() * two_pow_254;
 1068|       |                sum - rho
 1069|       |            };
 1070|       |
 1071|       |            // e1_f_prime = e_1 + (2^4)f + 2^140 - t_P
 1072|       |            let e1_f_prime_check = e_1 + (f * two_pow_4) + two_pow_140 - t_p - e1_f_prime;
 1073|       |
 1074|       |            // The rho_canonicity_checks are enforced if and only if `g_0` = 1.
 1075|       |            // rho = e_1 (4 bits) || f (250 bits) || g_0 (1 bit)
 1076|       |            let canonicity_checks = iter::empty()
 1077|       |                .chain(Some(("g_0 = 1 => z13_f", z13_f)))
 1078|       |                .chain(Some(("g_0 = 1 => z14_e1_f_prime", z14_e1_f_prime)))
 1079|       |                .map(move |(name, poly)| (name, g_0.clone() * poly));
 1080|       |
 1081|       |            Constraints::with_selector(
 1082|       |                q_notecommit_rho,
 1083|       |                iter::empty()
 1084|       |                    .chain(Some(("decomposition", decomposition_check)))
 1085|       |                    .chain(Some(("e1_f_prime_check", e1_f_prime_check)))
 1086|       |                    .chain(canonicity_checks),
 1087|       |            )
 1088|       |        });
 1089|       |
 1090|     12|        Self {
 1091|     12|            q_notecommit_rho,
 1092|     12|            col_l,
 1093|     12|            col_m,
 1094|     12|            col_r,
 1095|     12|            col_z,
 1096|     12|        }
 1097|     12|    }
_RNvMs7_NtNtCskIihoeCgx9B_7orchard7circuit11note_commitNtB5_13PsiCanonicity9configure:
 1151|     12|    fn configure(
 1152|     12|        meta: &mut ConstraintSystem<pallas::Base>,
 1153|     12|        col_l: Column<Advice>,
 1154|     12|        col_m: Column<Advice>,
 1155|     12|        col_r: Column<Advice>,
 1156|     12|        col_z: Column<Advice>,
 1157|     12|        two_pow_9: pallas::Base,
 1158|     12|        two_pow_130: Expression<pallas::Base>,
 1159|     12|        two_pow_249: pallas::Base,
 1160|     12|        two_pow_254: pallas::Base,
 1161|     12|        t_p: Expression<pallas::Base>,
 1162|     12|    ) -> Self {
 1163|     12|        let q_notecommit_psi = meta.selector();
 1164|       |
 1165|     12|        meta.create_gate("NoteCommit input psi", |meta| {
 1166|       |            let q_notecommit_psi = meta.query_selector(q_notecommit_psi);
 1167|       |
 1168|       |            let psi = meta.query_advice(col_l, Rotation::cur());
 1169|       |            let h_0 = meta.query_advice(col_l, Rotation::next());
 1170|       |
 1171|       |            let g_1 = meta.query_advice(col_m, Rotation::cur());
 1172|       |            let h_1 = meta.query_advice(col_m, Rotation::next());
 1173|       |
 1174|       |            let z1_g = meta.query_advice(col_r, Rotation::cur());
 1175|       |            let g_2 = z1_g;
 1176|       |            let g1_g2_prime = meta.query_advice(col_r, Rotation::next());
 1177|       |
 1178|       |            let z13_g = meta.query_advice(col_z, Rotation::cur());
 1179|       |            let z13_g1_g2_prime = meta.query_advice(col_z, Rotation::next());
 1180|       |
 1181|       |            // psi = g_1 + (2^9) g_2 + (2^249) h_0 + (2^254) h_1
 1182|       |            let decomposition_check = {
 1183|       |                let sum = g_1.clone()
 1184|       |                    + g_2.clone() * two_pow_9
 1185|       |                    + h_0.clone() * two_pow_249
 1186|       |                    + h_1.clone() * two_pow_254;
 1187|       |                sum - psi
 1188|       |            };
 1189|       |
 1190|       |            // g1_g2_prime = g_1 + (2^9)g_2 + 2^130 - t_P
 1191|       |            let g1_g2_prime_check = g_1 + (g_2 * two_pow_9) + two_pow_130 - t_p - g1_g2_prime;
 1192|       |
 1193|       |            // The psi_canonicity_checks are enforced if and only if `h_1` = 1.
 1194|       |            // `psi` = `g_1 (9 bits) || g_2 (240 bits) || h_0 (5 bits) || h_1 (1 bit)`
 1195|       |            let canonicity_checks = iter::empty()
 1196|       |                .chain(Some(("h_1 = 1 => h_0", h_0)))
 1197|       |                .chain(Some(("h_1 = 1 => z13_g", z13_g)))
 1198|       |                .chain(Some(("h_1 = 1 => z13_g1_g2_prime", z13_g1_g2_prime)))
 1199|       |                .map(move |(name, poly)| (name, h_1.clone() * poly));
 1200|       |
 1201|       |            Constraints::with_selector(
 1202|       |                q_notecommit_psi,
 1203|       |                iter::empty()
 1204|       |                    .chain(Some(("decomposition", decomposition_check)))
 1205|       |                    .chain(Some(("g1_g2_prime_check", g1_g2_prime_check)))
 1206|       |                    .chain(canonicity_checks),
 1207|       |            )
 1208|       |        });
 1209|       |
 1210|     12|        Self {
 1211|     12|            q_notecommit_psi,
 1212|     12|            col_l,
 1213|     12|            col_m,
 1214|     12|            col_r,
 1215|     12|            col_z,
 1216|     12|        }
 1217|     12|    }
_RNvMs8_NtNtCskIihoeCgx9B_7orchard7circuit11note_commitNtB5_11YCanonicity9configure:
 1275|     12|    fn configure(
 1276|     12|        meta: &mut ConstraintSystem<pallas::Base>,
 1277|     12|        advices: [Column<Advice>; 10],
 1278|     12|        two: pallas::Base,
 1279|     12|        two_pow_10: pallas::Base,
 1280|     12|        two_pow_130: Expression<pallas::Base>,
 1281|     12|        two_pow_250: pallas::Base,
 1282|     12|        two_pow_254: pallas::Base,
 1283|     12|        t_p: Expression<pallas::Base>,
 1284|     12|    ) -> Self {
 1285|     12|        let q_y_canon = meta.selector();
 1286|       |
 1287|     12|        meta.create_gate("y coordinate checks", |meta| {
 1288|       |            let q_y_canon = meta.query_selector(q_y_canon);
 1289|       |            let y = meta.query_advice(advices[5], Rotation::cur());
 1290|       |            // LSB has been boolean-constrained outside this gate.
 1291|       |            let lsb = meta.query_advice(advices[6], Rotation::cur());
 1292|       |            // k_0 has been constrained to 9 bits outside this gate.
 1293|       |            let k_0 = meta.query_advice(advices[7], Rotation::cur());
 1294|       |            // k_1 = z1_j (witnessed in the next rotation).
 1295|       |            // k_2 has been constrained to 4 bits outside this gate.
 1296|       |            let k_2 = meta.query_advice(advices[8], Rotation::cur());
 1297|       |            // This gate constrains k_3 to be boolean.
 1298|       |            let k_3 = meta.query_advice(advices[9], Rotation::cur());
 1299|       |
 1300|       |            // j = LSB + (2)k_0 + (2^10)k_1
 1301|       |            let j = meta.query_advice(advices[5], Rotation::next());
 1302|       |            let z1_j = meta.query_advice(advices[6], Rotation::next());
 1303|       |            let z13_j = meta.query_advice(advices[7], Rotation::next());
 1304|       |
 1305|       |            // j_prime = j + 2^130 - t_P
 1306|       |            let j_prime = meta.query_advice(advices[8], Rotation::next());
 1307|       |            let z13_j_prime = meta.query_advice(advices[9], Rotation::next());
 1308|       |
 1309|       |            // Decomposition checks
 1310|       |            // https://p.z.cash/orchard-0.1:note-commit-decomposition-y?partial
 1311|       |            let decomposition_checks = {
 1312|       |                // Check that k_3 is boolean
 1313|       |                let k3_check = bool_check(k_3.clone());
 1314|       |                // Check that j = LSB + (2)k_0 + (2^10)k_1
 1315|       |                let k_1 = z1_j;
 1316|       |                let j_check = j.clone() - (lsb + k_0 * two + k_1 * two_pow_10);
 1317|       |                // Check that y = j + (2^250)k_2 + (2^254)k_3
 1318|       |                let y_check =
 1319|       |                    y - (j.clone() + k_2.clone() * two_pow_250 + k_3.clone() * two_pow_254);
 1320|       |                // Check that j_prime = j + 2^130 - t_P
 1321|       |                let j_prime_check = j + two_pow_130 - t_p - j_prime;
 1322|       |
 1323|       |                iter::empty()
 1324|       |                    .chain(Some(("k3_check", k3_check)))
 1325|       |                    .chain(Some(("j_check", j_check)))
 1326|       |                    .chain(Some(("y_check", y_check)))
 1327|       |                    .chain(Some(("j_prime_check", j_prime_check)))
 1328|       |            };
 1329|       |
 1330|       |            // Canonicity checks. These are enforced if and only if k_3 = 1.
 1331|       |            // https://p.z.cash/orchard-0.1:note-commit-canonicity-y?partial
 1332|       |            let canonicity_checks = {
 1333|       |                iter::empty()
 1334|       |                    .chain(Some(("k_3 = 1 => k_2 = 0", k_2)))
 1335|       |                    .chain(Some(("k_3 = 1 => z13_j = 0", z13_j)))
 1336|       |                    .chain(Some(("k_3 = 1 => z13_j_prime = 0", z13_j_prime)))
 1337|       |                    .map(move |(name, poly)| (name, k_3.clone() * poly))
 1338|       |            };
 1339|       |
 1340|       |            Constraints::with_selector(q_y_canon, decomposition_checks.chain(canonicity_checks))
 1341|       |        });
 1342|       |
 1343|     12|        Self { q_y_canon, advices }
 1344|     12|    }
_RNvMs9_NtNtCskIihoeCgx9B_7orchard7circuit11note_commitNtB5_14NoteCommitChip9configure:
 1456|     12|    pub(in crate::circuit) fn configure(
 1457|     12|        meta: &mut ConstraintSystem<pallas::Base>,
 1458|     12|        advices: [Column<Advice>; 10],
 1459|     12|        sinsemilla_config: SinsemillaConfig<
 1460|     12|            OrchardHashDomains,
 1461|     12|            OrchardCommitDomains,
 1462|     12|            OrchardFixedBases,
 1463|     12|        >,
 1464|     12|    ) -> NoteCommitConfig {
 1465|       |        // Useful constants
 1466|     12|        let two = pallas::Base::from(2);
 1467|     12|        let two_pow_2 = pallas::Base::from(1 << 2);
 1468|     12|        let two_pow_4 = two_pow_2.square();
 1469|     12|        let two_pow_5 = two_pow_4 * two;
 1470|     12|        let two_pow_6 = two_pow_5 * two;
 1471|     12|        let two_pow_8 = two_pow_4.square();
 1472|     12|        let two_pow_9 = two_pow_8 * two;
 1473|     12|        let two_pow_10 = two_pow_9 * two;
 1474|     12|        let two_pow_58 = pallas::Base::from(1 << 58);
 1475|     12|        let two_pow_130 = Expression::Constant(pallas::Base::from_u128(1 << 65).square());
 1476|     12|        let two_pow_140 = Expression::Constant(pallas::Base::from_u128(1 << 70).square());
 1477|     12|        let two_pow_249 = pallas::Base::from_u128(1 << 124).square() * two;
 1478|     12|        let two_pow_250 = two_pow_249 * two;
 1479|     12|        let two_pow_254 = pallas::Base::from_u128(1 << 127).square();
 1480|       |
 1481|     12|        let t_p = Expression::Constant(pallas::Base::from_u128(T_P));
 1482|       |
 1483|       |        // Columns used for MessagePiece and message input gates.
 1484|     12|        let col_l = advices[6];
 1485|     12|        let col_m = advices[7];
 1486|     12|        let col_r = advices[8];
 1487|     12|        let col_z = advices[9];
 1488|       |
 1489|     12|        let b = DecomposeB::configure(meta, col_l, col_m, col_r, two_pow_4, two_pow_5, two_pow_6);
 1490|     12|        let d = DecomposeD::configure(meta, col_l, col_m, col_r, two, two_pow_2, two_pow_10);
 1491|     12|        let e = DecomposeE::configure(meta, col_l, col_m, col_r, two_pow_6);
 1492|     12|        let g = DecomposeG::configure(meta, col_l, col_m, two, two_pow_10);
 1493|     12|        let h = DecomposeH::configure(meta, col_l, col_m, col_r, two_pow_5);
 1494|       |
 1495|     12|        let g_d = GdCanonicity::configure(
 1496|     12|            meta,
 1497|     12|            col_l,
 1498|     12|            col_m,
 1499|     12|            col_r,
 1500|     12|            col_z,
 1501|     12|            two_pow_130.clone(),
 1502|     12|            two_pow_250,
 1503|     12|            two_pow_254,
 1504|     12|            t_p.clone(),
 1505|       |        );
 1506|       |
 1507|     12|        let pk_d = PkdCanonicity::configure(
 1508|     12|            meta,
 1509|     12|            col_l,
 1510|     12|            col_m,
 1511|     12|            col_r,
 1512|     12|            col_z,
 1513|     12|            two_pow_4,
 1514|     12|            two_pow_140.clone(),
 1515|     12|            two_pow_254,
 1516|     12|            t_p.clone(),
 1517|       |        );
 1518|       |
 1519|     12|        let value =
 1520|     12|            ValueCanonicity::configure(meta, col_l, col_m, col_r, col_z, two_pow_8, two_pow_58);
 1521|       |
 1522|     12|        let rho = RhoCanonicity::configure(
 1523|     12|            meta,
 1524|     12|            col_l,
 1525|     12|            col_m,
 1526|     12|            col_r,
 1527|     12|            col_z,
 1528|     12|            two_pow_4,
 1529|     12|            two_pow_140,
 1530|     12|            two_pow_254,
 1531|     12|            t_p.clone(),
 1532|       |        );
 1533|       |
 1534|     12|        let psi = PsiCanonicity::configure(
 1535|     12|            meta,
 1536|     12|            col_l,
 1537|     12|            col_m,
 1538|     12|            col_r,
 1539|     12|            col_z,
 1540|     12|            two_pow_9,
 1541|     12|            two_pow_130.clone(),
 1542|     12|            two_pow_249,
 1543|     12|            two_pow_254,
 1544|     12|            t_p.clone(),
 1545|       |        );
 1546|       |
 1547|     12|        let y_canon = YCanonicity::configure(
 1548|     12|            meta,
 1549|     12|            advices,
 1550|     12|            two,
 1551|     12|            two_pow_10,
 1552|     12|            two_pow_130,
 1553|     12|            two_pow_250,
 1554|     12|            two_pow_254,
 1555|     12|            t_p,
 1556|       |        );
 1557|       |
 1558|     12|        NoteCommitConfig {
 1559|     12|            b,
 1560|     12|            d,
 1561|     12|            e,
 1562|     12|            g,
 1563|     12|            h,
 1564|     12|            g_d,
 1565|     12|            pk_d,
 1566|     12|            value,
 1567|     12|            rho,
 1568|     12|            psi,
 1569|     12|            y_canon,
 1570|     12|            advices,
 1571|     12|            sinsemilla_config,
 1572|     12|        }
 1573|     12|    }
