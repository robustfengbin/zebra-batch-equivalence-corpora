  424|     12|fn decompose_for_scalar_mul(scalar: Value<&pallas::Base>) -> Vec<Value<bool>> {
  425|       |    construct_uint! {
  426|       |        struct U256(4);
  427|       |    }
  428|       |
  429|     12|    let bitstring = scalar.map(|scalar| {
  430|       |        // We use `k = scalar + t_q` in the double-and-add algorithm, where
  431|       |        // the scalar field `F_q = 2^254 + t_q`.
  432|       |        // Note that the addition `scalar + t_q` is not reduced.
  433|       |        //
  434|       |        let scalar = U256::from_little_endian(&scalar.to_repr());
  435|       |        let t_q = U256::from_little_endian(&T_Q.to_le_bytes());
  436|       |        let k = scalar + t_q;
  437|       |
  438|       |        // Little-endian bit representation of `k`.
  439|       |        let bitstring = {
  440|       |            let mut le_bytes = [0u8; 32];
  441|       |            k.to_little_endian(&mut le_bytes);
  442|       |            le_bytes
  443|       |                .into_iter()
  444|       |                .flat_map(|byte| (0..8).map(move |shift| (byte >> shift) % 2 == 1))
  445|       |        };
  446|       |
  447|       |        // Take the first 255 bits.
  448|       |        bitstring
  449|       |            .take(pallas::Scalar::NUM_BITS as usize)
  450|       |            .collect::<Vec<_>>()
  451|       |    });
  452|       |
  453|       |    // Transpose.
  454|     12|    let mut bitstring = bitstring.transpose_vec(pallas::Scalar::NUM_BITS as usize);
  455|       |    // Reverse to get the big-endian bit representation.
  456|     12|    bitstring.reverse();
  457|     12|    bitstring
  458|     12|}
