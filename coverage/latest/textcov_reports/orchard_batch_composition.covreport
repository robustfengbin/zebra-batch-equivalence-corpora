  386|    683|pub(crate) fn to_hash(
  387|    683|    _txversion: TxVersion,
  388|    683|    consensus_branch_id: BranchId,
  389|    683|    header_digest: Blake2bHash,
  390|    683|    transparent_digest: Blake2bHash,
  391|    683|    sapling_digest: Option<Blake2bHash>,
  392|    683|    orchard_digest: Option<Blake2bHash>,
  393|    683|) -> Blake2bHash {
  394|    683|    let mut personal = [0; 16];
  395|    683|    personal[..12].copy_from_slice(ZCASH_TX_PERSONALIZATION_PREFIX);
  396|    683|    (&mut personal[12..])
  397|    683|        .write_u32_le(consensus_branch_id.into())
  398|    683|        .unwrap();
  399|       |
  400|    683|    let mut h = hasher(&personal);
  401|    683|    h.write_all(header_digest.as_bytes()).unwrap();
  402|    683|    h.write_all(transparent_digest.as_bytes()).unwrap();
  403|    683|    h.write_all(
  404|    683|        sapling_digest
  405|    683|            .unwrap_or_else(hash_sapling_txid_empty)
  406|    683|            .as_bytes(),
  407|       |    )
  408|    683|    .unwrap();
  409|    683|    h.write_all(
  410|    683|        orchard_digest
  411|    683|            .unwrap_or_else(|| {
  412|       |                let (value_pool, tx_version) = orchard_commitment_domain(_txversion);
  413|       |                orchard::commitments::hash_bundle_txid_empty(value_pool, tx_version)
  414|       |                    .expect("empty Orchard bundle txid commitment is valid for its tx format")
  415|       |            })
  416|    683|            .as_bytes(),
  417|       |    )
  418|    683|    .unwrap();
  419|       |
  420|    683|    h.finalize()
  421|    683|}
