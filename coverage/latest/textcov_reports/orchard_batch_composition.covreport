   95|     12|        meta.create_gate("NoteCommit MessagePiece b", |meta| {
   96|     12|            let q_notecommit_b = meta.query_selector(q_notecommit_b);
   97|       |
   98|       |            // b has been constrained to 10 bits by the Sinsemilla hash.
   99|     12|            let b = meta.query_advice(col_l, Rotation::cur());
  100|       |            // b_0 has been constrained to be 4 bits outside this gate.
  101|     12|            let b_0 = meta.query_advice(col_m, Rotation::cur());
  102|       |            // This gate constrains b_1 to be boolean.
  103|     12|            let b_1 = meta.query_advice(col_r, Rotation::cur());
  104|       |            // This gate constrains b_2 to be boolean.
  105|     12|            let b_2 = meta.query_advice(col_m, Rotation::next());
  106|       |            // b_3 has been constrained to 4 bits outside this gate.
  107|     12|            let b_3 = meta.query_advice(col_r, Rotation::next());
  108|       |
  109|       |            // b = b_0 + (2^4) b_1 + (2^5) b_2 + (2^6) b_3
  110|     12|            let decomposition_check =
  111|     12|                b - (b_0 + b_1.clone() * two_pow_4 + b_2.clone() * two_pow_5 + b_3 * two_pow_6);
  112|       |
  113|     12|            Constraints::with_selector(
  114|     12|                q_notecommit_b,
  115|     12|                [
  116|     12|                    ("bool_check b_1", bool_check(b_1)),
  117|     12|                    ("bool_check b_2", bool_check(b_2)),
  118|     12|                    ("decomposition", decomposition_check),
  119|     12|                ],
  120|       |            )
