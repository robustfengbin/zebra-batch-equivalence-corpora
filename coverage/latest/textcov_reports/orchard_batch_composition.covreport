_RNvMNtNtCs6mFdeH4K0qJ_12halo2_proofs5plonk11permutationNtB2_8Argument15required_degree:
   26|     18|    pub(crate) fn required_degree(&self) -> usize {
   27|       |        // degree 2:
   28|       |        // l_0(X) * (1 - z(X)) = 0
   29|       |        //
   30|       |        // We will fit as many polynomials p_i(X) as possible
   31|       |        // into the required degree of the circuit, so the
   32|       |        // following will not affect the required degree of
   33|       |        // this middleware.
   34|       |        //
   35|       |        // (1 - (l_last(X) + l_blind(X))) * (
   36|       |        //   z(\omega X) \prod (p(X) + \beta s_i(X) + \gamma)
   37|       |        // - z(X) \prod (p(X) + \delta^i \beta X + \gamma)
   38|       |        // )
   39|       |        //
   40|       |        // On the first sets of columns, except the first
   41|       |        // set, we will do
   42|       |        //
   43|       |        // l_0(X) * (z(X) - z'(\omega^(last) X)) = 0
   44|       |        //
   45|       |        // where z'(X) is the permutation for the previous set
   46|       |        // of columns.
   47|       |        //
   48|       |        // On the final set of columns, we will do
   49|       |        //
   50|       |        // degree 3:
   51|       |        // l_last(X) * (z'(X)^2 - z'(X)) = 0
   52|       |        //
   53|       |        // which will allow the last value to be zero to
   54|       |        // ensure the argument is perfectly complete.
   55|       |
   56|       |        // There are constraints of degree 3 regardless of the
   57|       |        // number of columns involved.
   58|     18|        3
   59|     18|    }
