  506|   789k|    const fn montgomery_reduce(
  507|   789k|        r0: u64,
  508|   789k|        r1: u64,
  509|   789k|        r2: u64,
  510|   789k|        r3: u64,
  511|   789k|        r4: u64,
  512|   789k|        r5: u64,
  513|   789k|        r6: u64,
  514|   789k|        r7: u64,
  515|   789k|    ) -> Self {
  516|       |        // The Montgomery reduction here is based on Algorithm 14.32 in
  517|       |        // Handbook of Applied Cryptography
  518|       |        // <http://cacr.uwaterloo.ca/hac/about/chap14.pdf>.
  519|       |
  520|   789k|        let k = r0.wrapping_mul(INV);
  521|   789k|        let (_, carry) = mac(r0, k, MODULUS.0[0], 0);
  522|   789k|        let (r1, carry) = mac(r1, k, MODULUS.0[1], carry);
  523|   789k|        let (r2, carry) = mac(r2, k, MODULUS.0[2], carry);
  524|   789k|        let (r3, carry) = mac(r3, k, MODULUS.0[3], carry);
  525|   789k|        let (r4, carry2) = adc(r4, 0, carry);
  526|       |
  527|   789k|        let k = r1.wrapping_mul(INV);
  528|   789k|        let (_, carry) = mac(r1, k, MODULUS.0[0], 0);
  529|   789k|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  530|   789k|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
  531|   789k|        let (r4, carry) = mac(r4, k, MODULUS.0[3], carry);
  532|   789k|        let (r5, carry2) = adc(r5, carry2, carry);
  533|       |
  534|   789k|        let k = r2.wrapping_mul(INV);
  535|   789k|        let (_, carry) = mac(r2, k, MODULUS.0[0], 0);
  536|   789k|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  537|   789k|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  538|   789k|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  539|   789k|        let (r6, carry2) = adc(r6, carry2, carry);
  540|       |
  541|   789k|        let k = r3.wrapping_mul(INV);
  542|   789k|        let (_, carry) = mac(r3, k, MODULUS.0[0], 0);
  543|   789k|        let (r4, carry) = mac(r4, k, MODULUS.0[1], carry);
  544|   789k|        let (r5, carry) = mac(r5, k, MODULUS.0[2], carry);
  545|   789k|        let (r6, carry) = mac(r6, k, MODULUS.0[3], carry);
  546|   789k|        let (r7, _) = adc(r7, carry2, carry);
  547|       |
  548|       |        // Result may be within MODULUS of the correct value
  549|   789k|        (&Scalar([r4, r5, r6, r7])).sub(&MODULUS)
  550|   789k|    }
