  309|     12|                &lookup_config,
  310|     12|                layouter.namespace(|| "b_2"),
  311|     12|                nk.value(),
  312|     12|                0..5,
  313|      0|            )?;
  314|       |
  315|     12|            let b = MessagePiece::from_subpieces(
  316|     12|                sinsemilla_chip.clone(),
  317|     12|                layouter.namespace(|| "b = b_0 || b_1 || b_2"),
