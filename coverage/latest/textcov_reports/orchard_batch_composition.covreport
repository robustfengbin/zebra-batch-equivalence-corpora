  198|      6|pub fn slot_in_biggest_advice_first(
  199|      6|    region_shapes: Vec<RegionShape>,
  200|      6|) -> (Vec<RegionStart>, CircuitAllocations) {
  201|      6|    let mut sorted_regions: Vec<_> = region_shapes.into_iter().collect();
  202|      6|    let sort_key = |shape: &RegionShape| {
  203|       |        // Count the number of advice columns
  204|       |        let advice_cols = shape
  205|       |            .columns()
  206|       |            .iter()
  207|       |            .filter(|c| match c {
  208|       |                RegionColumn::Column(c) => matches!(c.column_type(), Any::Advice),
  209|       |                _ => false,
  210|       |            })
  211|       |            .count();
  212|       |        // Sort by advice area (since this has the most contention).
  213|       |        advice_cols * shape.row_count()
  214|       |    };
  215|       |
  216|       |    // This used to incorrectly use `sort_unstable_by_key` with non-unique keys, which gave
  217|       |    // output that differed between 32-bit and 64-bit platforms, and potentially between Rust
  218|       |    // versions.
  219|       |    // We now use `sort_by_cached_key` with non-unique keys, and rely on `region_shapes`
  220|       |    // being sorted by region index (which we also rely on below to return `RegionStart`s
  221|       |    // in the correct order).
  222|       |    #[cfg(not(feature = "floor-planner-v1-legacy-pdqsort"))]
  223|       |    sorted_regions.sort_by_cached_key(sort_key);
  224|       |
  225|       |    // To preserve compatibility, when the "floor-planner-v1-legacy-pdqsort" feature is enabled,
  226|       |    // we use a copy of the pdqsort implementation from the Rust 1.56.1 standard library, fixed
  227|       |    // to its behaviour on 64-bit platforms.
  228|       |    // https://github.com/rust-lang/rust/blob/1.56.1/library/core/src/slice/mod.rs#L2365-L2402
  229|       |    #[cfg(feature = "floor-planner-v1-legacy-pdqsort")]
  230|      6|    halo2_legacy_pdqsort::sort::quicksort(&mut sorted_regions, |a, b| sort_key(a).lt(&sort_key(b)));
  231|       |
  232|      6|    sorted_regions.reverse();
  233|       |
  234|       |    // Lay out the sorted regions.
  235|      6|    let (mut regions, column_allocations) = slot_in(sorted_regions);
  236|       |
  237|       |    // Un-sort the regions so they match the original indexing.
  238|      6|    regions.sort_unstable_by_key(|(_, region)| region.region_index().0);
  239|      6|    let regions = regions.into_iter().map(|(start, _)| start).collect();
  240|       |
  241|      6|    (regions, column_allocations)
  242|      6|}
