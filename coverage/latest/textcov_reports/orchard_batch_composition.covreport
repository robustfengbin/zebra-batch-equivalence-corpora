 1237|      6|    pub(crate) fn compress_selectors(mut self, selectors: Vec<Vec<bool>>) -> (Self, Vec<Vec<F>>) {
 1238|       |        // The number of provided selector assignments must be the number we
 1239|       |        // counted for this constraint system.
 1240|      6|        assert_eq!(selectors.len(), self.num_selectors);
 1241|       |
 1242|       |        // Compute the maximal degree of every selector. We only consider the
 1243|       |        // expressions in gates, as lookup arguments cannot support simple
 1244|       |        // selectors. Selectors that are complex or do not appear in any gates
 1245|       |        // will have degree zero.
 1246|      6|        let mut degrees = vec![0; selectors.len()];
 1247|  1.15k|        for expr in self.gates.iter().flat_map(|gate| gate.polys.iter()) {
 1248|  1.15k|            if let Some(selector) = expr.extract_simple_selector() {
 1249|  1.13k|                degrees[selector.0] = max(degrees[selector.0], expr.degree());
 1250|  1.13k|            }
 1251|       |        }
 1252|       |
 1253|       |        // We will not increase the degree of the constraint system, so we limit
 1254|       |        // ourselves to the largest existing degree constraint.
 1255|      6|        let max_degree = self.degree();
 1256|       |
 1257|      6|        let mut new_columns = vec![];
 1258|      6|        let (polys, selector_assignment) = compress_selectors::process(
 1259|      6|            selectors
 1260|      6|                .into_iter()
 1261|      6|                .zip(degrees.into_iter())
 1262|      6|                .enumerate()
 1263|      6|                .map(
 1264|       |                    |(i, (activations, max_degree))| compress_selectors::SelectorDescription {
 1265|       |                        selector: i,
 1266|       |                        activations,
 1267|       |                        max_degree,
 1268|       |                    },
 1269|       |                )
 1270|      6|                .collect(),
 1271|      6|            max_degree,
 1272|       |            || {
 1273|       |                let column = self.fixed_column();
