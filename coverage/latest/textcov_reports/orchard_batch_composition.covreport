  600|  25.5k|                    .iter()
  601|  25.5k|                    .rev()
  602|  25.5k|                    .flat_map(|byte| (0..8).rev().map(move |i| Choice::from((byte >> i) & 1u8)))
  603|  25.5k|                    .skip(1)
  604|  6.51M|                {
  605|  6.51M|                    acc = acc.double();
  606|  6.51M|                    acc = $name::conditional_select(&acc, &(acc + self), bit);
