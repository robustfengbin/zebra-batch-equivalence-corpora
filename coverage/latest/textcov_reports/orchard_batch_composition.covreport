  155|       |            let poly3d = x_p.clone() * x_q.clone() * y_q_plus_y_p * nonexceptional_y_r;
  156|       |
  157|       |            // (1 - x_p * β) * (x_r - x_q) = 0
  158|       |            let poly4a = (one.clone() - if_beta.clone()) * (x_r.clone() - x_q);
  159|       |
