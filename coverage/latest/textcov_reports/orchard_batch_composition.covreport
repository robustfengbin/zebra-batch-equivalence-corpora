  161|       |            let poly4b = (one.clone() - if_beta) * (y_r.clone() - y_q);
  162|       |
  163|       |            // (1 - x_q * γ) * (x_r - x_p) = 0
  164|       |            let poly5a = (one.clone() - if_gamma.clone()) * (x_r.clone() - x_p);
  165|       |
  166|       |            // (1 - x_q * γ) * (y_r - y_p) = 0
  167|       |            let poly5b = (one.clone() - if_gamma) * (y_r.clone() - y_p);
