   51|      6|        meta.create_gate("overflow checks", |meta| {
   52|      6|            let q_mul_overflow = meta.query_selector(self.q_mul_overflow);
   53|       |
   54|       |            // Constant expressions
   55|      6|            let one = Expression::Constant(pallas::Base::one());
   56|      6|            let two_pow_124 = Expression::Constant(pallas::Base::from_u128(1 << 124));
   57|      6|            let two_pow_130 =
   58|      6|                two_pow_124.clone() * Expression::Constant(pallas::Base::from_u128(1 << 6));
   59|       |
   60|      6|            let z_0 = meta.query_advice(self.advices[0], Rotation::prev());
   61|      6|            let z_130 = meta.query_advice(self.advices[0], Rotation::cur());
   62|      6|            let eta = meta.query_advice(self.advices[0], Rotation::next());
   63|       |
   64|      6|            let k_254 = meta.query_advice(self.advices[1], Rotation::prev());
   65|      6|            let alpha = meta.query_advice(self.advices[1], Rotation::cur());
   66|       |
   67|       |            // s_minus_lo_130 = s - sum_{i = 0}^{129} 2^i ⋅ s_i
   68|      6|            let s_minus_lo_130 = meta.query_advice(self.advices[1], Rotation::next());
   69|       |
   70|      6|            let s = meta.query_advice(self.advices[2], Rotation::cur());
