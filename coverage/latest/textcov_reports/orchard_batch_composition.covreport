_RNvMs_NtNtCskIihoeCgx9B_7orchard7circuit11note_commitNtB4_10DecomposeD9configure:
  229|     12|    fn configure(
  230|     12|        meta: &mut ConstraintSystem<pallas::Base>,
  231|     12|        col_l: Column<Advice>,
  232|     12|        col_m: Column<Advice>,
  233|     12|        col_r: Column<Advice>,
  234|     12|        two: pallas::Base,
  235|     12|        two_pow_2: pallas::Base,
  236|     12|        two_pow_10: pallas::Base,
  237|     12|    ) -> Self {
  238|     12|        let q_notecommit_d = meta.selector();
  239|       |
  240|     12|        meta.create_gate("NoteCommit MessagePiece d", |meta| {
  241|       |            let q_notecommit_d = meta.query_selector(q_notecommit_d);
  242|       |
  243|       |            // d has been constrained to 60 bits by the Sinsemilla hash.
  244|       |            let d = meta.query_advice(col_l, Rotation::cur());
  245|       |            // This gate constrains d_0 to be boolean.
  246|       |            let d_0 = meta.query_advice(col_m, Rotation::cur());
  247|       |            // This gate constrains d_1 to be boolean.
  248|       |            let d_1 = meta.query_advice(col_r, Rotation::cur());
  249|       |            // d_2 has been constrained to 8 bits outside this gate.
  250|       |            let d_2 = meta.query_advice(col_m, Rotation::next());
  251|       |            // d_3 is set to z1_d.
  252|       |            let d_3 = meta.query_advice(col_r, Rotation::next());
  253|       |
  254|       |            // d = d_0 + (2) d_1 + (2^2) d_2 + (2^10) d_3
  255|       |            let decomposition_check =
  256|       |                d - (d_0.clone() + d_1.clone() * two + d_2 * two_pow_2 + d_3 * two_pow_10);
  257|       |
  258|       |            Constraints::with_selector(
  259|       |                q_notecommit_d,
  260|       |                [
  261|       |                    ("bool_check d_0", bool_check(d_0)),
  262|       |                    ("bool_check d_1", bool_check(d_1)),
  263|       |                    ("decomposition", decomposition_check),
  264|       |                ],
  265|       |            )
  266|       |        });
  267|       |
  268|     12|        Self {
  269|     12|            q_notecommit_d,
  270|     12|            col_l,
  271|     12|            col_m,
  272|     12|            col_r,
  273|     12|        }
  274|     12|    }

