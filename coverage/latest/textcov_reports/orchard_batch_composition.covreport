  399|     24|    fn decompose(
  400|     24|        lookup_config: &LookupRangeCheckConfig<pallas::Base, 10>,
  401|     24|        chip: SinsemillaChip<OrchardHashDomains, OrchardCommitDomains, OrchardFixedBases>,
  402|     24|        layouter: &mut impl Layouter<pallas::Base>,
  403|     24|        value: &AssignedCell<NoteValue, pallas::Base>,
  404|     24|        rho: &AssignedCell<pallas::Base, pallas::Base>,
  405|     24|    ) -> Result<
  406|     24|        (
  407|     24|            NoteCommitPiece,
  408|     24|            RangeConstrained<pallas::Base, AssignedCell<pallas::Base, pallas::Base>>,
  409|     24|            RangeConstrained<pallas::Base, AssignedCell<pallas::Base, pallas::Base>>,
  410|     24|        ),
  411|     24|        Error,
  412|     24|    > {
  413|     24|        let value_val = value.value().map(|v| pallas::Base::from(v.inner()));
  414|       |
  415|       |        // Constrain e_0 to be 6 bits.
  416|     24|        let e_0 = RangeConstrained::witness_short(
  417|     24|            lookup_config,
  418|     24|            layouter.namespace(|| "e_0"),
