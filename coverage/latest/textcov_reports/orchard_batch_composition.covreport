  117|       |                || "Copy `z` running sum from incomplete addition",
  118|     12|                region,
  119|     12|                self.z_complete,
  120|     12|                offset,
  121|      0|            )?;
  122|     12|            Z(z)
  123|       |        };
  124|       |
  125|       |        // Store interstitial running sum `z`s in vector
