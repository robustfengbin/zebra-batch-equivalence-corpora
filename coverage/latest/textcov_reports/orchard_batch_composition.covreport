  118|     12|pub(in crate::circuit) fn value_commit_orchard<
  119|     12|    EccChip: EccInstructions<
  120|     12|        pallas::Affine,
  121|     12|        FixedPoints = OrchardFixedBases,
  122|     12|        Var = AssignedCell<pallas::Base, pallas::Base>,
  123|     12|    >,
  124|     12|>(
  125|     12|    mut layouter: impl Layouter<pallas::Base>,
  126|     12|    ecc_chip: EccChip,
  127|     12|    v: ScalarFixedShort<pallas::Affine, EccChip>,
  128|     12|    rcv: ScalarFixed<pallas::Affine, EccChip>,
