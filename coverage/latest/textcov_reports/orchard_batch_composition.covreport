   48|  13.2k|        .update(b_0.as_array())
   49|  13.2k|        .update(&[1])
   50|  13.2k|        .update(domain_prefix.as_bytes())
   51|  13.2k|        .update(b"-")
   52|  13.2k|        .update(curve_id.as_bytes())
   53|  13.2k|        .update(b"_XMD:BLAKE2b_SSWU_RO_")
