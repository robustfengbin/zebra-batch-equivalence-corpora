 1141|      0|                    // The ZST element has logically been moved into the vector.
 1142|      0|                    // There is no memory to write, but dropping `elt` here would
 1143|      0|                    // drop it once now and once again when the vector is dropped.
 1144|      0|                    mem::forget(elt);
 1145|      0|                }
 1146|    276|                ptr = raw_ptr_add(ptr, 1);
 1147|    276|                guard.data += 1;
 1148|       |            } else {
 1149|     12|                return; // success
 1150|       |            }
 1151|       |        }
