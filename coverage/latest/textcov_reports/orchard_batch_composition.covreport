  102|      6|    pub(crate) fn build_vk<C: CurveAffine>(
  103|      6|        self,
  104|      6|        params: &Params<C>,
  105|      6|        domain: &EvaluationDomain<C::Scalar>,
  106|      6|        p: &Argument,
  107|      6|    ) -> VerifyingKey<C> {
  108|       |        // Compute [omega^0, omega^1, ..., omega^{params.n - 1}]
  109|      6|        let mut omega_powers = Vec::with_capacity(params.n as usize);
  110|       |        {
  111|      6|            let mut cur = C::Scalar::ONE;
  112|  12.2k|            for _ in 0..params.n {
  113|  12.2k|                omega_powers.push(cur);
  114|  12.2k|                cur *= &domain.get_omega();
  115|  12.2k|            }
