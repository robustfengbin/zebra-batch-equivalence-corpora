   82|  6.21k|    pub(super) fn assign_region(
   83|  6.21k|        &self,
   84|  6.21k|        p: &NonIdentityEccPoint,
   85|  6.21k|        q: &NonIdentityEccPoint,
   86|  6.21k|        offset: usize,
   87|  6.21k|        region: &mut Region<'_, pallas::Base>,
   88|  6.21k|    ) -> Result<NonIdentityEccPoint, Error> {
