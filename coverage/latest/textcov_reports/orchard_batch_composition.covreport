  342|  5.94G|    const fn montgomery_reduce(
  343|  5.94G|        r0: u64,
  344|  5.94G|        r1: u64,
  345|  5.94G|        r2: u64,
  346|  5.94G|        r3: u64,
  347|  5.94G|        r4: u64,
  348|  5.94G|        r5: u64,
  349|  5.94G|        r6: u64,
  350|  5.94G|        r7: u64,
  351|  5.94G|    ) -> Self {
  352|       |        // The Montgomery reduction here is based on Algorithm 14.32 in
  353|       |        // Handbook of Applied Cryptography
  354|       |        // <http://cacr.uwaterloo.ca/hac/about/chap14.pdf>.
  355|       |
  356|  5.94G|        let k = r0.wrapping_mul(INV);
  357|  5.94G|        let (_, carry) = mac(r0, k, MODULUS.0[0], 0);
  358|  5.94G|        let (r1, carry) = mac(r1, k, MODULUS.0[1], carry);
  359|  5.94G|        let (r2, carry) = mac(r2, k, MODULUS.0[2], carry);
  360|  5.94G|        let (r3, carry) = mac(r3, k, MODULUS.0[3], carry);
  361|  5.94G|        let (r4, carry2) = adc(r4, 0, carry);
  362|       |
  363|  5.94G|        let k = r1.wrapping_mul(INV);
  364|  5.94G|        let (_, carry) = mac(r1, k, MODULUS.0[0], 0);
  365|  5.94G|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  366|  5.94G|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
  367|  5.94G|        let (r4, carry) = mac(r4, k, MODULUS.0[3], carry);
  368|  5.94G|        let (r5, carry2) = adc(r5, carry2, carry);
  369|       |
  370|  5.94G|        let k = r2.wrapping_mul(INV);
  371|  5.94G|        let (_, carry) = mac(r2, k, MODULUS.0[0], 0);
  372|  5.94G|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  373|  5.94G|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  374|  5.94G|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  375|  5.94G|        let (r6, carry2) = adc(r6, carry2, carry);
  376|       |
  377|  5.94G|        let k = r3.wrapping_mul(INV);
  378|  5.94G|        let (_, carry) = mac(r3, k, MODULUS.0[0], 0);
  379|  5.94G|        let (r4, carry) = mac(r4, k, MODULUS.0[1], carry);
  380|  5.94G|        let (r5, carry) = mac(r5, k, MODULUS.0[2], carry);
  381|  5.94G|        let (r6, carry) = mac(r6, k, MODULUS.0[3], carry);
  382|  5.94G|        let (r7, _) = adc(r7, carry2, carry);
  383|       |
  384|       |        // Result may be within MODULUS of the correct value
  385|  5.94G|        (&Fq([r4, r5, r6, r7])).sub(&MODULUS)
  386|  5.94G|    }
