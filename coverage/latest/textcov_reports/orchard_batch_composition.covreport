 1921|     24|        lookup_config: &LookupRangeCheckConfig<pallas::Base, 10>,
 1922|     24|        mut layouter: impl Layouter<pallas::Base>,
 1923|     24|        g_1: RangeConstrained<pallas::Base, AssignedCell<pallas::Base, pallas::Base>>,
 1924|     24|        g_2: AssignedCell<pallas::Base, pallas::Base>,
 1925|     24|    ) -> Result<CanonicityBounds, Error> {
 1926|       |        // `psi` = `g_1 (9 bits) || g_2 (240 bits) || h_0 (5 bits) || h_1 (1 bit)`
 1927|       |        // - h_1 = 1 => (h_0 = 0) ∧ (g_1 + 2^9 g_2 < t_P)
 1928|       |        // - 0 ≤ g_1 + 2^9 g_2 < 2^130
 1929|       |        //     - g_1 is individually constrained to be 9 bits
 1930|       |        //     - z_13 of SinsemillaHash(g) == 0 constrains bits 0..=248 of psi
 1931|       |        //       to 130 bits. z13_g == 0 is directly checked in the gate.
 1932|       |        // - 0 ≤ g_1 + (2^9)g_2 + 2^130 - t_P < 2^130 (13 ten-bit lookups)
 1933|       |
 1934|       |        // Decompose the low 130 bits of g1_g2_prime = g_1 + (2^9)g_2 + 2^130 - t_P,
 1935|       |        // and output the running sum at the end of it.
 1936|       |        // If g1_g2_prime < 2^130, the running sum will be 0.
 1937|     24|        let g1_g2_prime = {
 1938|     24|            let two_pow_9 = Value::known(pallas::Base::from(1u64 << 9));
 1939|     24|            let two_pow_130 = Value::known(pallas::Base::from_u128(1u128 << 65).square());
 1940|     24|            let t_p = Value::known(pallas::Base::from_u128(T_P));
 1941|     24|            g_1.inner().value() + (two_pow_9 * g_2.value()) + two_pow_130 - t_p
 1942|       |        };
 1943|       |
 1944|     24|        let zs = lookup_config.witness_check(
 1945|     24|            layouter.namespace(|| "Decompose low 130 bits of (g_1 + (2^9)g_2 + 2^130 - t_P)"),
 1946|     24|            g1_g2_prime,
 1947|       |            13,
 1948|       |            false,
 1949|      0|        )?;
 1950|     24|        let g1_g2_prime = zs[0].clone();
 1951|     24|        assert_eq!(zs.len(), 14); // [z_0, z_1, ..., z_13]
 1952|       |
 1953|     24|        Ok((g1_g2_prime, zs[13].clone()))
 1954|     24|    }
_RINvNtNtNtCskIihoeCgx9B_7orchard7circuit11note_commit7gadgets14rho_canonicityINtNtCs6mFdeH4K0qJ_12halo2_proofs7circuit18NamespacedLayouterNtNtNtCs5ei4Ir5UmKx_12pasta_curves6fields2fp2FpINtNtNtB1g_13floor_planner2v16V1PassB2c_INtNtNtB1i_5plonk6keygen8AssemblyB2c_EEEEB8_:
 1879|     24|    fn rho_canonicity(
 1880|     24|        lookup_config: &LookupRangeCheckConfig<pallas::Base, 10>,
 1881|     24|        mut layouter: impl Layouter<pallas::Base>,
 1882|     24|        e_1: RangeConstrained<pallas::Base, AssignedCell<pallas::Base, pallas::Base>>,
 1883|     24|        f: AssignedCell<pallas::Base, pallas::Base>,
 1884|     24|    ) -> Result<CanonicityBounds, Error> {
 1885|       |        // `rho` = `e_1 (4 bits) || f (250 bits) || g_0 (1 bit)`
 1886|       |        // - g_0 = 1 => e_1 + 2^4 f < t_P
 1887|       |        // - 0 ≤ e_1 + 2^4 f < 2^134
 1888|       |        //     - e_1 is part of the Sinsemilla message piece
 1889|       |        //       e = e_0 (56 bits) || e_1 (4 bits)
 1890|       |        //     - e_1 is individually constrained to be 4 bits.
 1891|       |        //     - z_13 of SinsemillaHash(f) == 0 constrains bits 4..=253 of rho
 1892|       |        //       to 130 bits. z13_f == 0 is directly checked in the gate.
 1893|       |        // - 0 ≤ e_1 + 2^4 f + 2^140 - t_P < 2^140 (14 ten-bit lookups)
 1894|       |
 1895|     24|        let e1_f_prime = {
 1896|     24|            let two_pow_4 = Value::known(pallas::Base::from(1u64 << 4));
 1897|     24|            let two_pow_140 = Value::known(pallas::Base::from_u128(1u128 << 70).square());
 1898|     24|            let t_p = Value::known(pallas::Base::from_u128(T_P));
 1899|     24|            e_1.inner().value() + (two_pow_4 * f.value()) + two_pow_140 - t_p
 1900|       |        };
 1901|       |
 1902|       |        // Decompose the low 140 bits of e1_f_prime = e_1 + 2^4 f + 2^140 - t_P,
 1903|       |        // and output the running sum at the end of it.
 1904|       |        // If e1_f_prime < 2^140, the running sum will be 0.
 1905|     24|        let zs = lookup_config.witness_check(
 1906|     24|            layouter.namespace(|| "Decompose low 140 bits of (e_1 + 2^4 f + 2^140 - t_P)"),
 1907|     24|            e1_f_prime,
 1908|       |            14,
 1909|       |            false,
 1910|      0|        )?;
 1911|     24|        let e1_f_prime = zs[0].clone();
 1912|     24|        assert_eq!(zs.len(), 15); // [z_0, z_1, ..., z_13, z_14]
 1913|       |
 1914|     24|        Ok((e1_f_prime, zs[14].clone()))
 1915|     24|    }
_RINvNtNtNtCskIihoeCgx9B_7orchard7circuit11note_commit7gadgets16pkd_x_canonicityINtNtCs6mFdeH4K0qJ_12halo2_proofs7circuit18NamespacedLayouterNtNtNtCs5ei4Ir5UmKx_12pasta_curves6fields2fp2FpINtNtNtB1i_13floor_planner2v16V1PassB2e_INtNtNtB1k_5plonk6keygen8AssemblyB2e_EEEEB8_:
 1838|     24|    fn pkd_x_canonicity(
 1839|     24|        lookup_config: &LookupRangeCheckConfig<pallas::Base, 10>,
 1840|     24|        mut layouter: impl Layouter<pallas::Base>,
 1841|     24|        b_3: RangeConstrained<pallas::Base, AssignedCell<pallas::Base, pallas::Base>>,
 1842|     24|        c: AssignedCell<pallas::Base, pallas::Base>,
 1843|     24|    ) -> Result<CanonicityBounds, Error> {
 1844|       |        // `x(pk_d)` = `b_3 (4 bits) || c (250 bits) || d_0 (1 bit)`
 1845|       |        // - d_0 = 1 => b_3 + 2^4 c < t_P
 1846|       |        //     - 0 ≤ b_3 + 2^4 c < 2^134
 1847|       |        //         - b_3 is part of the Sinsemilla message piece
 1848|       |        //           b = b_0 (4 bits) || b_1 (1 bit) || b_2 (1 bit) || b_3 (4 bits)
 1849|       |        //         - b_3 is individually constrained to be 4 bits.
 1850|       |        //         - z_13 of SinsemillaHash(c) == 0 constrains bits 4..=253 of pkd_x
 1851|       |        //           to 130 bits. z13_c is directly checked in the gate.
 1852|       |        //     - 0 ≤ b_3 + 2^4 c + 2^140 - t_P < 2^140 (14 ten-bit lookups)
 1853|       |
 1854|       |        // Decompose the low 140 bits of b3_c_prime = b_3 + 2^4 c + 2^140 - t_P,
 1855|       |        // and output the running sum at the end of it.
 1856|       |        // If b3_c_prime < 2^140, the running sum will be 0.
 1857|     24|        let b3_c_prime = {
 1858|     24|            let two_pow_4 = Value::known(pallas::Base::from(1u64 << 4));
 1859|     24|            let two_pow_140 = Value::known(pallas::Base::from_u128(1u128 << 70).square());
 1860|     24|            let t_p = Value::known(pallas::Base::from_u128(T_P));
 1861|     24|            b_3.inner().value() + (two_pow_4 * c.value()) + two_pow_140 - t_p
 1862|       |        };
 1863|       |
 1864|     24|        let zs = lookup_config.witness_check(
 1865|     24|            layouter.namespace(|| "Decompose low 140 bits of (b_3 + 2^4 c + 2^140 - t_P)"),
 1866|     24|            b3_c_prime,
 1867|       |            14,
 1868|       |            false,
 1869|      0|        )?;
 1870|     24|        let b3_c_prime = zs[0].clone();
 1871|     24|        assert_eq!(zs.len(), 15); // [z_0, z_1, ..., z_13, z_14]
 1872|       |
 1873|     24|        Ok((b3_c_prime, zs[14].clone()))
 1874|     24|    }
_RINvNtNtNtCskIihoeCgx9B_7orchard7circuit11note_commit7gadgets18canon_bitshift_130INtNtCs6mFdeH4K0qJ_12halo2_proofs7circuit18NamespacedLayouterNtNtNtCs5ei4Ir5UmKx_12pasta_curves6fields2fp2FpINtNtNtB1k_13floor_planner2v16V1PassB2g_INtNtNtB1m_5plonk6keygen8AssemblyB2g_EEEEB8_:
 1804|     72|    fn canon_bitshift_130(
 1805|     72|        lookup_config: &LookupRangeCheckConfig<pallas::Base, 10>,
 1806|     72|        mut layouter: impl Layouter<pallas::Base>,
 1807|     72|        a: AssignedCell<pallas::Base, pallas::Base>,
 1808|     72|    ) -> Result<CanonicityBounds, Error> {
 1809|       |        // element = `a (250 bits) || b_0 (4 bits) || b_1 (1 bit)`
 1810|       |        // - b_1 = 1 => b_0 = 0
 1811|       |        // - b_1 = 1 => a < t_P
 1812|       |        //     - 0 ≤ a < 2^130 (z_13 of SinsemillaHash(a))
 1813|       |        //     - 0 ≤ a + 2^130 - t_P < 2^130 (thirteen 10-bit lookups)
 1814|       |
 1815|       |        // Decompose the low 130 bits of a_prime = a + 2^130 - t_P, and output
 1816|       |        // the running sum at the end of it. If a_prime < 2^130, the running sum
 1817|       |        // will be 0.
 1818|     72|        let a_prime = {
 1819|     72|            let two_pow_130 = Value::known(pallas::Base::from_u128(1u128 << 65).square());
 1820|     72|            let t_p = Value::known(pallas::Base::from_u128(T_P));
 1821|     72|            a.value() + two_pow_130 - t_p
 1822|       |        };
 1823|     72|        let zs = lookup_config.witness_check(
 1824|     72|            layouter.namespace(|| "Decompose low 130 bits of (a + 2^130 - t_P)"),
 1825|     72|            a_prime,
 1826|       |            13,
 1827|       |            false,
 1828|      0|        )?;
 1829|     72|        let a_prime = zs[0].clone();
 1830|     72|        assert_eq!(zs.len(), 14); // [z_0, z_1, ..., z_13]
 1831|       |
 1832|     72|        Ok((a_prime, zs[13].clone()))
 1833|     72|    }
