  179|     24|    fn assign(
  180|     24|        &self,
  181|     24|        layouter: &mut impl Layouter<pallas::Base>,
  182|     24|        b: NoteCommitPiece,
  183|     24|        b_0: RangeConstrained<pallas::Base, AssignedCell<pallas::Base, pallas::Base>>,
  184|     24|        b_1: RangeConstrained<pallas::Base, Value<pallas::Base>>,
  185|     24|        b_2: RangeConstrained<pallas::Base, AssignedCell<pallas::Base, pallas::Base>>,
  186|     24|        b_3: RangeConstrained<pallas::Base, AssignedCell<pallas::Base, pallas::Base>>,
  187|     24|    ) -> Result<AssignedCell<pallas::Base, pallas::Base>, Error> {
  188|     24|        layouter.assign_region(
  189|       |            || "NoteCommit MessagePiece b",
  190|       |            |mut region| {
  191|       |                self.q_notecommit_b.enable(&mut region, 0)?;
  192|       |
  193|       |                b.inner()
  194|       |                    .cell_value()
  195|       |                    .copy_advice(|| "b", &mut region, self.col_l, 0)?;
  196|       |                b_0.inner()
  197|       |                    .copy_advice(|| "b_0", &mut region, self.col_m, 0)?;
  198|       |                let b_1 = region.assign_advice(|| "b_1", self.col_r, 0, || *b_1.inner())?;
  199|       |
  200|       |                b_2.inner()
  201|       |                    .copy_advice(|| "b_2", &mut region, self.col_m, 1)?;
  202|       |                b_3.inner()
  203|       |                    .copy_advice(|| "b_3", &mut region, self.col_r, 1)?;
  204|       |
  205|       |                Ok(b_1)
  206|       |            },
  207|       |        )
  208|     24|    }
