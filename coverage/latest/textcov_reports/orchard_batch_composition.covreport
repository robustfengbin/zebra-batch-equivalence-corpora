   69|      2|    pub fn new(hash_xor: u32, hash_mod: usize) -> Self {
   70|       |        use alloc::vec;
   71|       |
   72|      2|        let hasher = SqrtHasher {
   73|      2|            hash_xor,
   74|      2|            hash_mod,
   75|      2|            marker: PhantomData,
   76|      2|        };
   77|       |
   78|      2|        let mut gtab = (0..4).scan(F::ROOT_OF_UNITY, |gi, _| {
   79|       |            // gi == ROOT_OF_UNITY^(256^i)
   80|       |            let gtab_i: Vec<F> = (0..256)
   81|       |                .scan(F::ONE, |acc, _| {
   82|       |                    let res = *acc;
