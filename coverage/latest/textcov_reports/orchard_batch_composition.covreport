 1292|       |            // k_0 has been constrained to 9 bits outside this gate.
 1293|     12|            let k_0 = meta.query_advice(advices[7], Rotation::cur());
 1294|       |            // k_1 = z1_j (witnessed in the next rotation).
 1295|       |            // k_2 has been constrained to 4 bits outside this gate.
 1296|     12|            let k_2 = meta.query_advice(advices[8], Rotation::cur());
 1297|       |            // This gate constrains k_3 to be boolean.
 1298|     12|            let k_3 = meta.query_advice(advices[9], Rotation::cur());
 1299|       |
 1300|       |            // j = LSB + (2)k_0 + (2^10)k_1
 1301|     12|            let j = meta.query_advice(advices[5], Rotation::next());
 1302|     12|            let z1_j = meta.query_advice(advices[6], Rotation::next());
 1303|     12|            let z13_j = meta.query_advice(advices[7], Rotation::next());
 1304|       |
 1305|       |            // j_prime = j + 2^130 - t_P
 1306|     12|            let j_prime = meta.query_advice(advices[8], Rotation::next());
