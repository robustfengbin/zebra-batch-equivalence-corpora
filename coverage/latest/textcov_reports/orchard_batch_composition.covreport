 1962|     48|    fn y_canonicity(
 1963|     48|        lookup_config: &LookupRangeCheckConfig<pallas::Base, 10>,
 1964|     48|        y_canon: &YCanonicity,
 1965|     48|        mut layouter: impl Layouter<pallas::Base>,
 1966|     48|        y: AssignedCell<pallas::Base, pallas::Base>,
 1967|     48|        lsb: RangeConstrained<pallas::Base, Value<pallas::Base>>,
 1968|     48|    ) -> Result<RangeConstrained<pallas::Base, AssignedCell<pallas::Base, pallas::Base>>, Error>
 1969|       |    {
 1970|       |        // Decompose the field element
 1971|       |        //      y = LSB || k_0 || k_1 || k_2 || k_3
 1972|       |        //        = (bit 0) || (bits 1..=9) || (bits 10..=249) || (bits 250..=253) || (bit 254)
 1973|       |
 1974|       |        // Range-constrain k_0 to be 9 bits.
 1975|     48|        let k_0 = RangeConstrained::witness_short(
 1976|     48|            lookup_config,
 1977|     48|            layouter.namespace(|| "k_0"),
 1978|     48|            y.value(),
 1979|     48|            1..10,
 1980|      0|        )?;
 1981|       |
 1982|       |        // k_1 will be constrained by the decomposition of j.
 1983|     48|        let k_1 = RangeConstrained::bitrange_of(y.value(), 10..250);
 1984|       |
 1985|       |        // Range-constrain k_2 to be 4 bits.
 1986|     48|        let k_2 = RangeConstrained::witness_short(
 1987|     48|            lookup_config,
 1988|     48|            layouter.namespace(|| "k_2"),
 1989|     48|            y.value(),
 1990|     48|            250..254,
 1991|      0|        )?;
 1992|       |
 1993|       |        // k_3 will be boolean-constrained in the gate.
 1994|     48|        let k_3 = RangeConstrained::bitrange_of(y.value(), 254..255);
 1995|       |
 1996|       |        // Decompose j = LSB + (2)k_0 + (2^10)k_1 using 25 ten-bit lookups.
 1997|     48|        let (j, z1_j, z13_j) = {
 1998|     48|            let j = {
 1999|     48|                let two = Value::known(pallas::Base::from(2));
 2000|     48|                let two_pow_10 = Value::known(pallas::Base::from(1 << 10));
 2001|     48|                lsb.inner().value() + two * k_0.inner().value() + two_pow_10 * k_1.inner().value()
 2002|       |            };
 2003|     48|            let zs = lookup_config.witness_check(
 2004|     48|                layouter.namespace(|| "Decompose j = LSB + (2)k_0 + (2^10)k_1"),
 2005|     48|                j,
 2006|       |                25,
 2007|       |                true,
 2008|      0|            )?;
 2009|     48|            (zs[0].clone(), zs[1].clone(), zs[13].clone())
 2010|       |        };
 2011|       |
 2012|       |        // Decompose j_prime = j + 2^130 - t_P using 13 ten-bit lookups.
 2013|       |        // We can reuse the canon_bitshift_130 logic here.
 2014|     48|        let (j_prime, z13_j_prime) = canon_bitshift_130(
 2015|     48|            lookup_config,
 2016|     48|            layouter.namespace(|| "j_prime = j + 2^130 - t_P"),
 2017|     48|            j.clone(),
 2018|      0|        )?;
 2019|       |
 2020|     48|        y_canon.assign(
 2021|     48|            &mut layouter,
 2022|     48|            y,
 2023|     48|            lsb,
 2024|     48|            k_0,
 2025|     48|            k_2,
 2026|     48|            k_3,
 2027|     48|            j,
 2028|     48|            z1_j,
 2029|     48|            z13_j,
 2030|     48|            j_prime,
 2031|     48|            z13_j_prime,
 2032|       |        )
 2033|     48|    }
