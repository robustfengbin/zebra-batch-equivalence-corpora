 1207|      6|        let queried_selectors = cells.queried_selectors;
 1208|      6|        let queried_cells = cells.queried_cells;
 1209|       |
 1210|      6|        let (constraint_names, polys): (_, Vec<_>) = constraints
 1211|      6|            .into_iter()
 1212|      6|            .map(|c| c.into())
 1213|      6|            .map(|c| (c.name, c.poly))
 1214|      6|            .unzip();
 1215|       |
 1216|      6|        assert!(
 1217|      6|            !polys.is_empty(),
 1218|      0|            "Gates must contain at least one constraint."
 1219|       |        );
 1220|       |
 1221|      6|        self.gates.push(Gate {
 1222|      6|            name,
 1223|      6|            constraint_names,
 1224|      6|            polys,
 1225|      6|            queried_selectors,
 1226|      6|            queried_cells,
 1227|      6|        });
 1228|      6|    }
