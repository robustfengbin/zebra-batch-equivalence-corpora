  228|     12|    pub(super) fn double_and_add(
  229|     12|        &self,
  230|     12|        region: &mut Region<'_, pallas::Base>,
  231|     12|        offset: usize,
  232|     12|        base: &NonIdentityEccPoint,
  233|     12|        bits: &[Value<bool>],
  234|     12|        acc: (X<pallas::Base>, Y<pallas::Base>, Z<pallas::Base>),
  235|     12|        circuit_version: CircuitVersion,
  236|     12|    ) -> Result<(X<pallas::Base>, Y<pallas::Base>, Vec<Z<pallas::Base>>), Error> {
  237|       |        // Check that we have the correct number of bits for this double-and-add.
  238|     12|        assert_eq!(bits.len(), NUM_BITS);
  239|       |
  240|       |        // Handle exceptional cases
  241|     12|        let (x_p, y_p) = (base.x.value().cloned(), base.y.value().cloned());
  242|     12|        let (x_a, y_a) = (acc.0.value().cloned(), acc.1.value().cloned());
