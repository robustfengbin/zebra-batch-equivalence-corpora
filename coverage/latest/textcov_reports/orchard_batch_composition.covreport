  101|       |                // Q is point at infinity
  102|       |                || (x_q.is_zero_vartime() && y_q.is_zero_vartime())
  103|       |                // x_p = x_q
  104|       |                || (x_p == x_q)
  105|      0|            })?;
  106|       |
  107|       |        // Copy point `p` into `x_p`, `y_p` columns
  108|  6.21k|        p.x.copy_advice(|| "x_p", region, self.x_p, offset)?;
  109|  6.21k|        p.y.copy_advice(|| "y_p", region, self.y_p, offset)?;
  110|       |
