_RINvNtNtNtCslACC4ZJCqa1_13halo2_gadgets3ecc4chip9constants20compute_window_tableNtNtCs5ei4Ir5UmKx_12pasta_curves6curves8EpAffineECskIihoeCgx9B_7orchard:
   40|     42|fn compute_window_table<C: CurveAffine>(base: C, num_windows: usize) -> Vec<[C; H]> {
   41|     42|    let mut window_table: Vec<[C; H]> = Vec::with_capacity(num_windows);
   42|       |
   43|       |    // Generate window table entries for all windows but the last.
   44|       |    // For these first `num_windows - 1` windows, we compute the multiple [(k+2)*(2^3)^w]B.
   45|       |    // Here, w ranges from [0..`num_windows - 1`)
   46|  3.15k|    for w in 0..(num_windows - 1) {
   47|  3.15k|        window_table.push(
   48|  3.15k|            (0..H)
   49|  3.15k|                .map(|k| {
   50|       |                    // scalar = (k+2)*(8^w)
   51|       |                    let scalar = C::Scalar::from(k as u64 + 2)
   52|       |                        * C::Scalar::from(H as u64).pow([w as u64, 0, 0, 0]);
   53|       |                    (base * scalar).to_affine()
   54|       |                })
   55|  3.15k|                .collect::<ArrayVec<C, H>>()
   56|  3.15k|                .into_inner()
   57|  3.15k|                .unwrap(),
   58|       |        );
   59|       |    }
   60|       |
   61|       |    // Generate window table entries for the last window, w = `num_windows - 1`.
   62|       |    // For the last window, we compute [k * (2^3)^w - sum]B, where sum is defined
