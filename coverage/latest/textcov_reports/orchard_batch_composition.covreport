  133|     12|    fn coords_check(
  134|     12|        &self,
  135|     12|        meta: &mut VirtualCells<'_, pallas::Base>,
  136|     12|        window: Expression<pallas::Base>,
  137|     12|    ) -> Vec<(&'static str, Expression<pallas::Base>)> {
  138|     12|        let y_p = meta.query_advice(self.add_config.y_p, Rotation::cur());
  139|     12|        let x_p = meta.query_advice(self.add_config.x_p, Rotation::cur());
  140|     12|        let z = meta.query_fixed(self.fixed_z);
  141|     12|        let u = meta.query_advice(self.u, Rotation::cur());
  142|       |
  143|     12|        let window_pow: Vec<Expression<pallas::Base>> = (0..H)
  144|     12|            .map(|pow| {
  145|       |                (0..pow).fold(Expression::Constant(pallas::Base::one()), |acc, _| {
  146|       |                    acc * window.clone()
  147|       |                })
  148|       |            })
  149|     12|            .collect();
  150|       |
  151|     12|        let interpolated_x = window_pow.iter().zip(self.lagrange_coeffs.iter()).fold(
  152|     12|            Expression::Constant(pallas::Base::zero()),
  153|       |            |acc, (window_pow, coeff)| acc + (window_pow.clone() * meta.query_fixed(*coeff)),
  154|       |        );
  155|       |
  156|       |        // Check interpolation of x-coordinate
  157|     12|        let x_check = interpolated_x - x_p.clone();
  158|       |        // Check that `y + z = u^2`, where `z` is fixed and `u`, `y` are witnessed
  159|     12|        let y_check = u.square() - y_p.clone() - z;
  160|       |        // Check that (x, y) is on the curve
  161|     12|        let on_curve =
  162|     12|            y_p.square() - x_p.clone().square() * x_p - Expression::Constant(pallas::Affine::b());
  163|       |
  164|     12|        vec![
  165|     12|            ("check x", x_check),
  166|     12|            ("check y", y_check),
  167|     12|            ("on-curve", on_curve),
  168|       |        ]
  169|     12|    }
