  524|     24|    fn decompose(
  525|     24|        lookup_config: &LookupRangeCheckConfig<pallas::Base, 10>,
  526|     24|        chip: SinsemillaChip<OrchardHashDomains, OrchardCommitDomains, OrchardFixedBases>,
  527|     24|        layouter: &mut impl Layouter<pallas::Base>,
  528|     24|        rho: &AssignedCell<pallas::Base, pallas::Base>,
  529|     24|        psi: &AssignedCell<pallas::Base, pallas::Base>,
  530|     24|    ) -> Result<
  531|     24|        (
  532|     24|            NoteCommitPiece,
  533|     24|            RangeConstrained<pallas::Base, Value<pallas::Base>>,
  534|     24|            RangeConstrained<pallas::Base, AssignedCell<pallas::Base, pallas::Base>>,
  535|     24|        ),
  536|     24|        Error,
  537|     24|    > {
  538|       |        // g_0 will be boolean-constrained in the gate.
  539|     24|        let g_0 = RangeConstrained::bitrange_of(rho.value(), 254..255);
  540|       |
  541|       |        // Constrain g_1 to be 9 bits.
  542|     24|        let g_1 = RangeConstrained::witness_short(
