  172|       |            // ((1 - (x_q - x_p) * α - (y_q + y_p) * δ)) * y_r
  173|       |            let poly6b = (one - if_alpha - if_delta) * y_r;
  174|       |
  175|       |            Constraints::with_selector(
  176|       |                q_add,
  177|       |                [
  178|       |                    ("1", poly1),
  179|       |                    ("2", poly2),
  180|       |                    ("3a", poly3a),
  181|       |                    ("3b", poly3b),
