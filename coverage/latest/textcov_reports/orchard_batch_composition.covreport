  154|     12|pub(in crate::circuit) fn derive_nullifier<
  155|     12|    PoseidonChip: PoseidonSpongeInstructions<pallas::Base, poseidon::P128Pow5T3, ConstantLength<2>, 3, 2>,
  156|     12|    AddChip: AddInstruction<pallas::Base>,
  157|     12|    EccChip: EccInstructions<
  158|     12|        pallas::Affine,
  159|     12|        FixedPoints = OrchardFixedBases,
  160|     12|        Var = AssignedCell<pallas::Base, pallas::Base>,
  161|     12|    >,
  162|     12|>(
  163|     12|    mut layouter: impl Layouter<pallas::Base>,
  164|     12|    poseidon_chip: PoseidonChip,
  165|     12|    add_chip: AddChip,
  166|     12|    ecc_chip: EccChip,
  167|     12|    rho: AssignedCell<pallas::Base, pallas::Base>,
  168|     12|    psi: &AssignedCell<pallas::Base, pallas::Base>,
  169|     12|    cm: &Point<pallas::Affine, EccChip>,
  170|     12|    nk: AssignedCell<pallas::Base, pallas::Base>,
  171|     12|) -> Result<X<pallas::Affine, EccChip>, plonk::Error> {
  172|       |    // hash = poseidon_hash(nk, rho)
  173|     12|    let hash = {
  174|     12|        let poseidon_message = [nk, rho];
  175|     12|        let poseidon_hasher =
  176|     12|            PoseidonHash::init(poseidon_chip, layouter.namespace(|| "Poseidon init"))?;
  177|     12|        poseidon_hasher.hash(
  178|     12|            layouter.namespace(|| "Poseidon hash (nk, rho)"),
  179|     12|            poseidon_message,
  180|      0|        )?
  181|       |    };
  182|       |
  183|       |    // Add hash output to psi.
  184|       |    // `scalar` = poseidon_hash(nk, rho) + psi.
  185|     12|    let scalar = add_chip.add(
  186|     12|        layouter.namespace(|| "scalar = poseidon_hash(nk, rho) + psi"),
  187|     12|        &hash,
  188|     12|        psi,
  189|      0|    )?;
  190|       |
  191|       |    // Multiply scalar by NullifierK
  192|       |    // `product` = [poseidon_hash(nk, rho) + psi] NullifierK.
  193|       |    //
  194|     12|    let product = {
  195|     12|        let nullifier_k = FixedPointBaseField::from_inner(ecc_chip, NullifierK.into());
  196|     12|        nullifier_k.mul(
  197|     12|            layouter.namespace(|| "[poseidon_output + psi] NullifierK"),
  198|     12|            scalar,
  199|      0|        )?
  200|       |    };
  201|       |
  202|       |    // Add cm to multiplied fixed base to get nf
  203|       |    // cm + [poseidon_output + psi] NullifierK
  204|     12|    cm.add(layouter.namespace(|| "nf"), &product)
  205|     12|        .map(|res| res.extract_p())
  206|     12|}
