  278|     24|        lookup_config: &LookupRangeCheckConfig<pallas::Base, 10>,
  279|     24|        chip: SinsemillaChip<OrchardHashDomains, OrchardCommitDomains, OrchardFixedBases>,
  280|     24|        layouter: &mut impl Layouter<pallas::Base>,
  281|     24|        pk_d: &NonIdentityEccPoint,
  282|     24|        value: &AssignedCell<NoteValue, pallas::Base>,
  283|     24|    ) -> Result<
  284|     24|        (
  285|     24|            NoteCommitPiece,
  286|     24|            RangeConstrained<pallas::Base, Value<pallas::Base>>,
  287|     24|            RangeConstrained<pallas::Base, Value<pallas::Base>>,
  288|     24|            RangeConstrained<pallas::Base, AssignedCell<pallas::Base, pallas::Base>>,
  289|     24|        ),
  290|     24|        Error,
  291|     24|    > {
  292|     24|        let value_val = value.value().map(|v| pallas::Base::from(v.inner()));
  293|       |
  294|       |        // d_0, d_1 will be boolean-constrained in the gate.
  295|     24|        let d_0 = RangeConstrained::bitrange_of(pk_d.x().value(), 254..255);
  296|     24|        let d_1 = RangeConstrained::bitrange_of(pk_d.y().value(), 0..1);
  297|       |
  298|       |        // Constrain d_2 to be 8 bits
  299|     24|        let d_2 = RangeConstrained::witness_short(
  300|     24|            lookup_config,
  301|     24|            layouter.namespace(|| "d_2"),
  302|     24|            value_val.as_ref(),
  303|     24|            0..8,
  304|      0|        )?;
  305|       |
  306|       |        // d_3 = z1_d from the SinsemillaHash(d) running sum output.
  307|     24|        let d_3 = RangeConstrained::bitrange_of(value_val.as_ref(), 8..58);
  308|       |
  309|     24|        let d = MessagePiece::from_subpieces(
  310|     24|            chip,
  311|     24|            layouter.namespace(|| "d"),
  312|     24|            [d_0, d_1, d_2.value(), d_3],
  313|      0|        )?;
  314|       |
  315|     24|        Ok((d, d_0, d_1, d_2))
  316|     24|    }
