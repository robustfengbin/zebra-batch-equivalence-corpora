  195|    252|    pub(super) fn assign_region(
  196|    252|        &self,
  197|    252|        p: &EccPoint,
  198|    252|        q: &EccPoint,
  199|    252|        offset: usize,
  200|    252|        region: &mut Region<'_, pallas::Base>,
  201|    252|    ) -> Result<EccPoint, Error> {
  202|       |        // Enable `q_add` selector
  203|    252|        self.q_add.enable(region, offset)?;
  204|       |
  205|       |        // Copy point `p` into `x_p`, `y_p` columns
  206|    252|        p.x.copy_advice(|| "x_p", region, self.x_p, offset)?;
  207|    252|        p.y.copy_advice(|| "y_p", region, self.y_p, offset)?;
  208|       |
  209|       |        // Copy point `q` into `x_qr`, `y_qr` columns
  210|    252|        q.x.copy_advice(|| "x_q", region, self.x_qr, offset)?;
  211|    252|        q.y.copy_advice(|| "y_q", region, self.y_qr, offset)?;
  212|       |
  213|    252|        let (x_p, y_p) = (p.x.value(), p.y.value());
  214|    252|        let (x_q, y_q) = (q.x.value(), q.y.value());
  215|       |
  216|       |        // Assign α = inv0(x_q - x_p)
  217|    252|        let alpha = (x_q - x_p).invert();
  218|    252|        region.assign_advice(|| "α", self.alpha, offset, || alpha)?;
  219|       |
  220|       |        // Assign β = inv0(x_p)
  221|    252|        let beta = x_p.invert();
  222|    252|        region.assign_advice(|| "β", self.beta, offset, || beta)?;
  223|       |
  224|       |        // Assign γ = inv0(x_q)
  225|    252|        let gamma = x_q.invert();
  226|    252|        region.assign_advice(|| "γ", self.gamma, offset, || gamma)?;
  227|       |
  228|       |        // Assign δ = inv0(y_q + y_p) if x_q = x_p, 0 otherwise
  229|    252|        let delta = x_p
  230|    252|            .zip(x_q)
  231|    252|            .zip(y_p)
  232|    252|            .zip(y_q)
  233|    252|            .map(|(((x_p, x_q), y_p), y_q)| {
  234|       |                if x_q == x_p {
  235|       |                    (y_q + y_p).invert()
  236|       |                } else {
  237|       |                    Assigned::Zero
  238|       |                }
  239|       |            });
  240|    252|        region.assign_advice(|| "δ", self.delta, offset, || delta)?;
  241|       |
  242|       |        #[allow(clippy::collapsible_else_if)]
  243|       |        // Assign lambda
  244|    252|        let lambda =
  245|    252|            x_p.zip(y_p)
  246|    252|                .zip(x_q)
  247|    252|                .zip(y_q)
  248|    252|                .zip(alpha)
  249|    252|                .map(|((((x_p, y_p), x_q), y_q), alpha)| {
  250|       |                    if x_q != x_p {
  251|       |                        // λ = (y_q - y_p)/(x_q - x_p)
  252|       |                        // Here, alpha = inv0(x_q - x_p), which suffices since we
  253|       |                        // know that x_q != x_p in this branch.
  254|       |                        (y_q - y_p) * alpha
  255|       |                    } else {
  256|       |                        if !y_p.is_zero_vartime() {
  257|       |                            // 3(x_p)^2
  258|       |                            let three_x_p_sq = x_p.square() * pallas::Base::from(3);
  259|       |                            // 1 / 2(y_p)
  260|       |                            let inv_two_y_p = y_p.invert() * pallas::Base::TWO_INV;
  261|       |                            // λ = 3(x_p)^2 / 2(y_p)
  262|       |                            three_x_p_sq * inv_two_y_p
  263|       |                        } else {
  264|       |                            Assigned::Zero
  265|       |                        }
  266|       |                    }
  267|       |                });
  268|    252|        region.assign_advice(|| "λ", self.lambda, offset, || lambda)?;
  269|       |
  270|       |        // Calculate (x_r, y_r)
  271|    252|        let r =
  272|    252|            x_p.zip(y_p)
  273|    252|                .zip(x_q)
  274|    252|                .zip(y_q)
  275|    252|                .zip(lambda)
  276|    252|                .map(|((((x_p, y_p), x_q), y_q), lambda)| {
  277|       |                    {
  278|       |                        if x_p.is_zero_vartime() {
  279|       |                            // 0 + Q = Q
  280|       |                            (*x_q, *y_q)
  281|       |                        } else if x_q.is_zero_vartime() {
  282|       |                            // P + 0 = P
  283|       |                            (*x_p, *y_p)
  284|       |                        } else if (x_q == x_p) && (*y_q == -y_p) {
  285|       |                            // P + (-P) maps to (0,0)
  286|       |                            (Assigned::Zero, Assigned::Zero)
  287|       |                        } else {
  288|       |                            // x_r = λ^2 - x_p - x_q
  289|       |                            let x_r = lambda.square() - x_p - x_q;
  290|       |                            // y_r = λ(x_p - x_r) - y_p
  291|       |                            let y_r = lambda * (x_p - x_r) - y_p;
  292|       |                            (x_r, y_r)
  293|       |                        }
  294|       |                    }
  295|       |                });
  296|       |
  297|       |        // Assign x_r
  298|    252|        let x_r = r.map(|r| r.0);
  299|    252|        let x_r_cell = region.assign_advice(|| "x_r", self.x_qr, offset + 1, || x_r)?;
  300|       |
  301|       |        // Assign y_r
  302|    252|        let y_r = r.map(|r| r.1);
  303|    252|        let y_r_cell = region.assign_advice(|| "y_r", self.y_qr, offset + 1, || y_r)?;
  304|       |
  305|    252|        let result = EccPoint::from_coordinates_unchecked(x_r_cell, y_r_cell);
  306|       |
  307|       |        #[cfg(test)]
  308|       |        // Check that the correct sum is obtained.
  309|       |        {
  310|       |            use group::Curve;
  311|       |
  312|       |            let p = p.point();
  313|       |            let q = q.point();
  314|       |            let real_sum = p.zip(q).map(|(p, q)| p + q);
  315|       |            let result = result.point();
  316|       |
  317|       |            real_sum
  318|       |                .zip(result)
  319|       |                .assert_if_known(|(real_sum, result)| &real_sum.to_affine() == result);
  320|       |        }
  321|       |
  322|    252|        Ok(result)
  323|    252|    }
