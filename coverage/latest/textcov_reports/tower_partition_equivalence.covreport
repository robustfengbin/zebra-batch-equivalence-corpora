  544|  12.2k|    const fn montgomery_reduce(
  545|  12.2k|        r0: u64,
  546|  12.2k|        r1: u64,
  547|  12.2k|        r2: u64,
  548|  12.2k|        r3: u64,
  549|  12.2k|        r4: u64,
  550|  12.2k|        r5: u64,
  551|  12.2k|        r6: u64,
  552|  12.2k|        r7: u64,
  553|  12.2k|    ) -> Self {
  554|       |        // The Montgomery reduction here is based on Algorithm 14.32 in
  555|       |        // Handbook of Applied Cryptography
  556|       |        // <http://cacr.uwaterloo.ca/hac/about/chap14.pdf>.
  557|       |
  558|  12.2k|        let k = r0.wrapping_mul(INV);
  559|  12.2k|        let (_, carry) = mac(r0, k, MODULUS.0[0], 0);
  560|  12.2k|        let (r1, carry) = mac(r1, k, MODULUS.0[1], carry);
  561|  12.2k|        let (r2, carry) = mac(r2, k, MODULUS.0[2], carry);
  562|  12.2k|        let (r3, carry) = mac(r3, k, MODULUS.0[3], carry);
  563|  12.2k|        let (r4, carry2) = adc(r4, 0, carry);
  564|       |
  565|  12.2k|        let k = r1.wrapping_mul(INV);
  566|  12.2k|        let (_, carry) = mac(r1, k, MODULUS.0[0], 0);
  567|  12.2k|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  568|  12.2k|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
  569|  12.2k|        let (r4, carry) = mac(r4, k, MODULUS.0[3], carry);
  570|  12.2k|        let (r5, carry2) = adc(r5, carry2, carry);
  571|       |
  572|  12.2k|        let k = r2.wrapping_mul(INV);
  573|  12.2k|        let (_, carry) = mac(r2, k, MODULUS.0[0], 0);
  574|  12.2k|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  575|  12.2k|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  576|  12.2k|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  577|  12.2k|        let (r6, carry2) = adc(r6, carry2, carry);
  578|       |
  579|  12.2k|        let k = r3.wrapping_mul(INV);
  580|  12.2k|        let (_, carry) = mac(r3, k, MODULUS.0[0], 0);
  581|  12.2k|        let (r4, carry) = mac(r4, k, MODULUS.0[1], carry);
  582|  12.2k|        let (r5, carry) = mac(r5, k, MODULUS.0[2], carry);
  583|  12.2k|        let (r6, carry) = mac(r6, k, MODULUS.0[3], carry);
  584|  12.2k|        let (r7, _) = adc(r7, carry2, carry);
