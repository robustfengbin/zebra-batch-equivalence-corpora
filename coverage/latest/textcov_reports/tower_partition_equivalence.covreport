  689|   127k|        let y3 = t0 + t2;
  690|   127k|        let y3 = x3 - y3;
  691|   127k|        let x3 = t0 + t0;
  692|   127k|        let t0 = x3 + t0;
  693|   127k|        let t2 = mul_by_3b(t2);
  694|   127k|        let z3 = t1 + t2;
  695|   127k|        let t1 = t1 - t2;
  696|   127k|        let y3 = mul_by_3b(y3);
  697|   127k|        let x3 = t4 * y3;
  698|   127k|        let t2 = t3 * t1;
  699|   127k|        let x3 = t2 - x3;
  700|   127k|        let y3 = y3 * t0;
  701|   127k|        let t1 = t1 * z3;
  702|   127k|        let y3 = t1 + y3;
  703|   127k|        let t0 = t0 * t3;
  704|   127k|        let z3 = z3 * t4;
  705|   127k|        let z3 = z3 + t0;
  706|       |
  707|   127k|        G1Projective {
  708|   127k|            x: x3,
  709|   127k|            y: y3,
  710|   127k|            z: z3,
  711|   127k|        }
  712|   127k|    }
_RNvMsu_NtCsaKH4ngBG85u_9bls12_3812g1NtB5_12G1Projective6double:
  638|  1.33M|    pub fn double(&self) -> G1Projective {
  639|       |        // Algorithm 9, https://eprint.iacr.org/2015/1060.pdf
  640|       |
