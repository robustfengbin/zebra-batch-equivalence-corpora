  544|  1.25k|    const fn montgomery_reduce(
  545|  1.25k|        r0: u64,
  546|  1.25k|        r1: u64,
  547|  1.25k|        r2: u64,
  548|  1.25k|        r3: u64,
  549|  1.25k|        r4: u64,
  550|  1.25k|        r5: u64,
  551|  1.25k|        r6: u64,
  552|  1.25k|        r7: u64,
  553|  1.25k|    ) -> Self {
  554|       |        // The Montgomery reduction here is based on Algorithm 14.32 in
  555|       |        // Handbook of Applied Cryptography
  556|       |        // <http://cacr.uwaterloo.ca/hac/about/chap14.pdf>.
  557|       |
  558|  1.25k|        let k = r0.wrapping_mul(INV);
  559|  1.25k|        let (_, carry) = mac(r0, k, MODULUS.0[0], 0);
  560|  1.25k|        let (r1, carry) = mac(r1, k, MODULUS.0[1], carry);
  561|  1.25k|        let (r2, carry) = mac(r2, k, MODULUS.0[2], carry);
  562|  1.25k|        let (r3, carry) = mac(r3, k, MODULUS.0[3], carry);
  563|  1.25k|        let (r4, carry2) = adc(r4, 0, carry);
  564|       |
  565|  1.25k|        let k = r1.wrapping_mul(INV);
  566|  1.25k|        let (_, carry) = mac(r1, k, MODULUS.0[0], 0);
  567|  1.25k|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  568|  1.25k|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
  569|  1.25k|        let (r4, carry) = mac(r4, k, MODULUS.0[3], carry);
  570|  1.25k|        let (r5, carry2) = adc(r5, carry2, carry);
  571|       |
  572|  1.25k|        let k = r2.wrapping_mul(INV);
  573|  1.25k|        let (_, carry) = mac(r2, k, MODULUS.0[0], 0);
  574|  1.25k|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  575|  1.25k|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  576|  1.25k|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  577|  1.25k|        let (r6, carry2) = adc(r6, carry2, carry);
  578|       |
  579|  1.25k|        let k = r3.wrapping_mul(INV);
  580|  1.25k|        let (_, carry) = mac(r3, k, MODULUS.0[0], 0);
  581|  1.25k|        let (r4, carry) = mac(r4, k, MODULUS.0[1], carry);
  582|  1.25k|        let (r5, carry) = mac(r5, k, MODULUS.0[2], carry);
  583|  1.25k|        let (r6, carry) = mac(r6, k, MODULUS.0[3], carry);
  584|  1.25k|        let (r7, _) = adc(r7, carry2, carry);
  585|       |
  586|       |        // Result may be within MODULUS of the correct value
  587|  1.25k|        (&Fr([r4, r5, r6, r7])).sub(&MODULUS)
