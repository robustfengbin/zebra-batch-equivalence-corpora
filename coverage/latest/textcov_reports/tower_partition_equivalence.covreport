  219|   963k|            c0: Fp::sum_of_products([self.c0, -self.c1], [rhs.c0, rhs.c1]),
  220|   963k|            c1: Fp::sum_of_products([self.c0, self.c1], [rhs.c1, rhs.c0]),
  221|   963k|        }
  222|   963k|    }
