 1854|      2|        fn build_threaded_runtime(&mut self) -> io::Result<Runtime> {
 1855|       |            use crate::loom::sys::num_cpus;
 1856|       |            use crate::runtime::{Config, runtime::Scheduler};
 1857|       |            use crate::runtime::scheduler::{self, MultiThread};
 1858|       |
 1859|      2|            let worker_threads = self.worker_threads.unwrap_or_else(num_cpus);
 1860|       |
 1861|      2|            let (driver, driver_handle) = driver::Driver::new(self.get_cfg())?;
 1862|       |
 1863|       |            // Create the blocking pool
 1864|      2|            let blocking_pool =
 1865|      2|                blocking::create_blocking_pool(self, self.max_blocking_threads + worker_threads);
 1866|      2|            let blocking_spawner = blocking_pool.spawner().clone();
 1867|       |
 1868|       |            // Generate a rng seed for this runtime.
 1869|      2|            let seed_generator_1 = self.seed_generator.next_generator();
 1870|      2|            let seed_generator_2 = self.seed_generator.next_generator();
 1871|       |
 1872|      2|            let (scheduler, handle, launch) = MultiThread::new(
 1873|      2|                worker_threads,
 1874|      2|                driver,
 1875|      2|                driver_handle,
 1876|      2|                blocking_spawner,
 1877|      2|                seed_generator_2,
 1878|      2|                Config {
 1879|      2|                    before_park: self.before_park.clone(),
 1880|      2|                    after_unpark: self.after_unpark.clone(),
 1881|      2|                    before_spawn: self.before_spawn.clone(),
 1882|      2|                    #[cfg(tokio_unstable)]
 1883|      2|                    before_poll: self.before_poll.clone(),
 1884|      2|                    #[cfg(tokio_unstable)]
 1885|      2|                    after_poll: self.after_poll.clone(),
 1886|      2|                    after_termination: self.after_termination.clone(),
 1887|      2|                    global_queue_interval: self.global_queue_interval,
 1888|      2|                    event_interval: self.event_interval,
 1889|      2|                    #[cfg(tokio_unstable)]
 1890|      2|                    unhandled_panic: self.unhandled_panic.clone(),
 1891|      2|                    disable_lifo_slot: self.disable_lifo_slot,
 1892|      2|                    enable_eager_driver_handoff: self.enable_eager_driver_handoff,
 1893|      2|                    seed_generator: seed_generator_1,
 1894|      2|                    metrics_poll_count_histogram: self.metrics_poll_count_histogram_builder(),
 1895|      2|                },
 1896|      2|                self.timer_flavor,
 1897|      2|                self.name.clone(),
 1898|      2|            );
 1899|       |
 1900|      2|            let handle = Handle { inner: scheduler::Handle::MultiThread(handle) };
 1901|       |
 1902|       |            // Spawn the thread pool workers
 1903|      2|            let _enter = handle.enter();
 1904|      2|            launch.launch();
 1905|       |
 1906|      2|            Ok(Runtime::from_parts(Scheduler::MultiThread(scheduler), handle, blocking_pool))
 1907|      2|        }

