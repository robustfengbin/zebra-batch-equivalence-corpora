  559|  1.27k|        let (_, carry) = mac(r0, k, MODULUS.0[0], 0);
  560|  1.27k|        let (r1, carry) = mac(r1, k, MODULUS.0[1], carry);
  561|  1.27k|        let (r2, carry) = mac(r2, k, MODULUS.0[2], carry);
  562|  1.27k|        let (r3, carry) = mac(r3, k, MODULUS.0[3], carry);
  563|  1.27k|        let (r4, carry2) = adc(r4, 0, carry);
  564|       |
  565|  1.27k|        let k = r1.wrapping_mul(INV);
  566|  1.27k|        let (_, carry) = mac(r1, k, MODULUS.0[0], 0);
  567|  1.27k|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  568|  1.27k|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
  569|  1.27k|        let (r4, carry) = mac(r4, k, MODULUS.0[3], carry);
  570|  1.27k|        let (r5, carry2) = adc(r5, carry2, carry);
  571|       |
  572|  1.27k|        let k = r2.wrapping_mul(INV);
  573|  1.27k|        let (_, carry) = mac(r2, k, MODULUS.0[0], 0);
  574|  1.27k|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  575|  1.27k|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  576|  1.27k|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  577|  1.27k|        let (r6, carry2) = adc(r6, carry2, carry);
  578|       |
  579|  1.27k|        let k = r3.wrapping_mul(INV);
  580|  1.27k|        let (_, carry) = mac(r3, k, MODULUS.0[0], 0);
  581|  1.27k|        let (r4, carry) = mac(r4, k, MODULUS.0[1], carry);
  582|  1.27k|        let (r5, carry) = mac(r5, k, MODULUS.0[2], carry);
  583|  1.27k|        let (r6, carry) = mac(r6, k, MODULUS.0[3], carry);
