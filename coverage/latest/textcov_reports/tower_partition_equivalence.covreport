  613|  12.9k|    pub const fn neg(&self) -> Self {
  614|       |        // Subtract `self` from `MODULUS` to negate. Ignore the final
  615|       |        // borrow because it cannot underflow; self is guaranteed to
  616|       |        // be in the field.
  617|  12.9k|        let (d0, borrow) = sbb(MODULUS.0[0], self.0[0], 0);
  618|  12.9k|        let (d1, borrow) = sbb(MODULUS.0[1], self.0[1], borrow);
  619|  12.9k|        let (d2, borrow) = sbb(MODULUS.0[2], self.0[2], borrow);
  620|  12.9k|        let (d3, _) = sbb(MODULUS.0[3], self.0[3], borrow);
