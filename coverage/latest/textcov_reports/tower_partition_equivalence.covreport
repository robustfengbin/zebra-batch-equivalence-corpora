  551|  5.15M|        let (_, carry) = mac(r5, k, MODULUS[0], 0);
  552|  5.15M|        let (r6, carry) = mac(r6, k, MODULUS[1], carry);
  553|  5.15M|        let (r7, carry) = mac(r7, k, MODULUS[2], carry);
  554|  5.15M|        let (r8, carry) = mac(r8, k, MODULUS[3], carry);
  555|  5.15M|        let (r9, carry) = mac(r9, k, MODULUS[4], carry);
  556|  5.15M|        let (r10, carry) = mac(r10, k, MODULUS[5], carry);
