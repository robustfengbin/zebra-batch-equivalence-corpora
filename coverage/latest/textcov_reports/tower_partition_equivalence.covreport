_RNvMs9_NtCsaKH4ngBG85u_9bls12_3812fpNtB5_2Fp25lexicographically_largest:
  273|  22.2k|    pub fn lexicographically_largest(&self) -> Choice {
  274|       |        // This can be determined by checking to see if the element is
  275|       |        // larger than (p - 1) // 2. If we subtract by ((p - 1) // 2) + 1
  276|       |        // and there is no underflow, then the element must be larger than
  277|       |        // (p - 1) // 2.
  278|       |
  279|       |        // First, because self is in Montgomery form we need to reduce it
  280|  22.2k|        let tmp = Fp::montgomery_reduce(
  281|  22.2k|            self.0[0], self.0[1], self.0[2], self.0[3], self.0[4], self.0[5], 0, 0, 0, 0, 0, 0,
  282|       |        );
  283|       |
  284|  22.2k|        let (_, borrow) = sbb(tmp.0[0], 0xdcff_7fff_ffff_d556, 0);
  285|  22.2k|        let (_, borrow) = sbb(tmp.0[1], 0x0f55_ffff_58a9_ffff, borrow);
  286|  22.2k|        let (_, borrow) = sbb(tmp.0[2], 0xb398_6950_7b58_7b12, borrow);
  287|  22.2k|        let (_, borrow) = sbb(tmp.0[3], 0xb23b_a5c2_79c2_895f, borrow);
  288|  22.2k|        let (_, borrow) = sbb(tmp.0[4], 0x258d_d3db_21a5_d66b, borrow);
  289|  22.2k|        let (_, borrow) = sbb(tmp.0[5], 0x0d00_88f5_1cbf_f34d, borrow);
  290|       |
  291|       |        // If the element was smaller, the subtraction will underflow
  292|       |        // producing a borrow value of 0xffff...ffff, otherwise it will
  293|       |        // be zero. We create a Choice representing true if there was
  294|       |        // overflow (and so this element is not lexicographically larger
  295|       |        // than its negation) and then negate it.
  296|       |
  297|  22.2k|        !Choice::from((borrow as u8) & 1)
  298|  22.2k|    }
_RNvMs9_NtCsaKH4ngBG85u_9bls12_3812fpNtB5_2Fp3addB7_:
  382|  44.4M|    pub const fn add(&self, rhs: &Fp) -> Fp {
  383|  44.4M|        let (d0, carry) = adc(self.0[0], rhs.0[0], 0);
  384|  44.4M|        let (d1, carry) = adc(self.0[1], rhs.0[1], carry);
  385|  44.4M|        let (d2, carry) = adc(self.0[2], rhs.0[2], carry);
  386|  44.4M|        let (d3, carry) = adc(self.0[3], rhs.0[3], carry);
  387|  44.4M|        let (d4, carry) = adc(self.0[4], rhs.0[4], carry);
  388|  44.4M|        let (d5, _) = adc(self.0[5], rhs.0[5], carry);
  389|       |
  390|       |        // Attempt to subtract the modulus, to ensure the value
  391|       |        // is smaller than the modulus.
  392|  44.4M|        (&Fp([d0, d1, d2, d3, d4, d5])).subtract_p()
  393|  44.4M|    }
