  601|  9.09k|        let (r2, carry) = mac(r2, self.0[1], rhs.0[1], carry);
  602|  9.09k|        let (r3, carry) = mac(r3, self.0[1], rhs.0[2], carry);
  603|  9.09k|        let (r4, r5) = mac(r4, self.0[1], rhs.0[3], carry);
  604|       |
  605|  9.09k|        let (r2, carry) = mac(r2, self.0[2], rhs.0[0], 0);
  606|  9.09k|        let (r3, carry) = mac(r3, self.0[2], rhs.0[1], carry);
  607|  9.09k|        let (r4, carry) = mac(r4, self.0[2], rhs.0[2], carry);
  608|  9.09k|        let (r5, r6) = mac(r5, self.0[2], rhs.0[3], carry);
  609|       |
  610|  9.09k|        let (r3, carry) = mac(r3, self.0[3], rhs.0[0], 0);
  611|  9.09k|        let (r4, carry) = mac(r4, self.0[3], rhs.0[1], carry);
  612|  9.09k|        let (r5, carry) = mac(r5, self.0[3], rhs.0[2], carry);
  613|  9.09k|        let (r6, r7) = mac(r6, self.0[3], rhs.0[3], carry);
