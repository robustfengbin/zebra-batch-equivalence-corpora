  746|  34.9k|        let t2 = self.z * rhs.z;
  747|  34.9k|        let t3 = self.x + self.y;
  748|  34.9k|        let t4 = rhs.x + rhs.y;
  749|  34.9k|        let t3 = t3 * t4;
  750|  34.9k|        let t4 = t0 + t1;
  751|  34.9k|        let t3 = t3 - t4;
  752|  34.9k|        let t4 = self.y + self.z;
  753|  34.9k|        let x3 = rhs.y + rhs.z;
  754|  34.9k|        let t4 = t4 * x3;
