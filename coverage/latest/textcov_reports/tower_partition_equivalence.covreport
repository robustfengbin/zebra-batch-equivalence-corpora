  764|  34.9k|        let t2 = mul_by_3b(t2);
  765|  34.9k|        let z3 = t1 + t2;
  766|  34.9k|        let t1 = t1 - t2;
  767|  34.9k|        let y3 = mul_by_3b(y3);
  768|  34.9k|        let x3 = t4 * y3;
  769|  34.9k|        let t2 = t3 * t1;
  770|  34.9k|        let x3 = t2 - x3;
  771|  34.9k|        let y3 = y3 * t0;
  772|  34.9k|        let t1 = t1 * z3;
  773|  34.9k|        let y3 = t1 + y3;
  774|  34.9k|        let t0 = t0 * t3;
  775|  34.9k|        let z3 = z3 * t4;
  776|  34.9k|        let z3 = z3 + t0;
  777|       |
  778|  34.9k|        G2Projective {
