  373|  14.7M|        let r2 = (self.0[2] & borrow) | (r2 & !borrow);
  374|  14.7M|        let r3 = (self.0[3] & borrow) | (r3 & !borrow);
  375|  14.7M|        let r4 = (self.0[4] & borrow) | (r4 & !borrow);
  376|  14.7M|        let r5 = (self.0[5] & borrow) | (r5 & !borrow);
