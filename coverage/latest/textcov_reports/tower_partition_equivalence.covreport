_RNvMs9_NtCsaKH4ngBG85u_9bls12_3812fpNtB5_2Fp10from_bytes:
  179|  22.2k|    pub fn from_bytes(bytes: &[u8; 48]) -> CtOption<Fp> {
  180|  22.2k|        let mut tmp = Fp([0, 0, 0, 0, 0, 0]);
  181|       |
  182|  22.2k|        tmp.0[5] = u64::from_be_bytes(<[u8; 8]>::try_from(&bytes[0..8]).unwrap());
  183|  22.2k|        tmp.0[4] = u64::from_be_bytes(<[u8; 8]>::try_from(&bytes[8..16]).unwrap());
  184|  22.2k|        tmp.0[3] = u64::from_be_bytes(<[u8; 8]>::try_from(&bytes[16..24]).unwrap());
  185|  22.2k|        tmp.0[2] = u64::from_be_bytes(<[u8; 8]>::try_from(&bytes[24..32]).unwrap());
  186|  22.2k|        tmp.0[1] = u64::from_be_bytes(<[u8; 8]>::try_from(&bytes[32..40]).unwrap());
  187|  22.2k|        tmp.0[0] = u64::from_be_bytes(<[u8; 8]>::try_from(&bytes[40..48]).unwrap());
  188|       |
  189|       |        // Try to subtract the modulus
  190|  22.2k|        let (_, borrow) = sbb(tmp.0[0], MODULUS[0], 0);
  191|  22.2k|        let (_, borrow) = sbb(tmp.0[1], MODULUS[1], borrow);
  192|  22.2k|        let (_, borrow) = sbb(tmp.0[2], MODULUS[2], borrow);
  193|  22.2k|        let (_, borrow) = sbb(tmp.0[3], MODULUS[3], borrow);
  194|  22.2k|        let (_, borrow) = sbb(tmp.0[4], MODULUS[4], borrow);
  195|  22.2k|        let (_, borrow) = sbb(tmp.0[5], MODULUS[5], borrow);
  196|       |
  197|       |        // If the element is smaller than MODULUS then the
  198|       |        // subtraction will underflow, producing a borrow value
  199|       |        // of 0xffff...ffff. Otherwise, it'll be zero.
  200|  22.2k|        let is_some = (borrow as u8) & 1;
  201|       |
  202|       |        // Convert to Montgomery form by computing
  203|       |        // (a.R^0 * R^2) / R = a.R
  204|  22.2k|        tmp *= &R2;
  205|       |
  206|  22.2k|        CtOption::new(tmp, Choice::from(is_some))
  207|  22.2k|    }
_RNvMs9_NtCsaKH4ngBG85u_9bls12_3812fpNtB5_2Fp10subtract_pB7_:
  361|  85.3M|    const fn subtract_p(&self) -> Fp {
  362|  85.3M|        let (r0, borrow) = sbb(self.0[0], MODULUS[0], 0);
  363|  85.3M|        let (r1, borrow) = sbb(self.0[1], MODULUS[1], borrow);
  364|  85.3M|        let (r2, borrow) = sbb(self.0[2], MODULUS[2], borrow);
  365|  85.3M|        let (r3, borrow) = sbb(self.0[3], MODULUS[3], borrow);
  366|  85.3M|        let (r4, borrow) = sbb(self.0[4], MODULUS[4], borrow);
  367|  85.3M|        let (r5, borrow) = sbb(self.0[5], MODULUS[5], borrow);
  368|       |
  369|       |        // If underflow occurred on the final limb, borrow = 0xfff...fff, otherwise
  370|       |        // borrow = 0x000...000. Thus, we use it as a mask!
  371|  85.3M|        let r0 = (self.0[0] & borrow) | (r0 & !borrow);
  372|  85.3M|        let r1 = (self.0[1] & borrow) | (r1 & !borrow);
  373|  85.3M|        let r2 = (self.0[2] & borrow) | (r2 & !borrow);
  374|  85.3M|        let r3 = (self.0[3] & borrow) | (r3 & !borrow);
  375|  85.3M|        let r4 = (self.0[4] & borrow) | (r4 & !borrow);
  376|  85.3M|        let r5 = (self.0[5] & borrow) | (r5 & !borrow);
  377|       |
  378|  85.3M|        Fp([r0, r1, r2, r3, r4, r5])
  379|  85.3M|    }
_RNvMs9_NtCsaKH4ngBG85u_9bls12_3812fpNtB5_2Fp11pow_vartime:
  309|  10.6k|    pub fn pow_vartime(&self, by: &[u64; 6]) -> Self {
  310|  10.6k|        let mut res = Self::one();
  311|  63.6k|        for e in by.iter().rev() {
  312|  4.07M|            for i in (0..64).rev() {
  313|  4.07M|                res = res.square();
  314|       |
  315|  4.07M|                if ((*e >> i) & 1) == 1 {
  316|  2.42M|                    res *= self;
  317|  2.42M|                }
  318|       |            }
  319|       |        }
  320|  10.6k|        res
  321|  10.6k|    }
_RNvMs9_NtCsaKH4ngBG85u_9bls12_3812fpNtB5_2Fp17montgomery_reduce:
  487|  29.3M|    pub(crate) const fn montgomery_reduce(
  488|  29.3M|        t0: u64,
  489|  29.3M|        t1: u64,
  490|  29.3M|        t2: u64,
  491|  29.3M|        t3: u64,
  492|  29.3M|        t4: u64,
  493|  29.3M|        t5: u64,
  494|  29.3M|        t6: u64,
  495|  29.3M|        t7: u64,
  496|  29.3M|        t8: u64,
  497|  29.3M|        t9: u64,
  498|  29.3M|        t10: u64,
  499|  29.3M|        t11: u64,
  500|  29.3M|    ) -> Self {
  501|       |        // The Montgomery reduction here is based on Algorithm 14.32 in
  502|       |        // Handbook of Applied Cryptography
  503|       |        // <http://cacr.uwaterloo.ca/hac/about/chap14.pdf>.
  504|       |
  505|  29.3M|        let k = t0.wrapping_mul(INV);
  506|  29.3M|        let (_, carry) = mac(t0, k, MODULUS[0], 0);
  507|  29.3M|        let (r1, carry) = mac(t1, k, MODULUS[1], carry);
  508|  29.3M|        let (r2, carry) = mac(t2, k, MODULUS[2], carry);
  509|  29.3M|        let (r3, carry) = mac(t3, k, MODULUS[3], carry);
  510|  29.3M|        let (r4, carry) = mac(t4, k, MODULUS[4], carry);
  511|  29.3M|        let (r5, carry) = mac(t5, k, MODULUS[5], carry);
  512|  29.3M|        let (r6, r7) = adc(t6, 0, carry);
  513|       |
  514|  29.3M|        let k = r1.wrapping_mul(INV);
  515|  29.3M|        let (_, carry) = mac(r1, k, MODULUS[0], 0);
  516|  29.3M|        let (r2, carry) = mac(r2, k, MODULUS[1], carry);
  517|  29.3M|        let (r3, carry) = mac(r3, k, MODULUS[2], carry);
  518|  29.3M|        let (r4, carry) = mac(r4, k, MODULUS[3], carry);
  519|  29.3M|        let (r5, carry) = mac(r5, k, MODULUS[4], carry);
  520|  29.3M|        let (r6, carry) = mac(r6, k, MODULUS[5], carry);
  521|  29.3M|        let (r7, r8) = adc(t7, r7, carry);
  522|       |
  523|  29.3M|        let k = r2.wrapping_mul(INV);
  524|  29.3M|        let (_, carry) = mac(r2, k, MODULUS[0], 0);
  525|  29.3M|        let (r3, carry) = mac(r3, k, MODULUS[1], carry);
  526|  29.3M|        let (r4, carry) = mac(r4, k, MODULUS[2], carry);
  527|  29.3M|        let (r5, carry) = mac(r5, k, MODULUS[3], carry);
  528|  29.3M|        let (r6, carry) = mac(r6, k, MODULUS[4], carry);
  529|  29.3M|        let (r7, carry) = mac(r7, k, MODULUS[5], carry);
  530|  29.3M|        let (r8, r9) = adc(t8, r8, carry);
  531|       |
  532|  29.3M|        let k = r3.wrapping_mul(INV);
  533|  29.3M|        let (_, carry) = mac(r3, k, MODULUS[0], 0);
  534|  29.3M|        let (r4, carry) = mac(r4, k, MODULUS[1], carry);
  535|  29.3M|        let (r5, carry) = mac(r5, k, MODULUS[2], carry);
  536|  29.3M|        let (r6, carry) = mac(r6, k, MODULUS[3], carry);
  537|  29.3M|        let (r7, carry) = mac(r7, k, MODULUS[4], carry);
  538|  29.3M|        let (r8, carry) = mac(r8, k, MODULUS[5], carry);
  539|  29.3M|        let (r9, r10) = adc(t9, r9, carry);
  540|       |
  541|  29.3M|        let k = r4.wrapping_mul(INV);
  542|  29.3M|        let (_, carry) = mac(r4, k, MODULUS[0], 0);
  543|  29.3M|        let (r5, carry) = mac(r5, k, MODULUS[1], carry);
  544|  29.3M|        let (r6, carry) = mac(r6, k, MODULUS[2], carry);
  545|  29.3M|        let (r7, carry) = mac(r7, k, MODULUS[3], carry);
  546|  29.3M|        let (r8, carry) = mac(r8, k, MODULUS[4], carry);
  547|  29.3M|        let (r9, carry) = mac(r9, k, MODULUS[5], carry);
  548|  29.3M|        let (r10, r11) = adc(t10, r10, carry);
  549|       |
  550|  29.3M|        let k = r5.wrapping_mul(INV);
  551|  29.3M|        let (_, carry) = mac(r5, k, MODULUS[0], 0);
  552|  29.3M|        let (r6, carry) = mac(r6, k, MODULUS[1], carry);
  553|  29.3M|        let (r7, carry) = mac(r7, k, MODULUS[2], carry);
  554|  29.3M|        let (r8, carry) = mac(r8, k, MODULUS[3], carry);
  555|  29.3M|        let (r9, carry) = mac(r9, k, MODULUS[4], carry);
  556|  29.3M|        let (r10, carry) = mac(r10, k, MODULUS[5], carry);
  557|  29.3M|        let (r11, _) = adc(t11, r11, carry);
  558|       |
  559|       |        // Attempt to subtract the modulus, to ensure the value
  560|       |        // is smaller than the modulus.
  561|  29.3M|        (&Fp([r6, r7, r8, r9, r10, r11])).subtract_p()
  562|  29.3M|    }
