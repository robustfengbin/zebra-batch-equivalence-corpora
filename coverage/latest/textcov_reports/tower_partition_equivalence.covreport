  353|  5.29M|        let r5 = (r5 << 1) | (r4 >> 63);
  354|  5.29M|        let r4 = (r4 << 1) | (r3 >> 63);
  355|  5.29M|        let r3 = (r3 << 1) | (r2 >> 63);
