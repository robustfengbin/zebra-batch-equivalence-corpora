  302|  6.66k|        res[0..8].copy_from_slice(&tmp.0[0].to_le_bytes());
  303|  6.66k|        res[8..16].copy_from_slice(&tmp.0[1].to_le_bytes());
  304|  6.66k|        res[16..24].copy_from_slice(&tmp.0[2].to_le_bytes());
  305|  6.66k|        res[24..32].copy_from_slice(&tmp.0[3].to_le_bytes());
  306|       |
  307|  6.66k|        res
  308|  6.66k|    }
