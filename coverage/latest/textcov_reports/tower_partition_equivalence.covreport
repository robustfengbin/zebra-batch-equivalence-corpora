  606|  1.25k|        let (r3, carry) = mac(r3, self.0[2], rhs.0[1], carry);
  607|  1.25k|        let (r4, carry) = mac(r4, self.0[2], rhs.0[2], carry);
  608|  1.25k|        let (r5, r6) = mac(r5, self.0[2], rhs.0[3], carry);
  609|       |
  610|  1.25k|        let (r3, carry) = mac(r3, self.0[3], rhs.0[0], 0);
  611|  1.25k|        let (r4, carry) = mac(r4, self.0[3], rhs.0[1], carry);
  612|  1.25k|        let (r5, carry) = mac(r5, self.0[3], rhs.0[2], carry);
