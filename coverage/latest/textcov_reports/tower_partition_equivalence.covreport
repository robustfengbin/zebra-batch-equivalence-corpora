  638|  1.76k|    pub const fn add(&self, rhs: &Self) -> Self {
  639|  1.76k|        let (d0, carry) = adc(self.0[0], rhs.0[0], 0);
  640|  1.76k|        let (d1, carry) = adc(self.0[1], rhs.0[1], carry);
  641|  1.76k|        let (d2, carry) = adc(self.0[2], rhs.0[2], carry);
  642|  1.76k|        let (d3, _) = adc(self.0[3], rhs.0[3], carry);
