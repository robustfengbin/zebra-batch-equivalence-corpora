  592|  36.8k|    pub const fn mul(&self, rhs: &Self) -> Self {
  593|       |        // Schoolbook multiplication
  594|       |
  595|  36.8k|        let (r0, carry) = mac(0, self.0[0], rhs.0[0], 0);
  596|  36.8k|        let (r1, carry) = mac(0, self.0[0], rhs.0[1], carry);
  597|  36.8k|        let (r2, carry) = mac(0, self.0[0], rhs.0[2], carry);
  598|  36.8k|        let (r3, r4) = mac(0, self.0[0], rhs.0[3], carry);
  599|       |
  600|  36.8k|        let (r1, carry) = mac(r1, self.0[1], rhs.0[0], 0);
  601|  36.8k|        let (r2, carry) = mac(r2, self.0[1], rhs.0[1], carry);
  602|  36.8k|        let (r3, carry) = mac(r3, self.0[1], rhs.0[2], carry);
  603|  36.8k|        let (r4, r5) = mac(r4, self.0[1], rhs.0[3], carry);
  604|       |
  605|  36.8k|        let (r2, carry) = mac(r2, self.0[2], rhs.0[0], 0);
  606|  36.8k|        let (r3, carry) = mac(r3, self.0[2], rhs.0[1], carry);
  607|  36.8k|        let (r4, carry) = mac(r4, self.0[2], rhs.0[2], carry);
  608|  36.8k|        let (r5, r6) = mac(r5, self.0[2], rhs.0[3], carry);
  609|       |
  610|  36.8k|        let (r3, carry) = mac(r3, self.0[3], rhs.0[0], 0);
  611|  36.8k|        let (r4, carry) = mac(r4, self.0[3], rhs.0[1], carry);
  612|  36.8k|        let (r5, carry) = mac(r5, self.0[3], rhs.0[2], carry);
  613|  36.8k|        let (r6, r7) = mac(r6, self.0[3], rhs.0[3], carry);
  614|       |
  615|  36.8k|        Fr::montgomery_reduce(r0, r1, r2, r3, r4, r5, r6, r7)
  616|  36.8k|    }
