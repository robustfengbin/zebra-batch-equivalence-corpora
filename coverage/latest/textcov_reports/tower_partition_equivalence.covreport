  357|  4.43k|    fn multiply(&self, by: &[u8; 32]) -> ExtendedPoint {
  358|  4.43k|        let zero = ExtendedNielsPoint::identity();
  359|       |
  360|  4.43k|        let mut acc = ExtendedPoint::identity();
  361|       |
  362|       |        // This is a simple double-and-add implementation of point
  363|       |        // multiplication, moving from most significant to least
  364|       |        // significant bit of the scalar.
  365|       |        //
  366|       |        // We skip the leading four bits because they're always
  367|       |        // unset for Fr.
  368|  1.11M|        for bit in by
  369|  4.43k|            .iter()
  370|  4.43k|            .rev()
  371|  4.43k|            .flat_map(|byte| (0..8).rev().map(move |i| Choice::from((byte >> i) & 1u8)))
  372|  4.43k|            .skip(4)
  373|  1.11M|        {
  374|  1.11M|            acc = acc.double();
  375|  1.11M|            acc += ExtendedNielsPoint::conditional_select(&zero, self, bit);
  376|  1.11M|        }
  377|       |
  378|  4.43k|        acc
  379|  4.43k|    }
