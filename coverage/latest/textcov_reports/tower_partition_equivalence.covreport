  600|  2.31M|    pub const fn add(&self, rhs: &Self) -> Self {
  601|  2.31M|        let (d0, carry) = adc(self.0[0], rhs.0[0], 0);
  602|  2.31M|        let (d1, carry) = adc(self.0[1], rhs.0[1], carry);
