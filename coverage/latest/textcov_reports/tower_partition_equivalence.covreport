  359|       |            // y-coordinate can be found) so long as the infinity flag
  360|       |            // was not set.
  361|       |            CtOption::new(
  362|       |                G1Affine::identity(),
  363|       |                infinity_flag_set & // Infinity flag should be set
  364|       |                compression_flag_set & // Compression flag should be set
