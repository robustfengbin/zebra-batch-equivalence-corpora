  296|  6.66k|    pub fn to_bytes(&self) -> [u8; 32] {
  297|       |        // Turn into canonical form by computing
  298|       |        // (a.R) / R = a
  299|  6.66k|        let tmp = Fr::montgomery_reduce(self.0[0], self.0[1], self.0[2], self.0[3], 0, 0, 0, 0);
  300|       |
