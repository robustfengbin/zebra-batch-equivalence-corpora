  928|  31.0k|        let b = (self.v + self.u) * other.v_minus_u;
  929|  31.0k|        let c = self.t1 * self.t2 * other.t2d;
  930|  31.0k|        let d = (self.z * other.z).double();
  931|       |
  932|  31.0k|        CompletedPoint {
  933|  31.0k|            u: b - a,
