  563|  3.54M|        let (r2, carry) = mac(r2, self.0[1], rhs.0[1], carry);
  564|  3.54M|        let (r3, carry) = mac(r3, self.0[1], rhs.0[2], carry);
  565|  3.54M|        let (r4, r5) = mac(r4, self.0[1], rhs.0[3], carry);
  566|       |
  567|  3.54M|        let (r2, carry) = mac(r2, self.0[2], rhs.0[0], 0);
  568|  3.54M|        let (r3, carry) = mac(r3, self.0[2], rhs.0[1], carry);
  569|  3.54M|        let (r4, carry) = mac(r4, self.0[2], rhs.0[2], carry);
  570|  3.54M|        let (r5, r6) = mac(r5, self.0[2], rhs.0[3], carry);
  571|       |
  572|  3.54M|        let (r3, carry) = mac(r3, self.0[3], rhs.0[0], 0);
  573|  3.54M|        let (r4, carry) = mac(r4, self.0[3], rhs.0[1], carry);
  574|  3.54M|        let (r5, carry) = mac(r5, self.0[3], rhs.0[2], carry);
