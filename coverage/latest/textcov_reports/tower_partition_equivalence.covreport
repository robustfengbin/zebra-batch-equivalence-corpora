  506|   101M|    const fn montgomery_reduce(
  507|   101M|        r0: u64,
  508|   101M|        r1: u64,
  509|   101M|        r2: u64,
  510|   101M|        r3: u64,
  511|   101M|        r4: u64,
  512|   101M|        r5: u64,
  513|   101M|        r6: u64,
  514|   101M|        r7: u64,
  515|   101M|    ) -> Self {
  516|       |        // The Montgomery reduction here is based on Algorithm 14.32 in
  517|       |        // Handbook of Applied Cryptography
  518|       |        // <http://cacr.uwaterloo.ca/hac/about/chap14.pdf>.
  519|       |
  520|   101M|        let k = r0.wrapping_mul(INV);
  521|   101M|        let (_, carry) = mac(r0, k, MODULUS.0[0], 0);
  522|   101M|        let (r1, carry) = mac(r1, k, MODULUS.0[1], carry);
  523|   101M|        let (r2, carry) = mac(r2, k, MODULUS.0[2], carry);
  524|   101M|        let (r3, carry) = mac(r3, k, MODULUS.0[3], carry);
  525|   101M|        let (r4, carry2) = adc(r4, 0, carry);
  526|       |
  527|   101M|        let k = r1.wrapping_mul(INV);
  528|   101M|        let (_, carry) = mac(r1, k, MODULUS.0[0], 0);
  529|   101M|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  530|   101M|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
  531|   101M|        let (r4, carry) = mac(r4, k, MODULUS.0[3], carry);
  532|   101M|        let (r5, carry2) = adc(r5, carry2, carry);
  533|       |
  534|   101M|        let k = r2.wrapping_mul(INV);
  535|   101M|        let (_, carry) = mac(r2, k, MODULUS.0[0], 0);
  536|   101M|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  537|   101M|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  538|   101M|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  539|   101M|        let (r6, carry2) = adc(r6, carry2, carry);
  540|       |
  541|   101M|        let k = r3.wrapping_mul(INV);
  542|   101M|        let (_, carry) = mac(r3, k, MODULUS.0[0], 0);
  543|   101M|        let (r4, carry) = mac(r4, k, MODULUS.0[1], carry);
  544|   101M|        let (r5, carry) = mac(r5, k, MODULUS.0[2], carry);
  545|   101M|        let (r6, carry) = mac(r6, k, MODULUS.0[3], carry);
  546|   101M|        let (r7, _) = adc(r7, carry2, carry);
  547|       |
  548|       |        // Result may be within MODULUS of the correct value
  549|   101M|        (&Scalar([r4, r5, r6, r7])).sub(&MODULUS)
  550|   101M|    }
