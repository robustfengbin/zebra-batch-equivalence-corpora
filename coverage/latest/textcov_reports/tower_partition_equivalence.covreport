  268|  14.0k|    pub fn from_bytes(bytes: &[u8; 32]) -> CtOption<Fr> {
  269|  14.0k|        let mut tmp = Fr([0, 0, 0, 0]);
  270|       |
  271|  14.0k|        tmp.0[0] = u64::from_le_bytes(bytes[0..8].try_into().unwrap());
  272|  14.0k|        tmp.0[1] = u64::from_le_bytes(bytes[8..16].try_into().unwrap());
  273|  14.0k|        tmp.0[2] = u64::from_le_bytes(bytes[16..24].try_into().unwrap());
  274|  14.0k|        tmp.0[3] = u64::from_le_bytes(bytes[24..32].try_into().unwrap());
  275|       |
  276|       |        // Try to subtract the modulus
  277|  14.0k|        let (_, borrow) = sbb(tmp.0[0], MODULUS.0[0], 0);
  278|  14.0k|        let (_, borrow) = sbb(tmp.0[1], MODULUS.0[1], borrow);
  279|  14.0k|        let (_, borrow) = sbb(tmp.0[2], MODULUS.0[2], borrow);
  280|  14.0k|        let (_, borrow) = sbb(tmp.0[3], MODULUS.0[3], borrow);
  281|       |
  282|       |        // If the element is smaller than MODULUS then the
  283|       |        // subtraction will underflow, producing a borrow value
  284|       |        // of 0xffff...ffff. Otherwise, it'll be zero.
  285|  14.0k|        let is_some = (borrow as u8) & 1;
  286|       |
  287|       |        // Convert to Montgomery form by computing
  288|       |        // (a.R^0 * R^2) / R = a.R
  289|  14.0k|        tmp *= &R2;
  290|       |
  291|  14.0k|        CtOption::new(tmp, Choice::from(is_some))
  292|  14.0k|    }
