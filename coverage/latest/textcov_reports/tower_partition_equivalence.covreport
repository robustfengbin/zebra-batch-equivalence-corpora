  777|  21.2k|    fn mul_by_x(&self) -> G1Projective {
  778|  21.2k|        let mut xself = G1Projective::identity();
  779|       |        // NOTE: in BLS12-381 we can just skip the first bit.
  780|  21.2k|        let mut x = crate::BLS_X >> 1;
  781|  21.2k|        let mut tmp = *self;
  782|  1.35M|        while x != 0 {
  783|  1.33M|            tmp = tmp.double();
  784|       |
  785|  1.33M|            if x % 2 == 1 {
  786|   127k|                xself += tmp;
  787|  1.20M|            }
  788|  1.33M|            x >>= 1;
  789|       |        }
  790|       |        // finally, flip the sign
  791|  21.2k|        if crate::BLS_X_IS_NEGATIVE {
  792|  21.2k|            xself = -xself;
  793|  21.2k|        }
  794|  21.2k|        xself
  795|  21.2k|    }
