  377|  1.10k|                INITIAL_STATE,
  378|  1.10k|                (INITIAL_STATE - REF_ONE) & !JOIN_INTEREST,
  379|  1.10k|                Release,
  380|  1.10k|                Relaxed,
  381|  1.10k|            )
  382|  1.10k|            .map(|_| ())
