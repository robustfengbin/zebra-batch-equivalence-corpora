  741|  34.9k|    pub fn add(&self, rhs: &G2Projective) -> G2Projective {
  742|       |        // Algorithm 7, https://eprint.iacr.org/2015/1060.pdf
  743|       |
  744|  34.9k|        let t0 = self.x * rhs.x;
