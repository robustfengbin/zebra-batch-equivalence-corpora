  594|       |
  595|  1.25k|        let (r0, carry) = mac(0, self.0[0], rhs.0[0], 0);
  596|  1.25k|        let (r1, carry) = mac(0, self.0[0], rhs.0[1], carry);
  597|  1.25k|        let (r2, carry) = mac(0, self.0[0], rhs.0[2], carry);
