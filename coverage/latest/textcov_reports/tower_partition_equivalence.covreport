  503|       |            // -u^2 - d.u^2.v^2 = 1 - v^2    (rearrange)
  504|       |            // u^2 + d.u^2.v^2 = v^2 - 1     (flip signs)
  505|       |            // u^2 (1 + d.v^2) = v^2 - 1     (factor)
  506|       |            // u^2 = (v^2 - 1) / (1 + d.v^2) (isolate u^2)
  507|       |            // We know that (1 + d.v^2) is nonzero for all v:
  508|       |            //   (1 + d.v^2) = 0
