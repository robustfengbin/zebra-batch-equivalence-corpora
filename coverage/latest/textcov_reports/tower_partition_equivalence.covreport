  620|  13.9k|    pub const fn sub(&self, rhs: &Self) -> Self {
  621|  13.9k|        let (d0, borrow) = sbb(self.0[0], rhs.0[0], 0);
  622|  13.9k|        let (d1, borrow) = sbb(self.0[1], rhs.0[1], borrow);
  623|  13.9k|        let (d2, borrow) = sbb(self.0[2], rhs.0[2], borrow);
  624|  13.9k|        let (d3, borrow) = sbb(self.0[3], rhs.0[3], borrow);
