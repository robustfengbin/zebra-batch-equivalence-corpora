  406|   129M|        let mask = (((self.0[0] | self.0[1] | self.0[2] | self.0[3] | self.0[4] | self.0[5]) == 0)
  407|   129M|            as u64)
  408|   129M|            .wrapping_sub(1);
  409|       |
