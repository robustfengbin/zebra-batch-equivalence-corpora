  582|  4.10M|    pub const fn sub(&self, rhs: &Self) -> Self {
  583|  4.10M|        let (d0, borrow) = sbb(self.0[0], rhs.0[0], 0);
  584|  4.10M|        let (d1, borrow) = sbb(self.0[1], rhs.0[1], borrow);
  585|  4.10M|        let (d2, borrow) = sbb(self.0[2], rhs.0[2], borrow);
  586|  4.10M|        let (d3, borrow) = sbb(self.0[3], rhs.0[3], borrow);
