  361|   707M|    const fn subtract_p(&self) -> Fp {
  362|   707M|        let (r0, borrow) = sbb(self.0[0], MODULUS[0], 0);
  363|   707M|        let (r1, borrow) = sbb(self.0[1], MODULUS[1], borrow);
  364|   707M|        let (r2, borrow) = sbb(self.0[2], MODULUS[2], borrow);
  365|   707M|        let (r3, borrow) = sbb(self.0[3], MODULUS[3], borrow);
  366|   707M|        let (r4, borrow) = sbb(self.0[4], MODULUS[4], borrow);
  367|   707M|        let (r5, borrow) = sbb(self.0[5], MODULUS[5], borrow);
  368|       |
  369|       |        // If underflow occurred on the final limb, borrow = 0xfff...fff, otherwise
  370|       |        // borrow = 0x000...000. Thus, we use it as a mask!
  371|   707M|        let r0 = (self.0[0] & borrow) | (r0 & !borrow);
  372|   707M|        let r1 = (self.0[1] & borrow) | (r1 & !borrow);
  373|   707M|        let r2 = (self.0[2] & borrow) | (r2 & !borrow);
  374|   707M|        let r3 = (self.0[3] & borrow) | (r3 & !borrow);
  375|   707M|        let r4 = (self.0[4] & borrow) | (r4 & !borrow);
  376|   707M|        let r5 = (self.0[5] & borrow) | (r5 & !borrow);
  377|       |
  378|   707M|        Fp([r0, r1, r2, r3, r4, r5])
  379|   707M|    }
