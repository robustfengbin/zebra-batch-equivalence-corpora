  578|   174M|        let (t6, t7) = mac(t6, self.0[1], rhs.0[5], carry);
  579|       |
  580|   174M|        let (t2, carry) = mac(t2, self.0[2], rhs.0[0], 0);
  581|   174M|        let (t3, carry) = mac(t3, self.0[2], rhs.0[1], carry);
  582|   174M|        let (t4, carry) = mac(t4, self.0[2], rhs.0[2], carry);
  583|   174M|        let (t5, carry) = mac(t5, self.0[2], rhs.0[3], carry);
  584|   174M|        let (t6, carry) = mac(t6, self.0[2], rhs.0[4], carry);
  585|   174M|        let (t7, t8) = mac(t7, self.0[2], rhs.0[5], carry);
  586|       |
  587|   174M|        let (t3, carry) = mac(t3, self.0[3], rhs.0[0], 0);
  588|   174M|        let (t4, carry) = mac(t4, self.0[3], rhs.0[1], carry);
  589|   174M|        let (t5, carry) = mac(t5, self.0[3], rhs.0[2], carry);
