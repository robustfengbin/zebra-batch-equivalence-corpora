  696|   692k|fn ell(f: Fp12, coeffs: &(Fp2, Fp2, Fp2), p: &G1Affine) -> Fp12 {
  697|   692k|    let mut c0 = coeffs.0;
  698|   692k|    let mut c1 = coeffs.1;
  699|       |
