  387|   461M|        let (d4, carry) = adc(self.0[4], rhs.0[4], carry);
  388|   461M|        let (d5, _) = adc(self.0[5], rhs.0[5], carry);
  389|       |
  390|       |        // Attempt to subtract the modulus, to ensure the value
  391|       |        // is smaller than the modulus.
  392|   461M|        (&Fp([d0, d1, d2, d3, d4, d5])).subtract_p()
  393|   461M|    }
_RNvMs9_NtCsaKH4ngBG85u_9bls12_3812fpNtB5_2Fp3mulB7_:
  565|   166M|    pub const fn mul(&self, rhs: &Fp) -> Fp {
  566|   166M|        let (t0, carry) = mac(0, self.0[0], rhs.0[0], 0);
