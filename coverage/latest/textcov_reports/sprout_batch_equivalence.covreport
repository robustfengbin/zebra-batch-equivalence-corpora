  709|   642k|fn doubling_step(r: &mut G2Projective) -> (Fp2, Fp2, Fp2) {
  710|       |    // Adaptation of Algorithm 26, https://eprint.iacr.org/2010/354.pdf
  711|   642k|    let tmp0 = r.x.square();
  712|   642k|    let tmp1 = r.y.square();
  713|   642k|    let tmp2 = tmp1.square();
  714|   642k|    let tmp3 = (tmp1 + r.x).square() - tmp0 - tmp2;
  715|   642k|    let tmp3 = tmp3 + tmp3;
  716|   642k|    let tmp4 = tmp0 + tmp0 + tmp0;
  717|   642k|    let tmp6 = r.x + tmp4;
  718|   642k|    let tmp5 = tmp4.square();
  719|   642k|    let zsquared = r.z.square();
  720|   642k|    r.x = tmp5 - tmp3 - tmp3;
  721|   642k|    r.z = (r.z + r.y).square() - tmp1 - zsquared;
  722|   642k|    r.y = (tmp3 - r.x) * tmp4;
  723|   642k|    let tmp2 = tmp2 + tmp2;
  724|   642k|    let tmp2 = tmp2 + tmp2;
  725|   642k|    let tmp2 = tmp2 + tmp2;
  726|   642k|    r.y -= tmp2;
  727|   642k|    let tmp3 = tmp4 * zsquared;
  728|   642k|    let tmp3 = tmp3 + tmp3;
  729|   642k|    let tmp3 = -tmp3;
  730|   642k|    let tmp6 = tmp6.square() - tmp0 - tmp5;
  731|   642k|    let tmp1 = tmp1 + tmp1;
  732|   642k|    let tmp1 = tmp1 + tmp1;
  733|   642k|    let tmp6 = tmp6 - tmp1;
  734|   642k|    let tmp0 = r.z * zsquared;
  735|   642k|    let tmp0 = tmp0 + tmp0;
  736|       |
  737|   642k|    (tmp0, tmp3, tmp6)
  738|   642k|}
