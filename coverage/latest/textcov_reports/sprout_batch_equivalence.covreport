  741|  8.04k|    pub fn add(&self, rhs: &G2Projective) -> G2Projective {
  742|       |        // Algorithm 7, https://eprint.iacr.org/2015/1060.pdf
  743|       |
  744|  8.04k|        let t0 = self.x * rhs.x;
  745|  8.04k|        let t1 = self.y * rhs.y;
  746|  8.04k|        let t2 = self.z * rhs.z;
  747|  8.04k|        let t3 = self.x + self.y;
  748|  8.04k|        let t4 = rhs.x + rhs.y;
  749|  8.04k|        let t3 = t3 * t4;
  750|  8.04k|        let t4 = t0 + t1;
  751|  8.04k|        let t3 = t3 - t4;
  752|  8.04k|        let t4 = self.y + self.z;
  753|  8.04k|        let x3 = rhs.y + rhs.z;
  754|  8.04k|        let t4 = t4 * x3;
  755|  8.04k|        let x3 = t1 + t2;
  756|  8.04k|        let t4 = t4 - x3;
  757|  8.04k|        let x3 = self.x + self.z;
  758|  8.04k|        let y3 = rhs.x + rhs.z;
  759|  8.04k|        let x3 = x3 * y3;
  760|  8.04k|        let y3 = t0 + t2;
  761|  8.04k|        let y3 = x3 - y3;
  762|  8.04k|        let x3 = t0 + t0;
  763|  8.04k|        let t0 = x3 + t0;
  764|  8.04k|        let t2 = mul_by_3b(t2);
  765|  8.04k|        let z3 = t1 + t2;
  766|  8.04k|        let t1 = t1 - t2;
  767|  8.04k|        let y3 = mul_by_3b(y3);
  768|  8.04k|        let x3 = t4 * y3;
  769|  8.04k|        let t2 = t3 * t1;
  770|  8.04k|        let x3 = t2 - x3;
  771|  8.04k|        let y3 = y3 * t0;
  772|  8.04k|        let t1 = t1 * z3;
  773|  8.04k|        let y3 = t1 + y3;
  774|  8.04k|        let t0 = t0 * t3;
  775|  8.04k|        let z3 = z3 * t4;
  776|  8.04k|        let z3 = z3 + t0;
