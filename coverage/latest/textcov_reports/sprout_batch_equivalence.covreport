  409|  1.37k|            let mut tmp = [0; 48];
  410|  1.37k|            tmp.copy_from_slice(&bytes[0..48]);
  411|       |
  412|       |            // Mask away the flag bits
  413|  1.37k|            tmp[0] &= 0b0001_1111;
  414|       |
  415|  1.37k|            Fp::from_bytes(&tmp)
