  219|  12.7M|            c0: Fp::sum_of_products([self.c0, -self.c1], [rhs.c0, rhs.c1]),
  220|  12.7M|            c1: Fp::sum_of_products([self.c0, self.c1], [rhs.c1, rhs.c0]),
  221|  12.7M|        }
  222|  12.7M|    }
