  638|      2|    let q = G2Affine::conditional_select(q, &G2Affine::generator(), either_identity);
  639|       |
  640|      2|    let mut adder = Adder {
  641|      2|        cur: G2Projective::from(q),
  642|      2|        base: q,
  643|      2|        p,
