  473|       |                let (r3, carry) = mac(t3, k, MODULUS[3], carry);
  474|       |                let (r4, carry) = mac(t4, k, MODULUS[4], carry);
  475|       |                let (r5, carry) = mac(t5, k, MODULUS[5], carry);
