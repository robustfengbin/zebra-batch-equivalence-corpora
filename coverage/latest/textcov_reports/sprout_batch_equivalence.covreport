  490|  2.97k|        let other_is_zero = other.z.is_zero();
  491|       |
  492|  2.97k|        (self_is_zero & other_is_zero) // Both point at infinity
  493|  2.97k|            | ((!self_is_zero) & (!other_is_zero) & x1.ct_eq(&x2) & y1.ct_eq(&y2))
  494|       |        // Neither point at infinity, coordinates are the same
  495|  2.97k|    }
