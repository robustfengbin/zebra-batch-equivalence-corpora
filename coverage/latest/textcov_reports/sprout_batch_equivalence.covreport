  507|   187M|        let (r1, carry) = mac(t1, k, MODULUS[1], carry);
  508|   187M|        let (r2, carry) = mac(t2, k, MODULUS[2], carry);
  509|   187M|        let (r3, carry) = mac(t3, k, MODULUS[3], carry);
