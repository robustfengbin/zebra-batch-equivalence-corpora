  638|  8.13M|    pub fn double(&self) -> G1Projective {
  639|       |        // Algorithm 9, https://eprint.iacr.org/2015/1060.pdf
  640|       |
  641|  8.13M|        let t0 = self.y.square();
  642|  8.13M|        let z3 = t0 + t0;
  643|  8.13M|        let z3 = z3 + z3;
  644|  8.13M|        let z3 = z3 + z3;
  645|  8.13M|        let t1 = self.y * self.z;
  646|  8.13M|        let t2 = self.z.square();
  647|  8.13M|        let t2 = mul_by_3b(t2);
  648|  8.13M|        let x3 = t2 * z3;
  649|  8.13M|        let y3 = t0 + t2;
  650|  8.13M|        let z3 = t1 * z3;
  651|  8.13M|        let t1 = t2 + t2;
  652|  8.13M|        let t2 = t1 + t2;
  653|  8.13M|        let t0 = t0 - t2;
  654|  8.13M|        let y3 = t0 * y3;
  655|  8.13M|        let y3 = x3 + y3;
  656|  8.13M|        let t1 = self.x * self.y;
  657|  8.13M|        let x3 = t0 * t1;
  658|  8.13M|        let x3 = x3 + x3;
  659|       |
  660|  8.13M|        let tmp = G1Projective {
  661|  8.13M|            x: x3,
  662|  8.13M|            y: y3,
  663|  8.13M|            z: z3,
  664|  8.13M|        };
  665|       |
  666|  8.13M|        G1Projective::conditional_select(&tmp, &G1Projective::identity(), self.is_identity())
  667|  8.13M|    }
