  506|   602k|    const fn montgomery_reduce(
  507|   602k|        r0: u64,
  508|   602k|        r1: u64,
  509|   602k|        r2: u64,
  510|   602k|        r3: u64,
  511|   602k|        r4: u64,
  512|   602k|        r5: u64,
  513|   602k|        r6: u64,
  514|   602k|        r7: u64,
  515|   602k|    ) -> Self {
  516|       |        // The Montgomery reduction here is based on Algorithm 14.32 in
  517|       |        // Handbook of Applied Cryptography
  518|       |        // <http://cacr.uwaterloo.ca/hac/about/chap14.pdf>.
  519|       |
  520|   602k|        let k = r0.wrapping_mul(INV);
  521|   602k|        let (_, carry) = mac(r0, k, MODULUS.0[0], 0);
  522|   602k|        let (r1, carry) = mac(r1, k, MODULUS.0[1], carry);
  523|   602k|        let (r2, carry) = mac(r2, k, MODULUS.0[2], carry);
  524|   602k|        let (r3, carry) = mac(r3, k, MODULUS.0[3], carry);
  525|   602k|        let (r4, carry2) = adc(r4, 0, carry);
  526|       |
  527|   602k|        let k = r1.wrapping_mul(INV);
  528|   602k|        let (_, carry) = mac(r1, k, MODULUS.0[0], 0);
  529|   602k|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  530|   602k|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
  531|   602k|        let (r4, carry) = mac(r4, k, MODULUS.0[3], carry);
  532|   602k|        let (r5, carry2) = adc(r5, carry2, carry);
  533|       |
  534|   602k|        let k = r2.wrapping_mul(INV);
  535|   602k|        let (_, carry) = mac(r2, k, MODULUS.0[0], 0);
  536|   602k|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  537|   602k|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  538|   602k|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  539|   602k|        let (r6, carry2) = adc(r6, carry2, carry);
  540|       |
  541|   602k|        let k = r3.wrapping_mul(INV);
  542|   602k|        let (_, carry) = mac(r3, k, MODULUS.0[0], 0);
  543|   602k|        let (r4, carry) = mac(r4, k, MODULUS.0[1], carry);
  544|   602k|        let (r5, carry) = mac(r5, k, MODULUS.0[2], carry);
  545|   602k|        let (r6, carry) = mac(r6, k, MODULUS.0[3], carry);
  546|   602k|        let (r7, _) = adc(r7, carry2, carry);
  547|       |
  548|       |        // Result may be within MODULUS of the correct value
  549|   602k|        (&Scalar([r4, r5, r6, r7])).sub(&MODULUS)
  550|   602k|    }
