_RNvMsu_NtCsaKH4ngBG85u_9bls12_3812g2NtB5_12G2Projective6double:
  709|  87.0k|    pub fn double(&self) -> G2Projective {
  710|       |        // Algorithm 9, https://eprint.iacr.org/2015/1060.pdf
  711|       |
  712|  87.0k|        let t0 = self.y.square();
  713|  87.0k|        let z3 = t0 + t0;
  714|  87.0k|        let z3 = z3 + z3;
  715|  87.0k|        let z3 = z3 + z3;
  716|  87.0k|        let t1 = self.y * self.z;
  717|  87.0k|        let t2 = self.z.square();
  718|  87.0k|        let t2 = mul_by_3b(t2);
  719|  87.0k|        let x3 = t2 * z3;
  720|  87.0k|        let y3 = t0 + t2;
  721|  87.0k|        let z3 = t1 * z3;
  722|  87.0k|        let t1 = t2 + t2;
  723|  87.0k|        let t2 = t1 + t2;
  724|  87.0k|        let t0 = t0 - t2;
  725|  87.0k|        let y3 = t0 * y3;
  726|  87.0k|        let y3 = x3 + y3;
  727|  87.0k|        let t1 = self.x * self.y;
  728|  87.0k|        let x3 = t0 * t1;
  729|  87.0k|        let x3 = x3 + x3;
  730|       |
  731|  87.0k|        let tmp = G2Projective {
  732|  87.0k|            x: x3,
  733|  87.0k|            y: y3,
  734|  87.0k|            z: z3,
  735|  87.0k|        };
  736|       |
  737|  87.0k|        G2Projective::conditional_select(&tmp, &G2Projective::identity(), self.is_identity())
  738|  87.0k|    }
