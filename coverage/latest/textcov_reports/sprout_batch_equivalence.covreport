  645|       |
  646|      2|    let tmp = miller_loop(&mut adder);
  647|      2|    let tmp = MillerLoopResult(Fp12::conditional_select(
  648|      2|        &tmp,
  649|      2|        &Fp12::one(),
  650|      2|        either_identity,
  651|      2|    ));
  652|      2|    tmp.final_exponentiation()
  653|      2|}
