  849|  1.38k|        let psi_coeff_x = Fp2 {
  850|  1.38k|            c0: Fp::zero(),
  851|  1.38k|            c1: Fp::from_raw_unchecked([
  852|  1.38k|                0x890dc9e4867545c3,
