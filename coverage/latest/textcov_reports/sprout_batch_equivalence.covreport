 2422|     83|const fn cycle_to_yo(cycle: u32) -> (u32, u32) {
 2423|     83|    let mut year_mod_400 = cycle / 365;
 2424|     83|    let mut ordinal0 = cycle % 365;
 2425|     83|    let delta = YEAR_DELTAS[year_mod_400 as usize] as u32;
 2426|     83|    if ordinal0 < delta {
 2427|      5|        year_mod_400 -= 1;
 2428|      5|        ordinal0 += 365 - YEAR_DELTAS[year_mod_400 as usize] as u32;
 2429|     78|    } else {
 2430|     78|        ordinal0 -= delta;
 2431|     78|    }
 2432|     83|    (year_mod_400, ordinal0 + 1)
 2433|     83|}

