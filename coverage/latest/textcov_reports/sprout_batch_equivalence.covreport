  332|  2.80k|            0x07aa_ffff_ac54_ffff,
  333|  2.80k|            0xd9cc_34a8_3dac_3d89,
  334|  2.80k|            0xd91d_d2e1_3ce1_44af,
  335|  2.80k|            0x92c6_e9ed_90d2_eb35,
  336|  2.80k|            0x0680_447a_8e5f_f9a6,
  337|  2.80k|        ]);
  338|       |
  339|  2.80k|        CtOption::new(sqrt, sqrt.square().ct_eq(self))
  340|  2.80k|    }
