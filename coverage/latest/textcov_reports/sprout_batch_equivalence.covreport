_RNvMsu_NtCsaKH4ngBG85u_9bls12_3812g1NtB5_12G1Projective8mul_by_x:
  777|  5.94k|    fn mul_by_x(&self) -> G1Projective {
  778|  5.94k|        let mut xself = G1Projective::identity();
  779|       |        // NOTE: in BLS12-381 we can just skip the first bit.
  780|  5.94k|        let mut x = crate::BLS_X >> 1;
  781|  5.94k|        let mut tmp = *self;
  782|   380k|        while x != 0 {
  783|   374k|            tmp = tmp.double();
  784|       |
  785|   374k|            if x % 2 == 1 {
  786|  35.6k|                xself += tmp;
  787|   338k|            }
  788|   374k|            x >>= 1;
  789|       |        }
  790|       |        // finally, flip the sign
  791|  5.94k|        if crate::BLS_X_IS_NEGATIVE {
  792|  5.94k|            xself = -xself;
  793|  5.94k|        }
  794|  5.94k|        xself
  795|  5.94k|    }
_RNvMsu_NtCsaKH4ngBG85u_9bls12_3812g1NtB5_12G1Projective8multiply:
  754|  30.4k|    fn multiply(&self, by: &[u8; 32]) -> G1Projective {
  755|  30.4k|        let mut acc = G1Projective::identity();
  756|       |
  757|       |        // This is a simple double-and-add implementation of point
  758|       |        // multiplication, moving from most significant to least
  759|       |        // significant bit of the scalar.
  760|       |        //
  761|       |        // We skip the leading bit because it's always unset for Fq
  762|       |        // elements.
  763|  7.76M|        for bit in by
  764|  30.4k|            .iter()
  765|  30.4k|            .rev()
  766|  30.4k|            .flat_map(|byte| (0..8).rev().map(move |i| Choice::from((byte >> i) & 1u8)))
  767|  30.4k|            .skip(1)
  768|  7.76M|        {
  769|  7.76M|            acc = acc.double();
  770|  7.76M|            acc = G1Projective::conditional_select(&acc, &(acc + self), bit);
  771|  7.76M|        }
  772|       |
  773|  30.4k|        acc
  774|  30.4k|    }
_RNvNtCsaKH4ngBG85u_9bls12_3812g112endomorphism:
  430|  2.97k|fn endomorphism(p: &G1Affine) -> G1Affine {
  431|       |    // Endomorphism of the points on the curve.
  432|       |    // endomorphism_p(x,y) = (BETA * x, y)
  433|       |    // where BETA is a non-trivial cubic root of unity in Fq.
  434|  2.97k|    let mut res = *p;
  435|  2.97k|    res.x *= BETA;
  436|  2.97k|    res
