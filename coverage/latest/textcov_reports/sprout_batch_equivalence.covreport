  514|   187M|        let k = r1.wrapping_mul(INV);
  515|   187M|        let (_, carry) = mac(r1, k, MODULUS[0], 0);
  516|   187M|        let (r2, carry) = mac(r2, k, MODULUS[1], carry);
  517|   187M|        let (r3, carry) = mac(r3, k, MODULUS[2], carry);
  518|   187M|        let (r4, carry) = mac(r4, k, MODULUS[3], carry);
  519|   187M|        let (r5, carry) = mac(r5, k, MODULUS[4], carry);
  520|   187M|        let (r6, carry) = mac(r6, k, MODULUS[5], carry);
  521|   187M|        let (r7, r8) = adc(t7, r7, carry);
  522|       |
  523|   187M|        let k = r2.wrapping_mul(INV);
  524|   187M|        let (_, carry) = mac(r2, k, MODULUS[0], 0);
  525|   187M|        let (r3, carry) = mac(r3, k, MODULUS[1], carry);
  526|   187M|        let (r4, carry) = mac(r4, k, MODULUS[2], carry);
  527|   187M|        let (r5, carry) = mac(r5, k, MODULUS[3], carry);
  528|   187M|        let (r6, carry) = mac(r6, k, MODULUS[4], carry);
  529|   187M|        let (r7, carry) = mac(r7, k, MODULUS[5], carry);
  530|   187M|        let (r8, r9) = adc(t8, r8, carry);
  531|       |
  532|   187M|        let k = r3.wrapping_mul(INV);
  533|   187M|        let (_, carry) = mac(r3, k, MODULUS[0], 0);
  534|   187M|        let (r4, carry) = mac(r4, k, MODULUS[1], carry);
  535|   187M|        let (r5, carry) = mac(r5, k, MODULUS[2], carry);
  536|   187M|        let (r6, carry) = mac(r6, k, MODULUS[3], carry);
  537|   187M|        let (r7, carry) = mac(r7, k, MODULUS[4], carry);
  538|   187M|        let (r8, carry) = mac(r8, k, MODULUS[5], carry);
  539|   187M|        let (r9, r10) = adc(t9, r9, carry);
  540|       |
  541|   187M|        let k = r4.wrapping_mul(INV);
  542|   187M|        let (_, carry) = mac(r4, k, MODULUS[0], 0);
  543|   187M|        let (r5, carry) = mac(r5, k, MODULUS[1], carry);
  544|   187M|        let (r6, carry) = mac(r6, k, MODULUS[2], carry);
  545|   187M|        let (r7, carry) = mac(r7, k, MODULUS[3], carry);
  546|   187M|        let (r8, carry) = mac(r8, k, MODULUS[4], carry);
  547|   187M|        let (r9, carry) = mac(r9, k, MODULUS[5], carry);
  548|   187M|        let (r10, r11) = adc(t10, r10, carry);
  549|       |
  550|   187M|        let k = r5.wrapping_mul(INV);
  551|   187M|        let (_, carry) = mac(r5, k, MODULUS[0], 0);
  552|   187M|        let (r6, carry) = mac(r6, k, MODULUS[1], carry);
  553|   187M|        let (r7, carry) = mac(r7, k, MODULUS[2], carry);
  554|   187M|        let (r8, carry) = mac(r8, k, MODULUS[3], carry);
  555|   187M|        let (r9, carry) = mac(r9, k, MODULUS[4], carry);
  556|   187M|        let (r10, carry) = mac(r10, k, MODULUS[5], carry);
  557|   187M|        let (r11, _) = adc(t11, r11, carry);
  558|       |
  559|       |        // Attempt to subtract the modulus, to ensure the value
  560|       |        // is smaller than the modulus.
  561|   187M|        (&Fp([r6, r7, r8, r9, r10, r11])).subtract_p()
  562|   187M|    }
