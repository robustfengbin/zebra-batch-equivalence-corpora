  164|    105|pub fn check_equivalence_refs<V: BatchVerifier>(
  165|    105|    items: &[&V::Item],
  166|    105|    ctx: &V::Context,
  167|    105|    seed: u64,
  168|    105|) -> EquivReport {
  169|       |    // `all` short-circuits on the first reject, mirroring the production
  170|       |    // fallback's early exit.
  171|    105|    let single_all = items.iter().all(|item| V::validate_one(item, ctx, seed));
