  401|  1.37k|    pub fn from_compressed_unchecked(bytes: &[u8; 96]) -> CtOption<Self> {
  402|       |        // Obtain the three flags from the start of the byte sequence
  403|  1.37k|        let compression_flag_set = Choice::from((bytes[0] >> 7) & 1);
  404|  1.37k|        let infinity_flag_set = Choice::from((bytes[0] >> 6) & 1);
