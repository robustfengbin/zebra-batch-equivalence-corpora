  382|   482M|    pub const fn add(&self, rhs: &Fp) -> Fp {
  383|   482M|        let (d0, carry) = adc(self.0[0], rhs.0[0], 0);
  384|   482M|        let (d1, carry) = adc(self.0[1], rhs.0[1], carry);
  385|   482M|        let (d2, carry) = adc(self.0[2], rhs.0[2], carry);
  386|   482M|        let (d3, carry) = adc(self.0[3], rhs.0[3], carry);
  387|   482M|        let (d4, carry) = adc(self.0[4], rhs.0[4], carry);
  388|   482M|        let (d5, _) = adc(self.0[5], rhs.0[5], carry);
  389|       |
  390|       |        // Attempt to subtract the modulus, to ensure the value
  391|       |        // is smaller than the modulus.
  392|   482M|        (&Fp([d0, d1, d2, d3, d4, d5])).subtract_p()
  393|   482M|    }
