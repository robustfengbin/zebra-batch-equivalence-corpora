  670|  7.47M|    pub fn add(&self, rhs: &G1Projective) -> G1Projective {
  671|       |        // Algorithm 7, https://eprint.iacr.org/2015/1060.pdf
  672|       |
  673|  7.47M|        let t0 = self.x * rhs.x;
  674|  7.47M|        let t1 = self.y * rhs.y;
  675|  7.47M|        let t2 = self.z * rhs.z;
  676|  7.47M|        let t3 = self.x + self.y;
  677|  7.47M|        let t4 = rhs.x + rhs.y;
  678|  7.47M|        let t3 = t3 * t4;
  679|  7.47M|        let t4 = t0 + t1;
  680|  7.47M|        let t3 = t3 - t4;
  681|  7.47M|        let t4 = self.y + self.z;
  682|  7.47M|        let x3 = rhs.y + rhs.z;
  683|  7.47M|        let t4 = t4 * x3;
  684|  7.47M|        let x3 = t1 + t2;
  685|  7.47M|        let t4 = t4 - x3;
  686|  7.47M|        let x3 = self.x + self.z;
  687|  7.47M|        let y3 = rhs.x + rhs.z;
  688|  7.47M|        let x3 = x3 * y3;
  689|  7.47M|        let y3 = t0 + t2;
  690|  7.47M|        let y3 = x3 - y3;
  691|  7.47M|        let x3 = t0 + t0;
  692|  7.47M|        let t0 = x3 + t0;
  693|  7.47M|        let t2 = mul_by_3b(t2);
  694|  7.47M|        let z3 = t1 + t2;
  695|  7.47M|        let t1 = t1 - t2;
  696|  7.47M|        let y3 = mul_by_3b(y3);
  697|  7.47M|        let x3 = t4 * y3;
  698|  7.47M|        let t2 = t3 * t1;
  699|  7.47M|        let x3 = t2 - x3;
  700|  7.47M|        let y3 = y3 * t0;
  701|  7.47M|        let t1 = t1 * z3;
  702|  7.47M|        let y3 = t1 + y3;
  703|  7.47M|        let t0 = t0 * t3;
  704|  7.47M|        let z3 = z3 * t4;
  705|  7.47M|        let z3 = z3 + t0;
  706|       |
  707|  7.47M|        G1Projective {
  708|  7.47M|            x: x3,
  709|  7.47M|            y: y3,
  710|  7.47M|            z: z3,
  711|  7.47M|        }
  712|  7.47M|    }
