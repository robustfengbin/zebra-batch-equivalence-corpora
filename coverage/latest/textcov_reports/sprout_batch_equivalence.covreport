 2424|     48|    let mut ordinal0 = cycle % 365;
 2425|     48|    let delta = YEAR_DELTAS[year_mod_400 as usize] as u32;
 2426|     48|    if ordinal0 < delta {
 2427|      3|        year_mod_400 -= 1;
 2428|      3|        ordinal0 += 365 - YEAR_DELTAS[year_mod_400 as usize] as u32;
 2429|     45|    } else {
 2430|     45|        ordinal0 -= delta;
 2431|     45|    }
 2432|     48|    (year_mod_400, ordinal0 + 1)
 2433|     48|}

