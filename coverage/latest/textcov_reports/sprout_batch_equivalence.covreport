  701|   692k|    c0.c1 *= p.y;
  702|       |
  703|   692k|    c1.c0 *= p.x;
  704|   692k|    c1.c1 *= p.x;
  705|       |
  706|   692k|    f.mul_by_014(&coeffs.2, &c1, &c0)
  707|   692k|}
