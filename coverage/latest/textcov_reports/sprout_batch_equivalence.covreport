  630|  22.1M|        let (t8, t9) = mac(t8, self.0[3], self.0[5], carry);
  631|       |
  632|  22.1M|        let (t9, t10) = mac(t9, self.0[4], self.0[5], 0);
  633|       |
  634|  22.1M|        let t11 = t10 >> 63;
  635|  22.1M|        let t10 = (t10 << 1) | (t9 >> 63);
  636|  22.1M|        let t9 = (t9 << 1) | (t8 >> 63);
  637|  22.1M|        let t8 = (t8 << 1) | (t7 >> 63);
  638|  22.1M|        let t7 = (t7 << 1) | (t6 >> 63);
  639|  22.1M|        let t6 = (t6 << 1) | (t5 >> 63);
  640|  22.1M|        let t5 = (t5 << 1) | (t4 >> 63);
  641|  22.1M|        let t4 = (t4 << 1) | (t3 >> 63);
  642|  22.1M|        let t3 = (t3 << 1) | (t2 >> 63);
  643|  22.1M|        let t2 = (t2 << 1) | (t1 >> 63);
  644|  22.1M|        let t1 = t1 << 1;
