  655|  21.1M|        let (t9, carry) = adc(t9, 0, carry);
  656|  21.1M|        let (t10, carry) = mac(t10, self.0[5], self.0[5], carry);
  657|  21.1M|        let (t11, _) = adc(t11, 0, carry);
  658|       |
