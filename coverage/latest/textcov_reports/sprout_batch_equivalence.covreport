  309|  15.1k|    pub fn pow_vartime(&self, by: &[u64; 6]) -> Self {
  310|  15.1k|        let mut res = Self::one();
  311|  90.9k|        for e in by.iter().rev() {
  312|  5.81M|            for i in (0..64).rev() {
  313|  5.81M|                res = res.square();
  314|       |
  315|  5.81M|                if ((*e >> i) & 1) == 1 {
  316|  3.46M|                    res *= self;
  317|  3.46M|                }
  318|       |            }
  319|       |        }
  320|  15.1k|        res
  321|  15.1k|    }
