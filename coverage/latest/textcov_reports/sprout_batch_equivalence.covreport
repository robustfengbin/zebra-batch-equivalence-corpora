  499|   187M|        t11: u64,
  500|   187M|    ) -> Self {
  501|       |        // The Montgomery reduction here is based on Algorithm 14.32 in
  502|       |        // Handbook of Applied Cryptography
  503|       |        // <http://cacr.uwaterloo.ca/hac/about/chap14.pdf>.
  504|       |
  505|   187M|        let k = t0.wrapping_mul(INV);
