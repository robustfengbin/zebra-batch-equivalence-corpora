  382|   461M|    pub const fn add(&self, rhs: &Fp) -> Fp {
  383|   461M|        let (d0, carry) = adc(self.0[0], rhs.0[0], 0);
  384|   461M|        let (d1, carry) = adc(self.0[1], rhs.0[1], carry);
  385|   461M|        let (d2, carry) = adc(self.0[2], rhs.0[2], carry);
