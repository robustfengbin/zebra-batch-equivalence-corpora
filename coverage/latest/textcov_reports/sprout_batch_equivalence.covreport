  372|   676M|        let r1 = (self.0[1] & borrow) | (r1 & !borrow);
  373|   676M|        let r2 = (self.0[2] & borrow) | (r2 & !borrow);
  374|   676M|        let r3 = (self.0[3] & borrow) | (r3 & !borrow);
  375|   676M|        let r4 = (self.0[4] & borrow) | (r4 & !borrow);
  376|   676M|        let r5 = (self.0[5] & borrow) | (r5 & !borrow);
