_RNvMs9_NtCsaKH4ngBG85u_9bls12_3812fpNtB5_2Fp25lexicographically_largest:
  273|  5.47k|    pub fn lexicographically_largest(&self) -> Choice {
  274|       |        // This can be determined by checking to see if the element is
  275|       |        // larger than (p - 1) // 2. If we subtract by ((p - 1) // 2) + 1
  276|       |        // and there is no underflow, then the element must be larger than
  277|       |        // (p - 1) // 2.
  278|       |
  279|       |        // First, because self is in Montgomery form we need to reduce it
  280|  5.47k|        let tmp = Fp::montgomery_reduce(
  281|  5.47k|            self.0[0], self.0[1], self.0[2], self.0[3], self.0[4], self.0[5], 0, 0, 0, 0, 0, 0,
  282|       |        );
  283|       |
  284|  5.47k|        let (_, borrow) = sbb(tmp.0[0], 0xdcff_7fff_ffff_d556, 0);
  285|  5.47k|        let (_, borrow) = sbb(tmp.0[1], 0x0f55_ffff_58a9_ffff, borrow);
  286|  5.47k|        let (_, borrow) = sbb(tmp.0[2], 0xb398_6950_7b58_7b12, borrow);
  287|  5.47k|        let (_, borrow) = sbb(tmp.0[3], 0xb23b_a5c2_79c2_895f, borrow);
  288|  5.47k|        let (_, borrow) = sbb(tmp.0[4], 0x258d_d3db_21a5_d66b, borrow);
  289|  5.47k|        let (_, borrow) = sbb(tmp.0[5], 0x0d00_88f5_1cbf_f34d, borrow);
  290|       |
  291|       |        // If the element was smaller, the subtraction will underflow
  292|       |        // producing a borrow value of 0xffff...ffff, otherwise it will
  293|       |        // be zero. We create a Choice representing true if there was
  294|       |        // overflow (and so this element is not lexicographically larger
  295|       |        // than its negation) and then negate it.
  296|       |
  297|  5.47k|        !Choice::from((borrow as u8) & 1)
  298|  5.47k|    }
