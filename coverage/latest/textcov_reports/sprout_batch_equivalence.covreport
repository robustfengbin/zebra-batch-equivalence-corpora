  583|       |            self.index += 1;
  584|       |
  585|       |            f
  586|       |        }
  587|       |        fn square_output(f: Self::Output) -> Self::Output {
  588|       |            f.square()
  589|       |        }
  590|       |        fn conjugate(f: Self::Output) -> Self::Output {
