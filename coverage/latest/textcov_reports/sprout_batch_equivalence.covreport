  341|   421k|    pub const fn square(&self) -> Scalar {
  342|   421k|        let (r1, carry) = mac(0, self.0[0], self.0[1], 0);
  343|   421k|        let (r2, carry) = mac(0, self.0[0], self.0[2], carry);
  344|   421k|        let (r3, r4) = mac(0, self.0[0], self.0[3], carry);
  345|       |
  346|   421k|        let (r3, carry) = mac(r3, self.0[1], self.0[2], 0);
  347|   421k|        let (r4, r5) = mac(r4, self.0[1], self.0[3], carry);
  348|       |
  349|   421k|        let (r5, r6) = mac(r5, self.0[2], self.0[3], 0);
  350|       |
  351|   421k|        let r7 = r6 >> 63;
  352|   421k|        let r6 = (r6 << 1) | (r5 >> 63);
  353|   421k|        let r5 = (r5 << 1) | (r4 >> 63);
  354|   421k|        let r4 = (r4 << 1) | (r3 >> 63);
  355|   421k|        let r3 = (r3 << 1) | (r2 >> 63);
  356|   421k|        let r2 = (r2 << 1) | (r1 >> 63);
  357|   421k|        let r1 = r1 << 1;
  358|       |
  359|   421k|        let (r0, carry) = mac(0, self.0[0], self.0[0], 0);
  360|   421k|        let (r1, carry) = adc(0, r1, carry);
  361|   421k|        let (r2, carry) = mac(r2, self.0[1], self.0[1], carry);
  362|   421k|        let (r3, carry) = adc(0, r3, carry);
  363|   421k|        let (r4, carry) = mac(r4, self.0[2], self.0[2], carry);
  364|   421k|        let (r5, carry) = adc(0, r5, carry);
  365|   421k|        let (r6, carry) = mac(r6, self.0[3], self.0[3], carry);
  366|   421k|        let (r7, _) = adc(0, r7, carry);
  367|       |
  368|   421k|        Scalar::montgomery_reduce(r0, r1, r2, r3, r4, r5, r6, r7)
  369|   421k|    }
_RNvMsa_NtCsaKH4ngBG85u_9bls12_3816scalarNtB5_6Scalar8to_bytes:
  284|  29.4k|    pub fn to_bytes(&self) -> [u8; 32] {
  285|       |        // Turn into canonical form by computing
  286|       |        // (a.R) / R = a
  287|  29.4k|        let tmp = Scalar::montgomery_reduce(self.0[0], self.0[1], self.0[2], self.0[3], 0, 0, 0, 0);
  288|       |
  289|  29.4k|        let mut res = [0; 32];
  290|  29.4k|        res[0..8].copy_from_slice(&tmp.0[0].to_le_bytes());
  291|  29.4k|        res[8..16].copy_from_slice(&tmp.0[1].to_le_bytes());
  292|  29.4k|        res[16..24].copy_from_slice(&tmp.0[2].to_le_bytes());
  293|  29.4k|        res[24..32].copy_from_slice(&tmp.0[3].to_le_bytes());
  294|       |
  295|  29.4k|        res
  296|  29.4k|    }
_RNvMsa_NtCsaKH4ngBG85u_9bls12_3816scalarNtB5_6Scalar9from_u512:
  313|  3.96k|    fn from_u512(limbs: [u64; 8]) -> Scalar {
  314|       |        // We reduce an arbitrary 512-bit number by decomposing it into two 256-bit digits
  315|       |        // with the higher bits multiplied by 2^256. Thus, we perform two reductions
  316|       |        //
  317|       |        // 1. the lower bits are multiplied by R^2, as normal
  318|       |        // 2. the upper bits are multiplied by R^2 * 2^256 = R^3
  319|       |        //
  320|       |        // and computing their sum in the field. It remains to see that arbitrary 256-bit
  321|       |        // numbers can be placed into Montgomery form safely using the reduction. The
  322|       |        // reduction works so long as the product is less than R=2^256 multiplied by
  323|       |        // the modulus. This holds because for any `c` smaller than the modulus, we have
  324|       |        // that (2^256 - 1)*c is an acceptable product for the reduction. Therefore, the
  325|       |        // reduction always works so long as `c` is in the field; in this case it is either the
  326|       |        // constant `R2` or `R3`.
  327|  3.96k|        let d0 = Scalar([limbs[0], limbs[1], limbs[2], limbs[3]]);
  328|  3.96k|        let d1 = Scalar([limbs[4], limbs[5], limbs[6], limbs[7]]);
  329|       |        // Convert to Montgomery form
  330|  3.96k|        d0 * R2 + d1 * R3
  331|  3.96k|    }
