  651|  21.1M|        let (t5, carry) = adc(t5, 0, carry);
  652|  21.1M|        let (t6, carry) = mac(t6, self.0[3], self.0[3], carry);
  653|  21.1M|        let (t7, carry) = adc(t7, 0, carry);
