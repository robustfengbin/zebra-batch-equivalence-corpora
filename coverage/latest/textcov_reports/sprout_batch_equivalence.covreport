  361|   676M|    const fn subtract_p(&self) -> Fp {
  362|   676M|        let (r0, borrow) = sbb(self.0[0], MODULUS[0], 0);
  363|   676M|        let (r1, borrow) = sbb(self.0[1], MODULUS[1], borrow);
  364|   676M|        let (r2, borrow) = sbb(self.0[2], MODULUS[2], borrow);
  365|   676M|        let (r3, borrow) = sbb(self.0[3], MODULUS[3], borrow);
  366|   676M|        let (r4, borrow) = sbb(self.0[4], MODULUS[4], borrow);
  367|   676M|        let (r5, borrow) = sbb(self.0[5], MODULUS[5], borrow);
  368|       |
  369|       |        // If underflow occurred on the final limb, borrow = 0xfff...fff, otherwise
  370|       |        // borrow = 0x000...000. Thus, we use it as a mask!
