  638|  7.77M|    pub fn double(&self) -> G1Projective {
  639|       |        // Algorithm 9, https://eprint.iacr.org/2015/1060.pdf
  640|       |
  641|  7.77M|        let t0 = self.y.square();
  642|  7.77M|        let z3 = t0 + t0;
  643|  7.77M|        let z3 = z3 + z3;
  644|  7.77M|        let z3 = z3 + z3;
  645|  7.77M|        let t1 = self.y * self.z;
  646|  7.77M|        let t2 = self.z.square();
  647|  7.77M|        let t2 = mul_by_3b(t2);
  648|  7.77M|        let x3 = t2 * z3;
  649|  7.77M|        let y3 = t0 + t2;
  650|  7.77M|        let z3 = t1 * z3;
  651|  7.77M|        let t1 = t2 + t2;
  652|  7.77M|        let t2 = t1 + t2;
  653|  7.77M|        let t0 = t0 - t2;
  654|  7.77M|        let y3 = t0 * y3;
  655|  7.77M|        let y3 = x3 + y3;
  656|  7.77M|        let t1 = self.x * self.y;
  657|  7.77M|        let x3 = t0 * t1;
  658|  7.77M|        let x3 = x3 + x3;
  659|       |
  660|  7.77M|        let tmp = G1Projective {
  661|  7.77M|            x: x3,
  662|  7.77M|            y: y3,
  663|  7.77M|            z: z3,
  664|  7.77M|        };
  665|       |
  666|  7.77M|        G1Projective::conditional_select(&tmp, &G1Projective::identity(), self.is_identity())
  667|  7.77M|    }
