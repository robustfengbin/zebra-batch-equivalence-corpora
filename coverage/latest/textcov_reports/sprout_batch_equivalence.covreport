   76|       |            // For A
   77|   639k|            z0 = t0 - z0;
   78|   639k|            z0 = z0 + z0 + t0;
   79|       |
   80|   639k|            z1 = t1 + z1;
   81|   639k|            z1 = z1 + z1 + t1;
   82|       |
   83|   639k|            let (mut t0, t1) = fp4_square(z2, z3);
