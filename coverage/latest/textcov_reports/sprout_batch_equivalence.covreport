_RNvMNtNtCs4i8GxQSGIzb_6chrono5naive4dateNtB2_9NaiveDate22from_ordinal_and_flags:
  130|     83|    const fn from_ordinal_and_flags(
  131|     83|        year: i32,
  132|     83|        ordinal: u32,
  133|     83|        flags: YearFlags,
  134|     83|    ) -> Option<NaiveDate> {
  135|     83|        if year < MIN_YEAR || year > MAX_YEAR {
  136|      0|            return None; // Out-of-range
  137|     83|        }
  138|     83|        if ordinal == 0 || ordinal > 366 {
  139|      0|            return None; // Invalid
  140|     83|        }
  141|     83|        debug_assert!(YearFlags::from_year(year).0 == flags.0);
  142|     83|        let yof = (year << 13) | (ordinal << 4) as i32 | flags.0 as i32;
  143|     83|        match yof & OL_MASK <= MAX_OL {
  144|     83|            true => Some(NaiveDate::from_yof(yof)),
  145|      0|            false => None, // Does not exist: Ordinal 366 in a common year.
  146|       |        }
  147|     83|    }
