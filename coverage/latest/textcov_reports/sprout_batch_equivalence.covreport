  882|  1.38k|            x: self.x.frobenius_map() * psi_coeff_x,
  883|  1.38k|            // y = frobenius(y)/(u+1)^((p-1)/2)
  884|  1.38k|            y: self.y.frobenius_map() * psi_coeff_y,
  885|  1.38k|            // z = frobenius(z)
