  200|   512k|    fn mul_interleaved(&self, b: &Self) -> Self {
  201|       |        // The intuition for this algorithm is that we can look at F_p^6 as a direct
  202|       |        // extension of F_p^2, and express the overall operations down to the base field
  203|       |        // F_p instead of only over F_p^2. This enables us to interleave multiplications
  204|       |        // and reductions, ensuring that we don't require double-width intermediate
  205|       |        // representations (with around twice as many limbs as F_p elements).
  206|       |
  207|       |        // We want to express the multiplication c = a x b, where a = (a_0, a_1, a_2) is
  208|       |        // an element of F_p^6, and a_i = (a_i,0, a_i,1) is an element of F_p^2. The fully
  209|       |        // expanded multiplication is given by (2022-376 §5):
  210|       |        //
  211|       |        //   c_0,0 = a_0,0 b_0,0 - a_0,1 b_0,1 + a_1,0 b_2,0 - a_1,1 b_2,1 + a_2,0 b_1,0 - a_2,1 b_1,1
  212|       |        //                                     - a_1,0 b_2,1 - a_1,1 b_2,0 - a_2,0 b_1,1 - a_2,1 b_1,0.
  213|       |        //         = a_0,0 b_0,0 - a_0,1 b_0,1 + a_1,0 (b_2,0 - b_2,1) - a_1,1 (b_2,0 + b_2,1)
  214|       |        //                                     + a_2,0 (b_1,0 - b_1,1) - a_2,1 (b_1,0 + b_1,1).
  215|       |        //
  216|       |        //   c_0,1 = a_0,0 b_0,1 + a_0,1 b_0,0 + a_1,0 b_2,1 + a_1,1 b_2,0 + a_2,0 b_1,1 + a_2,1 b_1,0
  217|       |        //                                     + a_1,0 b_2,0 - a_1,1 b_2,1 + a_2,0 b_1,0 - a_2,1 b_1,1.
  218|       |        //         = a_0,0 b_0,1 + a_0,1 b_0,0 + a_1,0(b_2,0 + b_2,1) + a_1,1(b_2,0 - b_2,1)
  219|       |        //                                     + a_2,0(b_1,0 + b_1,1) + a_2,1(b_1,0 - b_1,1).
  220|       |        //
  221|       |        //   c_1,0 = a_0,0 b_1,0 - a_0,1 b_1,1 + a_1,0 b_0,0 - a_1,1 b_0,1 + a_2,0 b_2,0 - a_2,1 b_2,1
  222|       |        //                                                                 - a_2,0 b_2,1 - a_2,1 b_2,0.
  223|       |        //         = a_0,0 b_1,0 - a_0,1 b_1,1 + a_1,0 b_0,0 - a_1,1 b_0,1 + a_2,0(b_2,0 - b_2,1)
  224|       |        //                                                                 - a_2,1(b_2,0 + b_2,1).
  225|       |        //
  226|       |        //   c_1,1 = a_0,0 b_1,1 + a_0,1 b_1,0 + a_1,0 b_0,1 + a_1,1 b_0,0 + a_2,0 b_2,1 + a_2,1 b_2,0
  227|       |        //                                                                 + a_2,0 b_2,0 - a_2,1 b_2,1
  228|       |        //         = a_0,0 b_1,1 + a_0,1 b_1,0 + a_1,0 b_0,1 + a_1,1 b_0,0 + a_2,0(b_2,0 + b_2,1)
  229|       |        //                                                                 + a_2,1(b_2,0 - b_2,1).
  230|       |        //
  231|       |        //   c_2,0 = a_0,0 b_2,0 - a_0,1 b_2,1 + a_1,0 b_1,0 - a_1,1 b_1,1 + a_2,0 b_0,0 - a_2,1 b_0,1.
  232|       |        //   c_2,1 = a_0,0 b_2,1 + a_0,1 b_2,0 + a_1,0 b_1,1 + a_1,1 b_1,0 + a_2,0 b_0,1 + a_2,1 b_0,0.
  233|       |        //
  234|       |        // Each of these is a "sum of products", which we can compute efficiently.
  235|       |
  236|   512k|        let a = self;
  237|   512k|        let b10_p_b11 = b.c1.c0 + b.c1.c1;
  238|   512k|        let b10_m_b11 = b.c1.c0 - b.c1.c1;
  239|   512k|        let b20_p_b21 = b.c2.c0 + b.c2.c1;
  240|   512k|        let b20_m_b21 = b.c2.c0 - b.c2.c1;
  241|       |
  242|   512k|        Fp6 {
  243|   512k|            c0: Fp2 {
  244|   512k|                c0: Fp::sum_of_products(
  245|   512k|                    [a.c0.c0, -a.c0.c1, a.c1.c0, -a.c1.c1, a.c2.c0, -a.c2.c1],
  246|   512k|                    [b.c0.c0, b.c0.c1, b20_m_b21, b20_p_b21, b10_m_b11, b10_p_b11],
  247|   512k|                ),
  248|   512k|                c1: Fp::sum_of_products(
  249|   512k|                    [a.c0.c0, a.c0.c1, a.c1.c0, a.c1.c1, a.c2.c0, a.c2.c1],
  250|   512k|                    [b.c0.c1, b.c0.c0, b20_p_b21, b20_m_b21, b10_p_b11, b10_m_b11],
  251|   512k|                ),
  252|   512k|            },
  253|   512k|            c1: Fp2 {
  254|   512k|                c0: Fp::sum_of_products(
  255|   512k|                    [a.c0.c0, -a.c0.c1, a.c1.c0, -a.c1.c1, a.c2.c0, -a.c2.c1],
  256|   512k|                    [b.c1.c0, b.c1.c1, b.c0.c0, b.c0.c1, b20_m_b21, b20_p_b21],
  257|   512k|                ),
  258|   512k|                c1: Fp::sum_of_products(
  259|   512k|                    [a.c0.c0, a.c0.c1, a.c1.c0, a.c1.c1, a.c2.c0, a.c2.c1],
  260|   512k|                    [b.c1.c1, b.c1.c0, b.c0.c1, b.c0.c0, b20_p_b21, b20_m_b21],
  261|   512k|                ),
  262|   512k|            },
  263|   512k|            c2: Fp2 {
  264|   512k|                c0: Fp::sum_of_products(
  265|   512k|                    [a.c0.c0, -a.c0.c1, a.c1.c0, -a.c1.c1, a.c2.c0, -a.c2.c1],
  266|   512k|                    [b.c2.c0, b.c2.c1, b.c1.c0, b.c1.c1, b.c0.c0, b.c0.c1],
  267|   512k|                ),
  268|   512k|                c1: Fp::sum_of_products(
  269|   512k|                    [a.c0.c0, a.c0.c1, a.c1.c0, a.c1.c1, a.c2.c0, a.c2.c1],
  270|   512k|                    [b.c2.c1, b.c2.c0, b.c1.c1, b.c1.c0, b.c0.c1, b.c0.c0],
  271|   512k|                ),
  272|   512k|            },
  273|   512k|        }
  274|   512k|    }
