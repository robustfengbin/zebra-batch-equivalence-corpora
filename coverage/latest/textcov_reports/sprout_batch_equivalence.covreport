  337|  2.80k|    pub fn from_compressed_unchecked(bytes: &[u8; 48]) -> CtOption<Self> {
  338|       |        // Obtain the three flags from the start of the byte sequence
  339|  2.80k|        let compression_flag_set = Choice::from((bytes[0] >> 7) & 1);
  340|  2.80k|        let infinity_flag_set = Choice::from((bytes[0] >> 6) & 1);
  341|  2.80k|        let sort_flag_set = Choice::from((bytes[0] >> 5) & 1);
  342|       |
