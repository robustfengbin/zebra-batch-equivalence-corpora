  633|       |
  634|  21.1M|        let t11 = t10 >> 63;
  635|  21.1M|        let t10 = (t10 << 1) | (t9 >> 63);
  636|  21.1M|        let t9 = (t9 << 1) | (t8 >> 63);
  637|  21.1M|        let t8 = (t8 << 1) | (t7 >> 63);
  638|  21.1M|        let t7 = (t7 << 1) | (t6 >> 63);
  639|  21.1M|        let t6 = (t6 << 1) | (t5 >> 63);
