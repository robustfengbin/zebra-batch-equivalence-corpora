  724|   613k|    let tmp2 = tmp2 + tmp2;
  725|   613k|    let tmp2 = tmp2 + tmp2;
  726|   613k|    r.y -= tmp2;
  727|   613k|    let tmp3 = tmp4 * zsquared;
  728|   613k|    let tmp3 = tmp3 + tmp3;
  729|   613k|    let tmp3 = -tmp3;
  730|   613k|    let tmp6 = tmp6.square() - tmp0 - tmp5;
