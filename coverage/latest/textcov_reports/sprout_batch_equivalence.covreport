  619|       |
  620|  22.1M|        let (t3, carry) = mac(t3, self.0[1], self.0[2], 0);
  621|  22.1M|        let (t4, carry) = mac(t4, self.0[1], self.0[3], carry);
  622|  22.1M|        let (t5, carry) = mac(t5, self.0[1], self.0[4], carry);
  623|  22.1M|        let (t6, t7) = mac(t6, self.0[1], self.0[5], carry);
  624|       |
  625|  22.1M|        let (t5, carry) = mac(t5, self.0[2], self.0[3], 0);
  626|  22.1M|        let (t6, carry) = mac(t6, self.0[2], self.0[4], carry);
  627|  22.1M|        let (t7, t8) = mac(t7, self.0[2], self.0[5], carry);
