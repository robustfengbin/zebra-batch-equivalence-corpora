  300|  1.92k|    pub fn invert(&self) -> CtOption<Self> {
  301|       |        // We wish to find the multiplicative inverse of a nonzero
  302|       |        // element a + bu in Fp2. We leverage an identity
  303|       |        //
  304|       |        // (a + bu)(a - bu) = a^2 + b^2
  305|       |        //
