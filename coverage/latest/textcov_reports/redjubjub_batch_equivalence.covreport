  565|  4.93M|    pub const fn mul(&self, rhs: &Fp) -> Fp {
  566|  4.93M|        let (t0, carry) = mac(0, self.0[0], rhs.0[0], 0);
  567|  4.93M|        let (t1, carry) = mac(0, self.0[0], rhs.0[1], carry);
  568|  4.93M|        let (t2, carry) = mac(0, self.0[0], rhs.0[2], carry);
  569|  4.93M|        let (t3, carry) = mac(0, self.0[0], rhs.0[3], carry);
  570|  4.93M|        let (t4, carry) = mac(0, self.0[0], rhs.0[4], carry);
