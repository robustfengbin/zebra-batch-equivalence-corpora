  245|  1.40k|    pub fn sqrt(&self) -> CtOption<Self> {
  246|       |        // Algorithm 9, https://eprint.iacr.org/2012/685.pdf
  247|       |        // with constant time modifications.
  248|       |
  249|  1.40k|        CtOption::new(Fp2::zero(), self.is_zero()).or_else(|| {
