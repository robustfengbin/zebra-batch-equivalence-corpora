  695|  29.0k|        let t1 = t1 - t2;
  696|  29.0k|        let y3 = mul_by_3b(y3);
  697|  29.0k|        let x3 = t4 * y3;
  698|  29.0k|        let t2 = t3 * t1;
  699|  29.0k|        let x3 = t2 - x3;
  700|  29.0k|        let y3 = y3 * t0;
  701|  29.0k|        let t1 = t1 * z3;
  702|  29.0k|        let y3 = t1 + y3;
  703|  29.0k|        let t0 = t0 * t3;
  704|  29.0k|        let z3 = z3 * t4;
  705|  29.0k|        let z3 = z3 + t0;
