  555|       |        // Schoolbook multiplication
  556|       |
  557|  8.23M|        let (r0, carry) = mac(0, self.0[0], rhs.0[0], 0);
  558|  8.23M|        let (r1, carry) = mac(0, self.0[0], rhs.0[1], carry);
  559|  8.23M|        let (r2, carry) = mac(0, self.0[0], rhs.0[2], carry);
