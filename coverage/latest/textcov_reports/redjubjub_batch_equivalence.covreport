  418|  29.4M|    pub const fn sub(&self, rhs: &Self) -> Self {
  419|  29.4M|        let (d0, borrow) = sbb(self.0[0], rhs.0[0], 0);
  420|  29.4M|        let (d1, borrow) = sbb(self.0[1], rhs.0[1], borrow);
  421|  29.4M|        let (d2, borrow) = sbb(self.0[2], rhs.0[2], borrow);
