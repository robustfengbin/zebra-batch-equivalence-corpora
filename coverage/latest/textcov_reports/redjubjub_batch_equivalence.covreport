_RNvXsk_NtNtCs5ei4Ir5UmKx_12pasta_curves6fields2fpNtB5_2FpNtNtNtB9_10arithmetic6fields16SqrtTableHelpers21pow_by_t_minus1_over2:
  692|  72.0k|    fn pow_by_t_minus1_over2(&self) -> Self {
  693|  72.0k|        let sqr = |x: Fp, i: u32| (0..i).fold(x, |x, _| x.square());
  694|       |
  695|  72.0k|        let r10 = self.square();
  696|  72.0k|        let r11 = r10 * self;
  697|  72.0k|        let r110 = r11.square();
  698|  72.0k|        let r111 = r110 * self;
  699|  72.0k|        let r1001 = r111 * r10;
  700|  72.0k|        let r1101 = r111 * r110;
  701|  72.0k|        let ra = sqr(*self, 129) * self;
  702|  72.0k|        let rb = sqr(ra, 7) * r1001;
  703|  72.0k|        let rc = sqr(rb, 7) * r1101;
  704|  72.0k|        let rd = sqr(rc, 4) * r11;
  705|  72.0k|        let re = sqr(rd, 6) * r111;
  706|  72.0k|        let rf = sqr(re, 3) * r111;
  707|  72.0k|        let rg = sqr(rf, 10) * r1001;
  708|  72.0k|        let rh = sqr(rg, 5) * r1001;
  709|  72.0k|        let ri = sqr(rh, 4) * r1001;
  710|  72.0k|        let rj = sqr(ri, 3) * r111;
  711|  72.0k|        let rk = sqr(rj, 4) * r1001;
  712|  72.0k|        let rl = sqr(rk, 5) * r11;
  713|  72.0k|        let rm = sqr(rl, 4) * r111;
  714|  72.0k|        let rn = sqr(rm, 4) * r11;
  715|  72.0k|        let ro = sqr(rn, 6) * r1001;
  716|  72.0k|        let rp = sqr(ro, 5) * r1101;
  717|  72.0k|        let rq = sqr(rp, 4) * r11;
  718|  72.0k|        let rr = sqr(rq, 7) * r111;
  719|  72.0k|        let rs = sqr(rr, 3) * r11;
  720|  72.0k|        rs.square() // rt
  721|  72.0k|    }

