_RNvNtNtCs1QXxCJ72kGS_16zcash_primitives11transaction4txid10to_hash_v6:
  423|    174|pub(crate) fn to_hash_v6(
  424|    174|    consensus_branch_id: BranchId,
  425|    174|    header_digest: Blake2bHash,
  426|    174|    transparent_digest: Blake2bHash,
  427|    174|    sapling_digest: Option<Blake2bHash>,
  428|    174|    orchard_digest: Option<Blake2bHash>,
  429|    174|    ironwood_digest: Option<Blake2bHash>,
  430|    174|) -> Blake2bHash {
  431|    174|    let mut personal = [0; 16];
  432|    174|    personal[..12].copy_from_slice(ZCASH_TX_PERSONALIZATION_PREFIX);
  433|    174|    (&mut personal[12..])
  434|    174|        .write_u32_le(consensus_branch_id.into())
  435|    174|        .unwrap();
  436|       |
  437|    174|    let mut h = hasher(&personal);
  438|    174|    h.write_all(header_digest.as_bytes()).unwrap();
  439|    174|    h.write_all(transparent_digest.as_bytes()).unwrap();
  440|    174|    h.write_all(
  441|    174|        sapling_digest
  442|    174|            .unwrap_or_else(hash_sapling_txid_empty)
  443|    174|            .as_bytes(),
  444|       |    )
  445|    174|    .unwrap();
  446|    174|    h.write_all(
  447|    174|        orchard_digest
  448|    174|            .unwrap_or_else(|| {
  449|       |                let (value_pool, tx_version) = orchard_commitment_domain(TxVersion::V6);
  450|       |                orchard::commitments::hash_bundle_txid_empty(value_pool, tx_version)
  451|       |                    .expect("empty Orchard bundle txid commitment is valid for its tx format")
  452|       |            })
  453|    174|            .as_bytes(),
  454|       |    )
  455|    174|    .unwrap();
  456|    174|    h.write_all(
  457|    174|        ironwood_digest
  458|    174|            .unwrap_or_else(|| {
  459|       |                let (value_pool, tx_version) = ironwood_v6_domain();
  460|       |                orchard::commitments::hash_bundle_txid_empty(value_pool, tx_version)
  461|       |                    .expect("empty Ironwood bundle txid commitment is valid")
  462|       |            })
  463|    174|            .as_bytes(),
  464|       |    )
  465|    174|    .unwrap();
  466|       |
  467|    174|    h.finalize()
  468|    174|}
