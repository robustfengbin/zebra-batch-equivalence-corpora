  188|       |        //
  189|       |        // In BLS12-381's F_{p^2}, our \beta is -1 so we
  190|       |        // can modify this formula:
  191|       |        //
  192|       |        // c0' = (c0 + c1) * (c0 - c1)
  193|       |        // c1' = 2 * c0 * c1
  194|       |
  195|  1.25M|        let a = (&self.c0).add(&self.c1);
  196|  1.25M|        let b = (&self.c0).sub(&self.c1);
  197|  1.25M|        let c = (&self.c0).add(&self.c0);
  198|       |
  199|  1.25M|        Fp2 {
  200|  1.25M|            c0: (&a).mul(&b),
  201|  1.25M|            c1: (&c).mul(&self.c1),
  202|  1.25M|        }
  203|  1.25M|    }
