  554|  4.39M|    pub const fn mul(&self, rhs: &Self) -> Self {
  555|       |        // Schoolbook multiplication
  556|       |
  557|  4.39M|        let (r0, carry) = mac(0, self.0[0], rhs.0[0], 0);
