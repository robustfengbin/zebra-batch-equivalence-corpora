  506|  44.9M|    const fn montgomery_reduce(
  507|  44.9M|        r0: u64,
  508|  44.9M|        r1: u64,
  509|  44.9M|        r2: u64,
  510|  44.9M|        r3: u64,
  511|  44.9M|        r4: u64,
  512|  44.9M|        r5: u64,
  513|  44.9M|        r6: u64,
  514|  44.9M|        r7: u64,
  515|  44.9M|    ) -> Self {
  516|       |        // The Montgomery reduction here is based on Algorithm 14.32 in
  517|       |        // Handbook of Applied Cryptography
  518|       |        // <http://cacr.uwaterloo.ca/hac/about/chap14.pdf>.
  519|       |
  520|  44.9M|        let k = r0.wrapping_mul(INV);
  521|  44.9M|        let (_, carry) = mac(r0, k, MODULUS.0[0], 0);
  522|  44.9M|        let (r1, carry) = mac(r1, k, MODULUS.0[1], carry);
  523|  44.9M|        let (r2, carry) = mac(r2, k, MODULUS.0[2], carry);
  524|  44.9M|        let (r3, carry) = mac(r3, k, MODULUS.0[3], carry);
  525|  44.9M|        let (r4, carry2) = adc(r4, 0, carry);
  526|       |
  527|  44.9M|        let k = r1.wrapping_mul(INV);
  528|  44.9M|        let (_, carry) = mac(r1, k, MODULUS.0[0], 0);
  529|  44.9M|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  530|  44.9M|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
  531|  44.9M|        let (r4, carry) = mac(r4, k, MODULUS.0[3], carry);
  532|  44.9M|        let (r5, carry2) = adc(r5, carry2, carry);
  533|       |
  534|  44.9M|        let k = r2.wrapping_mul(INV);
  535|  44.9M|        let (_, carry) = mac(r2, k, MODULUS.0[0], 0);
  536|  44.9M|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  537|  44.9M|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  538|  44.9M|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  539|  44.9M|        let (r6, carry2) = adc(r6, carry2, carry);
  540|       |
  541|  44.9M|        let k = r3.wrapping_mul(INV);
  542|  44.9M|        let (_, carry) = mac(r3, k, MODULUS.0[0], 0);
  543|  44.9M|        let (r4, carry) = mac(r4, k, MODULUS.0[1], carry);
  544|  44.9M|        let (r5, carry) = mac(r5, k, MODULUS.0[2], carry);
  545|  44.9M|        let (r6, carry) = mac(r6, k, MODULUS.0[3], carry);
  546|  44.9M|        let (r7, _) = adc(r7, carry2, carry);
