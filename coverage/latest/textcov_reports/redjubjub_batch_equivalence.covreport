  617|  1.97M|        let (t4, carry) = mac(0, self.0[0], self.0[4], carry);
  618|  1.97M|        let (t5, t6) = mac(0, self.0[0], self.0[5], carry);
  619|       |
  620|  1.97M|        let (t3, carry) = mac(t3, self.0[1], self.0[2], 0);
  621|  1.97M|        let (t4, carry) = mac(t4, self.0[1], self.0[3], carry);
  622|  1.97M|        let (t5, carry) = mac(t5, self.0[1], self.0[4], carry);
  623|  1.97M|        let (t6, t7) = mac(t6, self.0[1], self.0[5], carry);
  624|       |
  625|  1.97M|        let (t5, carry) = mac(t5, self.0[2], self.0[3], 0);
  626|  1.97M|        let (t6, carry) = mac(t6, self.0[2], self.0[4], carry);
  627|  1.97M|        let (t7, t8) = mac(t7, self.0[2], self.0[5], carry);
  628|       |
  629|  1.97M|        let (t7, carry) = mac(t7, self.0[3], self.0[4], 0);
  630|  1.97M|        let (t8, t9) = mac(t8, self.0[3], self.0[5], carry);
  631|       |
  632|  1.97M|        let (t9, t10) = mac(t9, self.0[4], self.0[5], 0);
  633|       |
  634|  1.97M|        let t11 = t10 >> 63;
  635|  1.97M|        let t10 = (t10 << 1) | (t9 >> 63);
  636|  1.97M|        let t9 = (t9 << 1) | (t8 >> 63);
  637|  1.97M|        let t8 = (t8 << 1) | (t7 >> 63);
  638|  1.97M|        let t7 = (t7 << 1) | (t6 >> 63);
  639|  1.97M|        let t6 = (t6 << 1) | (t5 >> 63);
  640|  1.97M|        let t5 = (t5 << 1) | (t4 >> 63);
  641|  1.97M|        let t4 = (t4 << 1) | (t3 >> 63);
  642|  1.97M|        let t3 = (t3 << 1) | (t2 >> 63);
  643|  1.97M|        let t2 = (t2 << 1) | (t1 >> 63);
