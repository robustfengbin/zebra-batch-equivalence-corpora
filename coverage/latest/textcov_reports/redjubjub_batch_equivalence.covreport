  278|  3.78k|        let (_, borrow) = sbb(tmp.0[1], MODULUS.0[1], borrow);
  279|  3.78k|        let (_, borrow) = sbb(tmp.0[2], MODULUS.0[2], borrow);
  280|  3.78k|        let (_, borrow) = sbb(tmp.0[3], MODULUS.0[3], borrow);
  281|       |
