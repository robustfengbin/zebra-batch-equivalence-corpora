  272|  3.17k|        tmp.0[1] = u64::from_le_bytes(bytes[8..16].try_into().unwrap());
  273|  3.17k|        tmp.0[2] = u64::from_le_bytes(bytes[16..24].try_into().unwrap());
  274|  3.17k|        tmp.0[3] = u64::from_le_bytes(bytes[24..32].try_into().unwrap());
