  574|  7.14k|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  575|  7.14k|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  576|  7.14k|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  577|  7.14k|        let (r6, carry2) = adc(r6, carry2, carry);
  578|       |
  579|  7.14k|        let k = r3.wrapping_mul(INV);
  580|  7.14k|        let (_, carry) = mac(r3, k, MODULUS.0[0], 0);
  581|  7.14k|        let (r4, carry) = mac(r4, k, MODULUS.0[1], carry);
  582|  7.14k|        let (r5, carry) = mac(r5, k, MODULUS.0[2], carry);
  583|  7.14k|        let (r6, carry) = mac(r6, k, MODULUS.0[3], carry);
  584|  7.14k|        let (r7, _) = adc(r7, carry2, carry);
