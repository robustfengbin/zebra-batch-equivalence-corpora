  567|  25.2k|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  568|  25.2k|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
  569|  25.2k|        let (r4, carry) = mac(r4, k, MODULUS.0[3], carry);
  570|  25.2k|        let (r5, carry2) = adc(r5, carry2, carry);
