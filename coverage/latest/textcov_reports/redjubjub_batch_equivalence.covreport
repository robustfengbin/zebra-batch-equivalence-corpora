  339|  2.80k|        let compression_flag_set = Choice::from((bytes[0] >> 7) & 1);
  340|  2.80k|        let infinity_flag_set = Choice::from((bytes[0] >> 6) & 1);
  341|  2.80k|        let sort_flag_set = Choice::from((bytes[0] >> 5) & 1);
  342|       |
  343|       |        // Attempt to obtain the x-coordinate
  344|  2.80k|        let x = {
  345|  2.80k|            let mut tmp = [0; 48];
  346|  2.80k|            tmp.copy_from_slice(&bytes[0..48]);
  347|       |
  348|       |            // Mask away the flag bits
  349|  2.80k|            tmp[0] &= 0b0001_1111;
  350|       |
  351|  2.80k|            Fp::from_bytes(&tmp)
  352|       |        };
