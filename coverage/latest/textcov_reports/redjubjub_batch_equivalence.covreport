  156|  19.6k|        nh.update(&<[u8; 32]>::from(action.rk()));
  157|  19.6k|        nh.update(&action.encrypted_note().enc_ciphertext[564..]);
  158|  19.6k|        nh.update(&action.encrypted_note().out_ciphertext);
  159|  19.6k|    }
  160|       |
