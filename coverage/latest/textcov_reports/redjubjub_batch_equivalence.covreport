  562|  7.14k|        let (r3, carry) = mac(r3, k, MODULUS.0[3], carry);
  563|  7.14k|        let (r4, carry2) = adc(r4, 0, carry);
  564|       |
  565|  7.14k|        let k = r1.wrapping_mul(INV);
  566|  7.14k|        let (_, carry) = mac(r1, k, MODULUS.0[0], 0);
  567|  7.14k|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  568|  7.14k|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
  569|  7.14k|        let (r4, carry) = mac(r4, k, MODULUS.0[3], carry);
  570|  7.14k|        let (r5, carry2) = adc(r5, carry2, carry);
  571|       |
  572|  7.14k|        let k = r2.wrapping_mul(INV);
