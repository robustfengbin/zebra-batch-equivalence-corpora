  342|  28.3M|    const fn montgomery_reduce(
  343|  28.3M|        r0: u64,
  344|  28.3M|        r1: u64,
  345|  28.3M|        r2: u64,
  346|  28.3M|        r3: u64,
  347|  28.3M|        r4: u64,
  348|  28.3M|        r5: u64,
  349|  28.3M|        r6: u64,
  350|  28.3M|        r7: u64,
  351|  28.3M|    ) -> Self {
  352|       |        // The Montgomery reduction here is based on Algorithm 14.32 in
  353|       |        // Handbook of Applied Cryptography
  354|       |        // <http://cacr.uwaterloo.ca/hac/about/chap14.pdf>.
  355|       |
  356|  28.3M|        let k = r0.wrapping_mul(INV);
  357|  28.3M|        let (_, carry) = mac(r0, k, MODULUS.0[0], 0);
  358|  28.3M|        let (r1, carry) = mac(r1, k, MODULUS.0[1], carry);
  359|  28.3M|        let (r2, carry) = mac(r2, k, MODULUS.0[2], carry);
  360|  28.3M|        let (r3, carry) = mac(r3, k, MODULUS.0[3], carry);
  361|  28.3M|        let (r4, carry2) = adc(r4, 0, carry);
  362|       |
  363|  28.3M|        let k = r1.wrapping_mul(INV);
  364|  28.3M|        let (_, carry) = mac(r1, k, MODULUS.0[0], 0);
  365|  28.3M|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  366|  28.3M|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
  367|  28.3M|        let (r4, carry) = mac(r4, k, MODULUS.0[3], carry);
  368|  28.3M|        let (r5, carry2) = adc(r5, carry2, carry);
  369|       |
  370|  28.3M|        let k = r2.wrapping_mul(INV);
  371|  28.3M|        let (_, carry) = mac(r2, k, MODULUS.0[0], 0);
  372|  28.3M|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  373|  28.3M|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  374|  28.3M|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  375|  28.3M|        let (r6, carry2) = adc(r6, carry2, carry);
  376|       |
  377|  28.3M|        let k = r3.wrapping_mul(INV);
  378|  28.3M|        let (_, carry) = mac(r3, k, MODULUS.0[0], 0);
  379|  28.3M|        let (r4, carry) = mac(r4, k, MODULUS.0[1], carry);
  380|  28.3M|        let (r5, carry) = mac(r5, k, MODULUS.0[2], carry);
  381|  28.3M|        let (r6, carry) = mac(r6, k, MODULUS.0[3], carry);
  382|  28.3M|        let (r7, _) = adc(r7, carry2, carry);
  383|       |
  384|       |        // Result may be within MODULUS of the correct value
  385|  28.3M|        (&Fp([r4, r5, r6, r7])).sub(&MODULUS)
  386|  28.3M|    }
