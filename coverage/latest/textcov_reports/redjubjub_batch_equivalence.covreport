  487|  6.48M|    pub(crate) const fn montgomery_reduce(
  488|  6.48M|        t0: u64,
  489|  6.48M|        t1: u64,
  490|  6.48M|        t2: u64,
  491|  6.48M|        t3: u64,
  492|  6.48M|        t4: u64,
  493|  6.48M|        t5: u64,
  494|  6.48M|        t6: u64,
  495|  6.48M|        t7: u64,
  496|  6.48M|        t8: u64,
  497|  6.48M|        t9: u64,
  498|  6.48M|        t10: u64,
  499|  6.48M|        t11: u64,
  500|  6.48M|    ) -> Self {
  501|       |        // The Montgomery reduction here is based on Algorithm 14.32 in
  502|       |        // Handbook of Applied Cryptography
  503|       |        // <http://cacr.uwaterloo.ca/hac/about/chap14.pdf>.
  504|       |
  505|  6.48M|        let k = t0.wrapping_mul(INV);
  506|  6.48M|        let (_, carry) = mac(t0, k, MODULUS[0], 0);
  507|  6.48M|        let (r1, carry) = mac(t1, k, MODULUS[1], carry);
  508|  6.48M|        let (r2, carry) = mac(t2, k, MODULUS[2], carry);
  509|  6.48M|        let (r3, carry) = mac(t3, k, MODULUS[3], carry);
  510|  6.48M|        let (r4, carry) = mac(t4, k, MODULUS[4], carry);
  511|  6.48M|        let (r5, carry) = mac(t5, k, MODULUS[5], carry);
  512|  6.48M|        let (r6, r7) = adc(t6, 0, carry);
  513|       |
  514|  6.48M|        let k = r1.wrapping_mul(INV);
  515|  6.48M|        let (_, carry) = mac(r1, k, MODULUS[0], 0);
  516|  6.48M|        let (r2, carry) = mac(r2, k, MODULUS[1], carry);
  517|  6.48M|        let (r3, carry) = mac(r3, k, MODULUS[2], carry);
  518|  6.48M|        let (r4, carry) = mac(r4, k, MODULUS[3], carry);
  519|  6.48M|        let (r5, carry) = mac(r5, k, MODULUS[4], carry);
  520|  6.48M|        let (r6, carry) = mac(r6, k, MODULUS[5], carry);
  521|  6.48M|        let (r7, r8) = adc(t7, r7, carry);
  522|       |
  523|  6.48M|        let k = r2.wrapping_mul(INV);
  524|  6.48M|        let (_, carry) = mac(r2, k, MODULUS[0], 0);
  525|  6.48M|        let (r3, carry) = mac(r3, k, MODULUS[1], carry);
  526|  6.48M|        let (r4, carry) = mac(r4, k, MODULUS[2], carry);
  527|  6.48M|        let (r5, carry) = mac(r5, k, MODULUS[3], carry);
  528|  6.48M|        let (r6, carry) = mac(r6, k, MODULUS[4], carry);
  529|  6.48M|        let (r7, carry) = mac(r7, k, MODULUS[5], carry);
  530|  6.48M|        let (r8, r9) = adc(t8, r8, carry);
  531|       |
  532|  6.48M|        let k = r3.wrapping_mul(INV);
  533|  6.48M|        let (_, carry) = mac(r3, k, MODULUS[0], 0);
  534|  6.48M|        let (r4, carry) = mac(r4, k, MODULUS[1], carry);
  535|  6.48M|        let (r5, carry) = mac(r5, k, MODULUS[2], carry);
  536|  6.48M|        let (r6, carry) = mac(r6, k, MODULUS[3], carry);
  537|  6.48M|        let (r7, carry) = mac(r7, k, MODULUS[4], carry);
  538|  6.48M|        let (r8, carry) = mac(r8, k, MODULUS[5], carry);
  539|  6.48M|        let (r9, r10) = adc(t9, r9, carry);
  540|       |
  541|  6.48M|        let k = r4.wrapping_mul(INV);
  542|  6.48M|        let (_, carry) = mac(r4, k, MODULUS[0], 0);
  543|  6.48M|        let (r5, carry) = mac(r5, k, MODULUS[1], carry);
  544|  6.48M|        let (r6, carry) = mac(r6, k, MODULUS[2], carry);
  545|  6.48M|        let (r7, carry) = mac(r7, k, MODULUS[3], carry);
  546|  6.48M|        let (r8, carry) = mac(r8, k, MODULUS[4], carry);
  547|  6.48M|        let (r9, carry) = mac(r9, k, MODULUS[5], carry);
  548|  6.48M|        let (r10, r11) = adc(t10, r10, carry);
  549|       |
  550|  6.48M|        let k = r5.wrapping_mul(INV);
  551|  6.48M|        let (_, carry) = mac(r5, k, MODULUS[0], 0);
  552|  6.48M|        let (r6, carry) = mac(r6, k, MODULUS[1], carry);
  553|  6.48M|        let (r7, carry) = mac(r7, k, MODULUS[2], carry);
  554|  6.48M|        let (r8, carry) = mac(r8, k, MODULUS[3], carry);
  555|  6.48M|        let (r9, carry) = mac(r9, k, MODULUS[4], carry);
  556|  6.48M|        let (r10, carry) = mac(r10, k, MODULUS[5], carry);
  557|  6.48M|        let (r11, _) = adc(t11, r11, carry);
  558|       |
  559|       |        // Attempt to subtract the modulus, to ensure the value
  560|       |        // is smaller than the modulus.
  561|  6.48M|        (&Fp([r6, r7, r8, r9, r10, r11])).subtract_p()
  562|  6.48M|    }
