_RNvMse_NtNtCs5ei4Ir5UmKx_12pasta_curves6fields2fpNtB5_2Fp17montgomery_reduce:
  342|  24.6M|    const fn montgomery_reduce(
  343|  24.6M|        r0: u64,
  344|  24.6M|        r1: u64,
  345|  24.6M|        r2: u64,
  346|  24.6M|        r3: u64,
  347|  24.6M|        r4: u64,
  348|  24.6M|        r5: u64,
  349|  24.6M|        r6: u64,
  350|  24.6M|        r7: u64,
  351|  24.6M|    ) -> Self {
  352|       |        // The Montgomery reduction here is based on Algorithm 14.32 in
  353|       |        // Handbook of Applied Cryptography
  354|       |        // <http://cacr.uwaterloo.ca/hac/about/chap14.pdf>.
  355|       |
  356|  24.6M|        let k = r0.wrapping_mul(INV);
  357|  24.6M|        let (_, carry) = mac(r0, k, MODULUS.0[0], 0);
  358|  24.6M|        let (r1, carry) = mac(r1, k, MODULUS.0[1], carry);
  359|  24.6M|        let (r2, carry) = mac(r2, k, MODULUS.0[2], carry);
  360|  24.6M|        let (r3, carry) = mac(r3, k, MODULUS.0[3], carry);
  361|  24.6M|        let (r4, carry2) = adc(r4, 0, carry);
  362|       |
  363|  24.6M|        let k = r1.wrapping_mul(INV);
  364|  24.6M|        let (_, carry) = mac(r1, k, MODULUS.0[0], 0);
  365|  24.6M|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  366|  24.6M|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
  367|  24.6M|        let (r4, carry) = mac(r4, k, MODULUS.0[3], carry);
  368|  24.6M|        let (r5, carry2) = adc(r5, carry2, carry);
  369|       |
  370|  24.6M|        let k = r2.wrapping_mul(INV);
  371|  24.6M|        let (_, carry) = mac(r2, k, MODULUS.0[0], 0);
  372|  24.6M|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  373|  24.6M|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  374|  24.6M|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  375|  24.6M|        let (r6, carry2) = adc(r6, carry2, carry);
  376|       |
  377|  24.6M|        let k = r3.wrapping_mul(INV);
  378|  24.6M|        let (_, carry) = mac(r3, k, MODULUS.0[0], 0);
