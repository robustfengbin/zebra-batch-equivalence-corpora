  544|  5.98k|    const fn montgomery_reduce(
  545|  5.98k|        r0: u64,
  546|  5.98k|        r1: u64,
  547|  5.98k|        r2: u64,
  548|  5.98k|        r3: u64,
  549|  5.98k|        r4: u64,
  550|  5.98k|        r5: u64,
  551|  5.98k|        r6: u64,
  552|  5.98k|        r7: u64,
  553|  5.98k|    ) -> Self {
  554|       |        // The Montgomery reduction here is based on Algorithm 14.32 in
  555|       |        // Handbook of Applied Cryptography
  556|       |        // <http://cacr.uwaterloo.ca/hac/about/chap14.pdf>.
  557|       |
  558|  5.98k|        let k = r0.wrapping_mul(INV);
  559|  5.98k|        let (_, carry) = mac(r0, k, MODULUS.0[0], 0);
  560|  5.98k|        let (r1, carry) = mac(r1, k, MODULUS.0[1], carry);
  561|  5.98k|        let (r2, carry) = mac(r2, k, MODULUS.0[2], carry);
  562|  5.98k|        let (r3, carry) = mac(r3, k, MODULUS.0[3], carry);
  563|  5.98k|        let (r4, carry2) = adc(r4, 0, carry);
  564|       |
  565|  5.98k|        let k = r1.wrapping_mul(INV);
  566|  5.98k|        let (_, carry) = mac(r1, k, MODULUS.0[0], 0);
  567|  5.98k|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  568|  5.98k|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
  569|  5.98k|        let (r4, carry) = mac(r4, k, MODULUS.0[3], carry);
  570|  5.98k|        let (r5, carry2) = adc(r5, carry2, carry);
  571|       |
  572|  5.98k|        let k = r2.wrapping_mul(INV);
  573|  5.98k|        let (_, carry) = mac(r2, k, MODULUS.0[0], 0);
  574|  5.98k|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  575|  5.98k|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  576|  5.98k|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  577|  5.98k|        let (r6, carry2) = adc(r6, carry2, carry);
  578|       |
  579|  5.98k|        let k = r3.wrapping_mul(INV);
  580|  5.98k|        let (_, carry) = mac(r3, k, MODULUS.0[0], 0);
  581|  5.98k|        let (r4, carry) = mac(r4, k, MODULUS.0[1], carry);
  582|  5.98k|        let (r5, carry) = mac(r5, k, MODULUS.0[2], carry);
  583|  5.98k|        let (r6, carry) = mac(r6, k, MODULUS.0[3], carry);
  584|  5.98k|        let (r7, _) = adc(r7, carry2, carry);
