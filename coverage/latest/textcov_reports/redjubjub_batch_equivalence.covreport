  434|       |
  435|    408|    let shielded_outputs = od_v5s
  436|    408|        .into_iter()
  437|    408|        .zip(v_output_proofs)
  438|    408|        .map(|(od_5, zkproof)| od_5.into_output_description(zkproof))
  439|    408|        .collect();
