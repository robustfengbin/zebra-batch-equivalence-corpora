  712|  29.0k|    }
_RNvMsu_NtCsaKH4ngBG85u_9bls12_3812g1NtB5_12G1Projective6double:
  638|   305k|    pub fn double(&self) -> G1Projective {
  639|       |        // Algorithm 9, https://eprint.iacr.org/2015/1060.pdf
  640|       |
  641|   305k|        let t0 = self.y.square();
  642|   305k|        let z3 = t0 + t0;
