  611|  9.62k|        let (r4, carry) = mac(r4, self.0[3], rhs.0[1], carry);
  612|  9.62k|        let (r5, carry) = mac(r5, self.0[3], rhs.0[2], carry);
  613|  9.62k|        let (r6, r7) = mac(r6, self.0[3], rhs.0[3], carry);
  614|       |
