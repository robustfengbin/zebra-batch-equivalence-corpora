  475|    379|pub fn to_txid(
  476|    379|    txversion: TxVersion,
  477|    379|    consensus_branch_id: BranchId,
  478|    379|    digests: &TxDigests<Blake2bHash>,
  479|    379|) -> TxId {
  480|    379|    let txid_digest = if txversion.has_ironwood() {
  481|    123|        to_hash_v6(
  482|    123|            consensus_branch_id,
  483|    123|            digests.header_digest,
  484|    123|            hash_transparent_txid_data(digests.transparent_digests.as_ref()),
  485|    123|            digests.sapling_digest,
  486|    123|            digests.orchard_digest,
  487|    123|            digests.ironwood_digest,
  488|       |        )
  489|       |    } else {
  490|    256|        to_hash(
  491|    256|            txversion,
  492|    256|            consensus_branch_id,
  493|    256|            digests.header_digest,
  494|    256|            hash_transparent_txid_data(digests.transparent_digests.as_ref()),
  495|    256|            digests.sapling_digest,
  496|    256|            digests.orchard_digest,
  497|       |        )
  498|       |    };
  499|       |
  500|    379|    TxId::from_bytes(<[u8; 32]>::try_from(txid_digest.as_bytes()).unwrap())
  501|    379|}
