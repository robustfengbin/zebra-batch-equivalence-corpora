  574|  8.87k|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  575|  8.87k|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  576|  8.87k|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  577|  8.87k|        let (r6, carry2) = adc(r6, carry2, carry);
