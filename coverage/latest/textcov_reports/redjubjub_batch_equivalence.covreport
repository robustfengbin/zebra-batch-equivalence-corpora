_RNvMsa_NtCsaKH4ngBG85u_9bls12_3816scalarNtB5_6Scalar17montgomery_reduce:
  506|  48.8M|    const fn montgomery_reduce(
  507|  48.8M|        r0: u64,
  508|  48.8M|        r1: u64,
  509|  48.8M|        r2: u64,
  510|  48.8M|        r3: u64,
  511|  48.8M|        r4: u64,
  512|  48.8M|        r5: u64,
  513|  48.8M|        r6: u64,
  514|  48.8M|        r7: u64,
  515|  48.8M|    ) -> Self {
  516|       |        // The Montgomery reduction here is based on Algorithm 14.32 in
  517|       |        // Handbook of Applied Cryptography
  518|       |        // <http://cacr.uwaterloo.ca/hac/about/chap14.pdf>.
  519|       |
  520|  48.8M|        let k = r0.wrapping_mul(INV);
  521|  48.8M|        let (_, carry) = mac(r0, k, MODULUS.0[0], 0);
  522|  48.8M|        let (r1, carry) = mac(r1, k, MODULUS.0[1], carry);
  523|  48.8M|        let (r2, carry) = mac(r2, k, MODULUS.0[2], carry);
  524|  48.8M|        let (r3, carry) = mac(r3, k, MODULUS.0[3], carry);
  525|  48.8M|        let (r4, carry2) = adc(r4, 0, carry);
  526|       |
  527|  48.8M|        let k = r1.wrapping_mul(INV);
  528|  48.8M|        let (_, carry) = mac(r1, k, MODULUS.0[0], 0);
  529|  48.8M|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  530|  48.8M|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
  531|  48.8M|        let (r4, carry) = mac(r4, k, MODULUS.0[3], carry);
  532|  48.8M|        let (r5, carry2) = adc(r5, carry2, carry);
  533|       |
  534|  48.8M|        let k = r2.wrapping_mul(INV);
  535|  48.8M|        let (_, carry) = mac(r2, k, MODULUS.0[0], 0);
  536|  48.8M|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  537|  48.8M|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  538|  48.8M|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  539|  48.8M|        let (r6, carry2) = adc(r6, carry2, carry);
  540|       |
  541|  48.8M|        let k = r3.wrapping_mul(INV);
  542|  48.8M|        let (_, carry) = mac(r3, k, MODULUS.0[0], 0);
  543|  48.8M|        let (r4, carry) = mac(r4, k, MODULUS.0[1], carry);
  544|  48.8M|        let (r5, carry) = mac(r5, k, MODULUS.0[2], carry);
  545|  48.8M|        let (r6, carry) = mac(r6, k, MODULUS.0[3], carry);
  546|  48.8M|        let (r7, _) = adc(r7, carry2, carry);
  547|       |
  548|       |        // Result may be within MODULUS of the correct value
  549|  48.8M|        (&Scalar([r4, r5, r6, r7])).sub(&MODULUS)
  550|  48.8M|    }
