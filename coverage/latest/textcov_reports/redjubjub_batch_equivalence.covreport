  606|  9.62k|        let (r3, carry) = mac(r3, self.0[2], rhs.0[1], carry);
  607|  9.62k|        let (r4, carry) = mac(r4, self.0[2], rhs.0[2], carry);
  608|  9.62k|        let (r5, r6) = mac(r5, self.0[2], rhs.0[3], carry);
  609|       |
