  765|  9.00k|        let z3 = t1 + t2;
  766|  9.00k|        let t1 = t1 - t2;
  767|  9.00k|        let y3 = mul_by_3b(y3);
  768|  9.00k|        let x3 = t4 * y3;
  769|  9.00k|        let t2 = t3 * t1;
  770|  9.00k|        let x3 = t2 - x3;
  771|  9.00k|        let y3 = y3 * t0;
  772|  9.00k|        let t1 = t1 * z3;
  773|  9.00k|        let y3 = t1 + y3;
  774|  9.00k|        let t0 = t0 * t3;
  775|  9.00k|        let z3 = z3 * t4;
  776|  9.00k|        let z3 = z3 + t0;
