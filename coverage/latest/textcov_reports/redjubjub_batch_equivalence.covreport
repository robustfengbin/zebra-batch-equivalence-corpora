  361|  18.5M|    const fn subtract_p(&self) -> Fp {
  362|  18.5M|        let (r0, borrow) = sbb(self.0[0], MODULUS[0], 0);
  363|  18.5M|        let (r1, borrow) = sbb(self.0[1], MODULUS[1], borrow);
  364|  18.5M|        let (r2, borrow) = sbb(self.0[2], MODULUS[2], borrow);
  365|  18.5M|        let (r3, borrow) = sbb(self.0[3], MODULUS[3], borrow);
  366|  18.5M|        let (r4, borrow) = sbb(self.0[4], MODULUS[4], borrow);
  367|  18.5M|        let (r5, borrow) = sbb(self.0[5], MODULUS[5], borrow);
  368|       |
  369|       |        // If underflow occurred on the final limb, borrow = 0xfff...fff, otherwise
  370|       |        // borrow = 0x000...000. Thus, we use it as a mask!
  371|  18.5M|        let r0 = (self.0[0] & borrow) | (r0 & !borrow);
  372|  18.5M|        let r1 = (self.0[1] & borrow) | (r1 & !borrow);
  373|  18.5M|        let r2 = (self.0[2] & borrow) | (r2 & !borrow);
  374|  18.5M|        let r3 = (self.0[3] & borrow) | (r3 & !borrow);
  375|  18.5M|        let r4 = (self.0[4] & borrow) | (r4 & !borrow);
  376|  18.5M|        let r5 = (self.0[5] & borrow) | (r5 & !borrow);
  377|       |
  378|  18.5M|        Fp([r0, r1, r2, r3, r4, r5])
  379|  18.5M|    }
