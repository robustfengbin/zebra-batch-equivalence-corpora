  303|  8.94k|        res[8..16].copy_from_slice(&tmp.0[1].to_le_bytes());
  304|  8.94k|        res[16..24].copy_from_slice(&tmp.0[2].to_le_bytes());
  305|  8.94k|        res[24..32].copy_from_slice(&tmp.0[3].to_le_bytes());
