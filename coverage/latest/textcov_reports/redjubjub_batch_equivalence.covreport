  447|       |                            &-y,
  448|       |                            y.lexicographically_largest() ^ sort_flag_set,
  449|       |                        );
  450|       |
  451|       |                        CtOption::new(
  452|       |                            G2Affine {
  453|       |                                x,
  454|       |                                y,
  455|       |                                infinity: infinity_flag_set,
  456|       |                            },
  457|       |                            (!infinity_flag_set) & // Infinity flag should not be set
  458|       |                            compression_flag_set, // Compression flag should be set
  459|       |                        )
  460|       |                    })
  461|       |                })
  462|       |            })
  463|       |        })
  464|  1.54k|    }
