  395|    408|pub(crate) fn read_v5_bundle<R: Read>(
  396|    408|    mut reader: R,
  397|    408|) -> io::Result<Option<Bundle<Authorized, ZatBalance>>> {
  398|    408|    let sd_v5s = Vector::read(&mut reader, read_spend_v5)?;
  399|    408|    let od_v5s = Vector::read(&mut reader, read_output_v5)?;
  400|    408|    let n_spends = sd_v5s.len();
