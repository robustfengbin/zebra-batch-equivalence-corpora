  620|  20.1k|    pub const fn sub(&self, rhs: &Self) -> Self {
  621|  20.1k|        let (d0, borrow) = sbb(self.0[0], rhs.0[0], 0);
  622|  20.1k|        let (d1, borrow) = sbb(self.0[1], rhs.0[1], borrow);
  623|  20.1k|        let (d2, borrow) = sbb(self.0[2], rhs.0[2], borrow);
