   86|    509|fn orchard_commitment_domain(version: TxVersion) -> (ValuePool, OrchardTxVersion) {
   87|    509|    match version {
   88|       |        TxVersion::Sprout(_) | TxVersion::V3 | TxVersion::V4 | TxVersion::V5 => {
   89|    335|            (ValuePool::Orchard, OrchardTxVersion::V5)
   90|       |        }
   91|    174|        TxVersion::V6 => (ValuePool::Orchard, OrchardTxVersion::V6),
   92|       |    }
   93|    509|}
_RNvNtNtCs1QXxCJ72kGS_16zcash_primitives11transaction4txid26hash_transparent_txid_data:
  255|    509|pub(crate) fn hash_transparent_txid_data(
  256|    509|    t_digests: Option<&TransparentDigests<Blake2bHash>>,
  257|    509|) -> Blake2bHash {
  258|    509|    let mut h = hasher(ZCASH_TRANSPARENT_HASH_PERSONALIZATION);
  259|    509|    if let Some(d) = t_digests {
  260|    255|        h.write_all(d.prevouts_digest.as_bytes()).unwrap();
  261|    255|        h.write_all(d.sequence_digest.as_bytes()).unwrap();
  262|    255|        h.write_all(d.outputs_digest.as_bytes()).unwrap();
  263|    255|    }
  264|    509|    h.finalize()
  265|    509|}
