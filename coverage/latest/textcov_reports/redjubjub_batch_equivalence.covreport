  617|   270k|    fn to_repr(&self) -> Self::Repr {
  618|       |        // Turn into canonical form by computing
  619|       |        // (a.R) / R = a
  620|   270k|        let tmp = Fp::montgomery_reduce(self.0[0], self.0[1], self.0[2], self.0[3], 0, 0, 0, 0);
  621|       |
  622|   270k|        let mut res = [0; 32];
  623|   270k|        res[0..8].copy_from_slice(&tmp.0[0].to_le_bytes());
  624|   270k|        res[8..16].copy_from_slice(&tmp.0[1].to_le_bytes());
  625|   270k|        res[16..24].copy_from_slice(&tmp.0[2].to_le_bytes());
  626|   270k|        res[24..32].copy_from_slice(&tmp.0[3].to_le_bytes());
  627|       |
