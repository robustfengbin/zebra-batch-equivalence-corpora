  309|  2.42k|    pub fn pow_vartime(&self, by: &[u64; 6]) -> Self {
  310|  2.42k|        let mut res = Self::one();
  311|  14.5k|        for e in by.iter().rev() {
  312|   930k|            for i in (0..64).rev() {
  313|   930k|                res = res.square();
  314|       |
  315|   930k|                if ((*e >> i) & 1) == 1 {
  316|   554k|                    res *= self;
  317|   554k|                }
  318|       |            }
  319|       |        }
  320|  2.42k|        res
  321|  2.42k|    }
