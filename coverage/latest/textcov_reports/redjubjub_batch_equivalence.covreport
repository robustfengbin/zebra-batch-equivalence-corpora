  362|  1.94M|        let (r3, carry) = adc(0, r3, carry);
  363|  1.94M|        let (r4, carry) = mac(r4, self.0[2], self.0[2], carry);
  364|  1.94M|        let (r5, carry) = adc(0, r5, carry);
  365|  1.94M|        let (r6, carry) = mac(r6, self.0[3], self.0[3], carry);
