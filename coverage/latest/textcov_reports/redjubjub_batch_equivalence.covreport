  310|  3.08k|        let mut res = Self::one();
  311|  18.5k|        for e in by.iter().rev() {
  312|  1.18M|            for i in (0..64).rev() {
  313|  1.18M|                res = res.square();
  314|       |
  315|  1.18M|                if ((*e >> i) & 1) == 1 {
  316|   707k|                    res *= self;
  317|   707k|                }
  318|       |            }
  319|       |        }
  320|  3.08k|        res
  321|  3.08k|    }
