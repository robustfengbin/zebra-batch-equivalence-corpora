   77|  11.3k|            nullifier: Nullifier::try_from(reader.read_32_bytes()?)?,
   78|       |            // Type is SpendAuthSig^{Orchard}.Public, i.e. ℙ.
   79|       |            // https://zips.z.cash/protocol/protocol.pdf#concretespendauthsig
   80|       |            // https://zips.z.cash/protocol/protocol.pdf#concretereddsa
   81|       |            // This only reads the 32-byte buffer. The type is enforced
   82|       |            // on signature verification; see [`reddsa::batch`]
   83|       |            rk: {
   84|  11.3k|                let rk_bytes = reader.read_32_bytes()?;
   85|  11.3k|                if rk_bytes == [0u8; 32] {
   86|      2|                    return Err(SerializationError::Parse(
   87|      2|                        "Orchard action rk must not be the identity point",
   88|      2|                    ));
   89|  11.3k|                }
   90|  11.3k|                rk_bytes.into()
   91|       |            },
   92|       |            // Type is `{0 .. 𝑞_ℙ − 1}`. Note that the second rule quoted above
   93|       |            // is also enforced here and it is technically redundant with the first.
   94|       |            // See [`pallas::Base::zcash_deserialize`].
   95|  11.3k|            cm_x: pallas::Base::zcash_deserialize(&mut reader)?,
   96|       |            // Denoted by `epk` in the spec. Type is KA^{Orchard}.Public, i.e. ℙ^*.
   97|       |            // https://zips.z.cash/protocol/protocol.pdf#concreteorchardkeyagreement
   98|       |            // See [`keys::EphemeralPublicKey::zcash_deserialize`].
   99|  11.3k|            ephemeral_key: keys::EphemeralPublicKey::zcash_deserialize(&mut reader)?,
  100|       |            // Type is `Sym.C`, i.e. `𝔹^Y^{\[N\]}`, i.e. arbitrary-sized byte arrays
  101|       |            // https://zips.z.cash/protocol/protocol.pdf#concretesym but fixed to
  102|       |            // 580 bytes in https://zips.z.cash/protocol/protocol.pdf#outputencodingandconsensus
  103|       |            // See [`note::EncryptedNote::zcash_deserialize`].
  104|  11.3k|            enc_ciphertext: note::EncryptedNote::zcash_deserialize(&mut reader)?,
  105|       |            // Type is `Sym.C`, i.e. `𝔹^Y^{\[N\]}`, i.e. arbitrary-sized byte arrays
  106|       |            // https://zips.z.cash/protocol/protocol.pdf#concretesym but fixed to
  107|       |            // 80 bytes in https://zips.z.cash/protocol/protocol.pdf#outputencodingandconsensus
  108|       |            // See [`note::WrappedNoteKey::zcash_deserialize`].
  109|  11.3k|            out_ciphertext: note::WrappedNoteKey::zcash_deserialize(&mut reader)?,
  110|       |        })
  111|  11.3k|    }
