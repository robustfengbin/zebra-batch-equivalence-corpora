  341|  39.4M|    pub const fn square(&self) -> Scalar {
  342|  39.4M|        let (r1, carry) = mac(0, self.0[0], self.0[1], 0);
  343|  39.4M|        let (r2, carry) = mac(0, self.0[0], self.0[2], carry);
  344|  39.4M|        let (r3, r4) = mac(0, self.0[0], self.0[3], carry);
  345|       |
  346|  39.4M|        let (r3, carry) = mac(r3, self.0[1], self.0[2], 0);
  347|  39.4M|        let (r4, r5) = mac(r4, self.0[1], self.0[3], carry);
  348|       |
  349|  39.4M|        let (r5, r6) = mac(r5, self.0[2], self.0[3], 0);
  350|       |
