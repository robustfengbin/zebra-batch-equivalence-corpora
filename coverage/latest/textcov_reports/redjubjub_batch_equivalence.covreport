  627|       |        // borrow = 0x000...000. Thus, we use it as a mask to conditionally add the modulus.
  628|  18.4k|        let (d0, carry) = adc(d0, MODULUS.0[0] & borrow, 0);
  629|  18.4k|        let (d1, carry) = adc(d1, MODULUS.0[1] & borrow, carry);
  630|  18.4k|        let (d2, carry) = adc(d2, MODULUS.0[2] & borrow, carry);
  631|  18.4k|        let (d3, _) = adc(d3, MODULUS.0[3] & borrow, carry);
  632|       |
  633|  18.4k|        Fr([d0, d1, d2, d3])
  634|  18.4k|    }
