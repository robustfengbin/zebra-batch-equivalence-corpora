  676|  37.0k|        let t3 = self.x + self.y;
  677|  37.0k|        let t4 = rhs.x + rhs.y;
  678|  37.0k|        let t3 = t3 * t4;
  679|  37.0k|        let t4 = t0 + t1;
  680|  37.0k|        let t3 = t3 - t4;
