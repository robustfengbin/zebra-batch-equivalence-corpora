  638|  1.10k|    pub const fn add(&self, rhs: &Self) -> Self {
  639|  1.10k|        let (d0, carry) = adc(self.0[0], rhs.0[0], 0);
  640|  1.10k|        let (d1, carry) = adc(self.0[1], rhs.0[1], carry);
  641|  1.10k|        let (d2, carry) = adc(self.0[2], rhs.0[2], carry);
  642|  1.10k|        let (d3, _) = adc(self.0[3], rhs.0[3], carry);
  643|       |
  644|       |        // Attempt to subtract the modulus, to ensure the value
  645|       |        // is smaller than the modulus.
  646|  1.10k|        (&Fr([d0, d1, d2, d3])).sub(&MODULUS)
