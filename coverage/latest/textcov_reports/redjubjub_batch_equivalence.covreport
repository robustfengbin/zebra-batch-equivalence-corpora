  179|  4.85k|    pub fn from_bytes(bytes: &[u8; 48]) -> CtOption<Fp> {
  180|  4.85k|        let mut tmp = Fp([0, 0, 0, 0, 0, 0]);
  181|       |
  182|  4.85k|        tmp.0[5] = u64::from_be_bytes(<[u8; 8]>::try_from(&bytes[0..8]).unwrap());
  183|  4.85k|        tmp.0[4] = u64::from_be_bytes(<[u8; 8]>::try_from(&bytes[8..16]).unwrap());
  184|  4.85k|        tmp.0[3] = u64::from_be_bytes(<[u8; 8]>::try_from(&bytes[16..24]).unwrap());
  185|  4.85k|        tmp.0[2] = u64::from_be_bytes(<[u8; 8]>::try_from(&bytes[24..32]).unwrap());
  186|  4.85k|        tmp.0[1] = u64::from_be_bytes(<[u8; 8]>::try_from(&bytes[32..40]).unwrap());
  187|  4.85k|        tmp.0[0] = u64::from_be_bytes(<[u8; 8]>::try_from(&bytes[40..48]).unwrap());
  188|       |
  189|       |        // Try to subtract the modulus
  190|  4.85k|        let (_, borrow) = sbb(tmp.0[0], MODULUS[0], 0);
  191|  4.85k|        let (_, borrow) = sbb(tmp.0[1], MODULUS[1], borrow);
  192|  4.85k|        let (_, borrow) = sbb(tmp.0[2], MODULUS[2], borrow);
  193|  4.85k|        let (_, borrow) = sbb(tmp.0[3], MODULUS[3], borrow);
  194|  4.85k|        let (_, borrow) = sbb(tmp.0[4], MODULUS[4], borrow);
  195|  4.85k|        let (_, borrow) = sbb(tmp.0[5], MODULUS[5], borrow);
  196|       |
  197|       |        // If the element is smaller than MODULUS then the
  198|       |        // subtraction will underflow, producing a borrow value
  199|       |        // of 0xffff...ffff. Otherwise, it'll be zero.
  200|  4.85k|        let is_some = (borrow as u8) & 1;
  201|       |
  202|       |        // Convert to Montgomery form by computing
  203|       |        // (a.R^0 * R^2) / R = a.R
  204|  4.85k|        tmp *= &R2;
  205|       |
  206|  4.85k|        CtOption::new(tmp, Choice::from(is_some))
  207|  4.85k|    }
