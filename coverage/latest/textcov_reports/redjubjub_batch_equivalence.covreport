  670|  37.0k|    pub fn add(&self, rhs: &G1Projective) -> G1Projective {
  671|       |        // Algorithm 7, https://eprint.iacr.org/2015/1060.pdf
  672|       |
  673|  37.0k|        let t0 = self.x * rhs.x;
