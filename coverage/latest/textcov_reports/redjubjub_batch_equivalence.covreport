  278|  3.17k|        let (_, borrow) = sbb(tmp.0[1], MODULUS.0[1], borrow);
  279|  3.17k|        let (_, borrow) = sbb(tmp.0[2], MODULUS.0[2], borrow);
  280|  3.17k|        let (_, borrow) = sbb(tmp.0[3], MODULUS.0[3], borrow);
  281|       |
  282|       |        // If the element is smaller than MODULUS then the
  283|       |        // subtraction will underflow, producing a borrow value
  284|       |        // of 0xffff...ffff. Otherwise, it'll be zero.
  285|  3.17k|        let is_some = (borrow as u8) & 1;
  286|       |
  287|       |        // Convert to Montgomery form by computing
  288|       |        // (a.R^0 * R^2) / R = a.R
