  929|   186k|        let c = self.t1 * self.t2 * other.t2d;
  930|   186k|        let d = (self.z * other.z).double();
  931|       |
  932|   186k|        CompletedPoint {
  933|   186k|            u: b - a,
  934|   186k|            v: b + a,
  935|   186k|            z: d - c,
  936|   186k|            t: d + c,
  937|   186k|        }
  938|   186k|        .into_extended()
  939|   186k|    }
