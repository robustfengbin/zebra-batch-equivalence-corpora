  620|  18.4k|    pub const fn sub(&self, rhs: &Self) -> Self {
  621|  18.4k|        let (d0, borrow) = sbb(self.0[0], rhs.0[0], 0);
  622|  18.4k|        let (d1, borrow) = sbb(self.0[1], rhs.0[1], borrow);
  623|  18.4k|        let (d2, borrow) = sbb(self.0[2], rhs.0[2], borrow);
  624|  18.4k|        let (d3, borrow) = sbb(self.0[3], rhs.0[3], borrow);
