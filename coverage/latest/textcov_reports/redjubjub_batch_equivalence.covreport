  182|  1.34M|    pub const fn square(&self) -> Fp2 {
  183|       |        // Complex squaring:
  184|       |        //
  185|       |        // v0  = c0 * c1
  186|       |        // c0' = (c0 + c1) * (c0 + \beta*c1) - v0 - \beta * v0
