  329|  23.9M|        let (r1, carry) = adc(0, r1, carry);
  330|  23.9M|        let (r2, carry) = mac(r2, self.0[1], self.0[1], carry);
  331|  23.9M|        let (r3, carry) = adc(0, r3, carry);
