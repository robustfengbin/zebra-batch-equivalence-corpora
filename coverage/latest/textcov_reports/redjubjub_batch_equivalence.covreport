  149|  21.8k|        ch.update(&action.cmx().to_bytes());
  150|  21.8k|        ch.update(&action.encrypted_note().epk_bytes);
  151|  21.8k|        ch.update(&action.encrypted_note().enc_ciphertext[..52]);
  152|  21.8k|
  153|  21.8k|        mh.update(&action.encrypted_note().enc_ciphertext[52..564]);
  154|  21.8k|
  155|  21.8k|        nh.update(&action.cv_net().to_bytes());
  156|  21.8k|        nh.update(&<[u8; 32]>::from(action.rk()));
  157|  21.8k|        nh.update(&action.encrypted_note().enc_ciphertext[564..]);
  158|  21.8k|        nh.update(&action.encrypted_note().out_ciphertext);
  159|  21.8k|    }
  160|       |
  161|    349|    h.update(ch.finalize().as_bytes());
  162|    349|    h.update(mh.finalize().as_bytes());
  163|    349|    h.update(nh.finalize().as_bytes());
  164|    349|    h.update(&[bundle.flag_byte()]);
