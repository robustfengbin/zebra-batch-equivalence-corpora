  928|   124k|        let b = (self.v + self.u) * other.v_minus_u;
  929|   124k|        let c = self.t1 * self.t2 * other.t2d;
  930|   124k|        let d = (self.z * other.z).double();
  931|       |
  932|   124k|        CompletedPoint {
  933|   124k|            u: b - a,
  934|   124k|            v: b + a,
  935|   124k|            z: d - c,
  936|   124k|            t: d + c,
  937|   124k|        }
  938|   124k|        .into_extended()
  939|   124k|    }
