  579|  8.87k|        let k = r3.wrapping_mul(INV);
  580|  8.87k|        let (_, carry) = mac(r3, k, MODULUS.0[0], 0);
  581|  8.87k|        let (r4, carry) = mac(r4, k, MODULUS.0[1], carry);
  582|  8.87k|        let (r5, carry) = mac(r5, k, MODULUS.0[2], carry);
  583|  8.87k|        let (r6, carry) = mac(r6, k, MODULUS.0[3], carry);
