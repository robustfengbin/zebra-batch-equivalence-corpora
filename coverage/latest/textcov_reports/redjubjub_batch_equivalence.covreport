  222|    108|            random_seed: RandomSeed::from(reader.read_32_bytes()?),
  223|       |            // Types are `B^{ℓ^{Sprout}_{PRF}}` i.e. 32 bytes.
  224|       |            // See [`note::Mac::zcash_deserialize`].
  225|       |            vmacs: [
  226|    104|                note::Mac::zcash_deserialize(&mut reader)?,
  227|    100|                note::Mac::zcash_deserialize(&mut reader)?,
