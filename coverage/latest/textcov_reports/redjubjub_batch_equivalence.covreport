  192|  72.0k|        let is_square = (sq - u).is_zero();
  193|  72.0k|        let is_nonsquare = (sq - F::ROOT_OF_UNITY * u).is_zero();
  194|  72.0k|        assert!(bool::from(u.is_zero() | (is_square ^ is_nonsquare)));
  195|       |
  196|  72.0k|        (is_square, res)
  197|  72.0k|    }

