_RNvMse_NtNtCs5ei4Ir5UmKx_12pasta_curves6fields2fpNtB5_2Fp17montgomery_reduce:
  342|  27.1M|    const fn montgomery_reduce(
  343|  27.1M|        r0: u64,
  344|  27.1M|        r1: u64,
  345|  27.1M|        r2: u64,
  346|  27.1M|        r3: u64,
  347|  27.1M|        r4: u64,
  348|  27.1M|        r5: u64,
  349|  27.1M|        r6: u64,
  350|  27.1M|        r7: u64,
  351|  27.1M|    ) -> Self {
  352|       |        // The Montgomery reduction here is based on Algorithm 14.32 in
  353|       |        // Handbook of Applied Cryptography
  354|       |        // <http://cacr.uwaterloo.ca/hac/about/chap14.pdf>.
  355|       |
  356|  27.1M|        let k = r0.wrapping_mul(INV);
  357|  27.1M|        let (_, carry) = mac(r0, k, MODULUS.0[0], 0);
  358|  27.1M|        let (r1, carry) = mac(r1, k, MODULUS.0[1], carry);
  359|  27.1M|        let (r2, carry) = mac(r2, k, MODULUS.0[2], carry);
  360|  27.1M|        let (r3, carry) = mac(r3, k, MODULUS.0[3], carry);
  361|  27.1M|        let (r4, carry2) = adc(r4, 0, carry);
  362|       |
  363|  27.1M|        let k = r1.wrapping_mul(INV);
  364|  27.1M|        let (_, carry) = mac(r1, k, MODULUS.0[0], 0);
  365|  27.1M|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  366|  27.1M|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
  367|  27.1M|        let (r4, carry) = mac(r4, k, MODULUS.0[3], carry);
  368|  27.1M|        let (r5, carry2) = adc(r5, carry2, carry);
  369|       |
  370|  27.1M|        let k = r2.wrapping_mul(INV);
  371|  27.1M|        let (_, carry) = mac(r2, k, MODULUS.0[0], 0);
  372|  27.1M|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  373|  27.1M|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  374|  27.1M|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  375|  27.1M|        let (r6, carry2) = adc(r6, carry2, carry);
  376|       |
  377|  27.1M|        let k = r3.wrapping_mul(INV);
  378|  27.1M|        let (_, carry) = mac(r3, k, MODULUS.0[0], 0);
  379|  27.1M|        let (r4, carry) = mac(r4, k, MODULUS.0[1], carry);
  380|  27.1M|        let (r5, carry) = mac(r5, k, MODULUS.0[2], carry);
  381|  27.1M|        let (r6, carry) = mac(r6, k, MODULUS.0[3], carry);
  382|  27.1M|        let (r7, _) = adc(r7, carry2, carry);
  383|       |
  384|       |        // Result may be within MODULUS of the correct value
  385|  27.1M|        (&Fp([r4, r5, r6, r7])).sub(&MODULUS)
  386|  27.1M|    }
