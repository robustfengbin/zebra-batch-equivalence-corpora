  647|  1.97M|        let (t1, carry) = adc(t1, 0, carry);
  648|  1.97M|        let (t2, carry) = mac(t2, self.0[1], self.0[1], carry);
  649|  1.97M|        let (t3, carry) = adc(t3, 0, carry);
  650|  1.97M|        let (t4, carry) = mac(t4, self.0[2], self.0[2], carry);
  651|  1.97M|        let (t5, carry) = adc(t5, 0, carry);
  652|  1.97M|        let (t6, carry) = mac(t6, self.0[3], self.0[3], carry);
  653|  1.97M|        let (t7, carry) = adc(t7, 0, carry);
  654|  1.97M|        let (t8, carry) = mac(t8, self.0[4], self.0[4], carry);
  655|  1.97M|        let (t9, carry) = adc(t9, 0, carry);
  656|  1.97M|        let (t10, carry) = mac(t10, self.0[5], self.0[5], carry);
  657|  1.97M|        let (t11, _) = adc(t11, 0, carry);
  658|       |
  659|  1.97M|        Self::montgomery_reduce(t0, t1, t2, t3, t4, t5, t6, t7, t8, t9, t10, t11)
  660|  1.97M|    }
