  407|       |
  408|    408|    let anchor = if n_spends > 0 {
  409|    276|        Some(read_base(&mut reader, "anchor")?)
  410|       |    } else {
  411|    132|        None
  412|       |    };
  413|       |
  414|    408|    let v_spend_proofs = Array::read(&mut reader, n_spends, |r| read_zkproof(r))?;
  415|    408|    let v_spend_auth_sigs = Array::read(&mut reader, n_spends, |r| read_spend_auth_sig(r))?;
  416|    408|    let v_output_proofs = Array::read(&mut reader, n_outputs, |r| read_zkproof(r))?;
  417|       |
  418|    408|    let binding_sig = if n_spends > 0 || n_outputs > 0 {
  419|    289|        let mut sig = [0; 64];
  420|    289|        reader.read_exact(&mut sig)?;
  421|    289|        Some(redjubjub::Signature::from(sig))
  422|       |    } else {
  423|    119|        None
  424|       |    };
  425|       |
  426|    408|    let shielded_spends = sd_v5s
  427|    408|        .into_iter()
  428|    408|        .zip(v_spend_proofs.into_iter().zip(v_spend_auth_sigs))
  429|    408|        .map(|(sd_5, (zkproof, spend_auth_sig))| {
