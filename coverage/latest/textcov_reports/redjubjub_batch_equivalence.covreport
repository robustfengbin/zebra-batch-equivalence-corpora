  554|  6.27M|    pub const fn mul(&self, rhs: &Self) -> Self {
  555|       |        // Schoolbook multiplication
  556|       |
  557|  6.27M|        let (r0, carry) = mac(0, self.0[0], rhs.0[0], 0);
  558|  6.27M|        let (r1, carry) = mac(0, self.0[0], rhs.0[1], carry);
  559|  6.27M|        let (r2, carry) = mac(0, self.0[0], rhs.0[2], carry);
  560|  6.27M|        let (r3, r4) = mac(0, self.0[0], rhs.0[3], carry);
  561|       |
  562|  6.27M|        let (r1, carry) = mac(r1, self.0[1], rhs.0[0], 0);
  563|  6.27M|        let (r2, carry) = mac(r2, self.0[1], rhs.0[1], carry);
  564|  6.27M|        let (r3, carry) = mac(r3, self.0[1], rhs.0[2], carry);
  565|  6.27M|        let (r4, r5) = mac(r4, self.0[1], rhs.0[3], carry);
  566|       |
  567|  6.27M|        let (r2, carry) = mac(r2, self.0[2], rhs.0[0], 0);
  568|  6.27M|        let (r3, carry) = mac(r3, self.0[2], rhs.0[1], carry);
  569|  6.27M|        let (r4, carry) = mac(r4, self.0[2], rhs.0[2], carry);
  570|  6.27M|        let (r5, r6) = mac(r5, self.0[2], rhs.0[3], carry);
  571|       |
  572|  6.27M|        let (r3, carry) = mac(r3, self.0[3], rhs.0[0], 0);
  573|  6.27M|        let (r4, carry) = mac(r4, self.0[3], rhs.0[1], carry);
  574|  6.27M|        let (r5, carry) = mac(r5, self.0[3], rhs.0[2], carry);
  575|  6.27M|        let (r6, r7) = mac(r6, self.0[3], rhs.0[3], carry);
  576|       |
  577|  6.27M|        Scalar::montgomery_reduce(r0, r1, r2, r3, r4, r5, r6, r7)
  578|  6.27M|    }
