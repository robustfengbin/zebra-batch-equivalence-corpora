_RNvMse_NtNtCs5ei4Ir5UmKx_12pasta_curves6fields2fpNtB5_2Fp17montgomery_reduce:
  342|  35.2M|    const fn montgomery_reduce(
  343|  35.2M|        r0: u64,
  344|  35.2M|        r1: u64,
  345|  35.2M|        r2: u64,
  346|  35.2M|        r3: u64,
  347|  35.2M|        r4: u64,
  348|  35.2M|        r5: u64,
  349|  35.2M|        r6: u64,
  350|  35.2M|        r7: u64,
  351|  35.2M|    ) -> Self {
  352|       |        // The Montgomery reduction here is based on Algorithm 14.32 in
  353|       |        // Handbook of Applied Cryptography
  354|       |        // <http://cacr.uwaterloo.ca/hac/about/chap14.pdf>.
  355|       |
  356|  35.2M|        let k = r0.wrapping_mul(INV);
  357|  35.2M|        let (_, carry) = mac(r0, k, MODULUS.0[0], 0);
  358|  35.2M|        let (r1, carry) = mac(r1, k, MODULUS.0[1], carry);
  359|  35.2M|        let (r2, carry) = mac(r2, k, MODULUS.0[2], carry);
  360|  35.2M|        let (r3, carry) = mac(r3, k, MODULUS.0[3], carry);
  361|  35.2M|        let (r4, carry2) = adc(r4, 0, carry);
  362|       |
  363|  35.2M|        let k = r1.wrapping_mul(INV);
  364|  35.2M|        let (_, carry) = mac(r1, k, MODULUS.0[0], 0);
  365|  35.2M|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  366|  35.2M|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
  367|  35.2M|        let (r4, carry) = mac(r4, k, MODULUS.0[3], carry);
  368|  35.2M|        let (r5, carry2) = adc(r5, carry2, carry);
  369|       |
  370|  35.2M|        let k = r2.wrapping_mul(INV);
  371|  35.2M|        let (_, carry) = mac(r2, k, MODULUS.0[0], 0);
