  385|  12.3M|        let (d2, carry) = adc(self.0[2], rhs.0[2], carry);
  386|  12.3M|        let (d3, carry) = adc(self.0[3], rhs.0[3], carry);
  387|  12.3M|        let (d4, carry) = adc(self.0[4], rhs.0[4], carry);
  388|  12.3M|        let (d5, _) = adc(self.0[5], rhs.0[5], carry);
  389|       |
  390|       |        // Attempt to subtract the modulus, to ensure the value
  391|       |        // is smaller than the modulus.
  392|  12.3M|        (&Fp([d0, d1, d2, d3, d4, d5])).subtract_p()
  393|  12.3M|    }
