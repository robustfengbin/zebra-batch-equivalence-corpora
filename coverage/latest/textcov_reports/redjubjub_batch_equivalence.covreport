_RNvXsl_Csbwx8XpGDS8h_6jubjubRNtB5_13ExtendedPointINtNtNtCs6SNw0SRvItZ_4core3ops5arith3AddRNtB5_18ExtendedNielsPointE3add:
  887|   213k|    fn add(self, other: &'b ExtendedNielsPoint) -> ExtendedPoint {
  888|       |        // We perform addition in the extended coordinates. Here we use
  889|       |        // a formula presented by Hisil, Wong, Carter and Dawson in
  890|       |        // "Twisted Edward Curves Revisited" which only requires 8M.
  891|       |        //
  892|       |        // A = (V1 - U1) * (V2 - U2)
  893|       |        // B = (V1 + U1) * (V2 + U2)
  894|       |        // C = 2d * T1 * T2
  895|       |        // D = 2 * Z1 * Z2
  896|       |        // E = B - A
  897|       |        // F = D - C
  898|       |        // G = D + C
  899|       |        // H = B + A
  900|       |        // U3 = E * F
  901|       |        // Y3 = G * H
  902|       |        // Z3 = F * G
  903|       |        // T3 = E * H
  904|       |
  905|   213k|        let a = (self.v - self.u) * other.v_minus_u;
  906|   213k|        let b = (self.v + self.u) * other.v_plus_u;
  907|   213k|        let c = self.t1 * self.t2 * other.t2d;
  908|   213k|        let d = (self.z * other.z).double();
  909|       |
  910|       |        // The remaining arithmetic is exactly the process of converting
  911|       |        // from a completed point to an extended point.
  912|   213k|        CompletedPoint {
  913|   213k|            u: b - a,
  914|   213k|            v: b + a,
  915|   213k|            z: d + c,
  916|   213k|            t: d - c,
  917|   213k|        }
  918|   213k|        .into_extended()
  919|   213k|    }
_RNvXsm_Csbwx8XpGDS8h_6jubjubRNtB5_13ExtendedPointINtNtNtCs6SNw0SRvItZ_4core3ops5arith3SubRNtB5_18ExtendedNielsPointE3sub:
