  746|    816|    fn try_from(value: u32) -> Result<Self, Self::Error> {
  747|    816|        match value {
  748|      0|            0 => Ok(BranchId::Sprout),
  749|      0|            0x5ba8_1b19 => Ok(BranchId::Overwinter),
  750|      0|            0x76b8_09bb => Ok(BranchId::Sapling),
  751|      0|            0x2bb4_0e60 => Ok(BranchId::Blossom),
  752|      0|            0xf5b9_230b => Ok(BranchId::Heartwood),
  753|      0|            0xe9ff_75a6 => Ok(BranchId::Canopy),
  754|    210|            0xc2d6_d0b4 => Ok(BranchId::Nu5),
  755|      0|            0xc8e7_1055 => Ok(BranchId::Nu6),
  756|      0|            0x4dec_4df0 => Ok(BranchId::Nu6_1),
  757|    338|            0x5437_f330 => Ok(BranchId::Nu6_2),
  758|    268|            0x37a5_165b => Ok(BranchId::Nu6_3),
  759|       |            #[cfg(zcash_unstable = "nu7")]
  760|       |            0xffff_ffff => Ok(BranchId::Nu7),
  761|      0|            _ => Err("Unknown consensus branch ID"),
