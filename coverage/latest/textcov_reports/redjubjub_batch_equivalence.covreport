  142|    349|    let mut h = hasher(personalizations.bundle);
  143|    349|    let mut ch = hasher(personalizations.actions_compact);
  144|    349|    let mut mh = hasher(personalizations.actions_memos);
  145|    349|    let mut nh = hasher(personalizations.actions_noncompact);
  146|       |
  147|  21.8k|    for action in bundle.actions().iter() {
