  573|  25.2k|        let (_, carry) = mac(r2, k, MODULUS.0[0], 0);
  574|  25.2k|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  575|  25.2k|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  576|  25.2k|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  577|  25.2k|        let (r6, carry2) = adc(r6, carry2, carry);
  578|       |
  579|  25.2k|        let k = r3.wrapping_mul(INV);
  580|  25.2k|        let (_, carry) = mac(r3, k, MODULUS.0[0], 0);
  581|  25.2k|        let (r4, carry) = mac(r4, k, MODULUS.0[1], carry);
  582|  25.2k|        let (r5, carry) = mac(r5, k, MODULUS.0[2], carry);
  583|  25.2k|        let (r6, carry) = mac(r6, k, MODULUS.0[3], carry);
