   80|    576|    pub fn read<R: Read>(mut reader: R) -> io::Result<Self> {
   81|    576|        let header = reader.read_u32_le()?;
   82|    576|        let overwintered = (header >> 31) == 1;
   83|    576|        let version = header & 0x7FFFFFFF;
   84|       |
   85|    576|        if overwintered {
   86|    576|            match (version, reader.read_u32_le()?) {
   87|      0|                (V3_TX_VERSION, V3_VERSION_GROUP_ID) => Ok(TxVersion::V3),
   88|      0|                (V4_TX_VERSION, V4_VERSION_GROUP_ID) => Ok(TxVersion::V4),
   89|    408|                (V5_TX_VERSION, V5_VERSION_GROUP_ID) => Ok(TxVersion::V5),
   90|    168|                (V6_TX_VERSION, V6_VERSION_GROUP_ID) => Ok(TxVersion::V6),
   91|      0|                _ => Err(io::Error::new(
   92|      0|                    io::ErrorKind::InvalidData,
   93|      0|                    "Unknown transaction format",
   94|      0|                )),
   95|       |            }
   96|      0|        } else if version >= 1 {
   97|      0|            Ok(TxVersion::Sprout(version))
   98|       |        } else {
   99|      0|            Err(io::Error::new(
  100|      0|                io::ErrorKind::InvalidData,
  101|      0|                "Unknown transaction format",
  102|      0|            ))
  103|       |        }
  104|    576|    }
