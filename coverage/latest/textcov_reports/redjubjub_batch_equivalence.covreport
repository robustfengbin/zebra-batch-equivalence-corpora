  342|  29.2M|    const fn montgomery_reduce(
  343|  29.2M|        r0: u64,
  344|  29.2M|        r1: u64,
  345|  29.2M|        r2: u64,
  346|  29.2M|        r3: u64,
  347|  29.2M|        r4: u64,
  348|  29.2M|        r5: u64,
  349|  29.2M|        r6: u64,
  350|  29.2M|        r7: u64,
  351|  29.2M|    ) -> Self {
  352|       |        // The Montgomery reduction here is based on Algorithm 14.32 in
  353|       |        // Handbook of Applied Cryptography
  354|       |        // <http://cacr.uwaterloo.ca/hac/about/chap14.pdf>.
  355|       |
  356|  29.2M|        let k = r0.wrapping_mul(INV);
  357|  29.2M|        let (_, carry) = mac(r0, k, MODULUS.0[0], 0);
  358|  29.2M|        let (r1, carry) = mac(r1, k, MODULUS.0[1], carry);
  359|  29.2M|        let (r2, carry) = mac(r2, k, MODULUS.0[2], carry);
  360|  29.2M|        let (r3, carry) = mac(r3, k, MODULUS.0[3], carry);
  361|  29.2M|        let (r4, carry2) = adc(r4, 0, carry);
  362|       |
  363|  29.2M|        let k = r1.wrapping_mul(INV);
  364|  29.2M|        let (_, carry) = mac(r1, k, MODULUS.0[0], 0);
  365|  29.2M|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  366|  29.2M|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
  367|  29.2M|        let (r4, carry) = mac(r4, k, MODULUS.0[3], carry);
  368|  29.2M|        let (r5, carry2) = adc(r5, carry2, carry);
  369|       |
  370|  29.2M|        let k = r2.wrapping_mul(INV);
  371|  29.2M|        let (_, carry) = mac(r2, k, MODULUS.0[0], 0);
  372|  29.2M|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  373|  29.2M|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  374|  29.2M|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  375|  29.2M|        let (r6, carry2) = adc(r6, carry2, carry);
  376|       |
  377|  29.2M|        let k = r3.wrapping_mul(INV);
  378|  29.2M|        let (_, carry) = mac(r3, k, MODULUS.0[0], 0);
  379|  29.2M|        let (r4, carry) = mac(r4, k, MODULUS.0[1], carry);
  380|  29.2M|        let (r5, carry) = mac(r5, k, MODULUS.0[2], carry);
  381|  29.2M|        let (r6, carry) = mac(r6, k, MODULUS.0[3], carry);
  382|  29.2M|        let (r7, _) = adc(r7, carry2, carry);
  383|       |
  384|       |        // Result may be within MODULUS of the correct value
  385|  29.2M|        (&Fp([r4, r5, r6, r7])).sub(&MODULUS)
  386|  29.2M|    }
