  565|  8.87k|        let k = r1.wrapping_mul(INV);
  566|  8.87k|        let (_, carry) = mac(r1, k, MODULUS.0[0], 0);
  567|  8.87k|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  568|  8.87k|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
  569|  8.87k|        let (r4, carry) = mac(r4, k, MODULUS.0[3], carry);
  570|  8.87k|        let (r5, carry2) = adc(r5, carry2, carry);
