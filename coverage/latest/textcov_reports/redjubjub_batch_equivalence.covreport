  544|  6.74k|    const fn montgomery_reduce(
  545|  6.74k|        r0: u64,
  546|  6.74k|        r1: u64,
  547|  6.74k|        r2: u64,
  548|  6.74k|        r3: u64,
  549|  6.74k|        r4: u64,
  550|  6.74k|        r5: u64,
  551|  6.74k|        r6: u64,
  552|  6.74k|        r7: u64,
  553|  6.74k|    ) -> Self {
  554|       |        // The Montgomery reduction here is based on Algorithm 14.32 in
  555|       |        // Handbook of Applied Cryptography
  556|       |        // <http://cacr.uwaterloo.ca/hac/about/chap14.pdf>.
  557|       |
  558|  6.74k|        let k = r0.wrapping_mul(INV);
  559|  6.74k|        let (_, carry) = mac(r0, k, MODULUS.0[0], 0);
  560|  6.74k|        let (r1, carry) = mac(r1, k, MODULUS.0[1], carry);
  561|  6.74k|        let (r2, carry) = mac(r2, k, MODULUS.0[2], carry);
