  544|   189k|    const fn montgomery_reduce(
  545|   189k|        r0: u64,
  546|   189k|        r1: u64,
  547|   189k|        r2: u64,
  548|   189k|        r3: u64,
  549|   189k|        r4: u64,
  550|   189k|        r5: u64,
  551|   189k|        r6: u64,
  552|   189k|        r7: u64,
  553|   189k|    ) -> Self {
  554|       |        // The Montgomery reduction here is based on Algorithm 14.32 in
  555|       |        // Handbook of Applied Cryptography
  556|       |        // <http://cacr.uwaterloo.ca/hac/about/chap14.pdf>.
  557|       |
  558|   189k|        let k = r0.wrapping_mul(INV);
  559|   189k|        let (_, carry) = mac(r0, k, MODULUS.0[0], 0);
  560|   189k|        let (r1, carry) = mac(r1, k, MODULUS.0[1], carry);
  561|   189k|        let (r2, carry) = mac(r2, k, MODULUS.0[2], carry);
  562|   189k|        let (r3, carry) = mac(r3, k, MODULUS.0[3], carry);
  563|   189k|        let (r4, carry2) = adc(r4, 0, carry);
  564|       |
  565|   189k|        let k = r1.wrapping_mul(INV);
  566|   189k|        let (_, carry) = mac(r1, k, MODULUS.0[0], 0);
  567|   189k|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  568|   189k|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
  569|   189k|        let (r4, carry) = mac(r4, k, MODULUS.0[3], carry);
  570|   189k|        let (r5, carry2) = adc(r5, carry2, carry);
  571|       |
  572|   189k|        let k = r2.wrapping_mul(INV);
  573|   189k|        let (_, carry) = mac(r2, k, MODULUS.0[0], 0);
  574|   189k|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  575|   189k|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  576|   189k|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  577|   189k|        let (r6, carry2) = adc(r6, carry2, carry);
  578|       |
  579|   189k|        let k = r3.wrapping_mul(INV);
  580|   189k|        let (_, carry) = mac(r3, k, MODULUS.0[0], 0);
  581|   189k|        let (r4, carry) = mac(r4, k, MODULUS.0[1], carry);
  582|   189k|        let (r5, carry) = mac(r5, k, MODULUS.0[2], carry);
  583|   189k|        let (r6, carry) = mac(r6, k, MODULUS.0[3], carry);
  584|   189k|        let (r7, _) = adc(r7, carry2, carry);
