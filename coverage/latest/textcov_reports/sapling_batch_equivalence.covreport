_RNvMse_NtNtCs5ei4Ir5UmKx_12pasta_curves6fields2fpNtB5_2Fp17montgomery_reduce:
  342|   205M|    const fn montgomery_reduce(
  343|   205M|        r0: u64,
  344|   205M|        r1: u64,
  345|   205M|        r2: u64,
  346|   205M|        r3: u64,
  347|   205M|        r4: u64,
  348|   205M|        r5: u64,
  349|   205M|        r6: u64,
  350|   205M|        r7: u64,
  351|   205M|    ) -> Self {
  352|       |        // The Montgomery reduction here is based on Algorithm 14.32 in
  353|       |        // Handbook of Applied Cryptography
  354|       |        // <http://cacr.uwaterloo.ca/hac/about/chap14.pdf>.
  355|       |
  356|   205M|        let k = r0.wrapping_mul(INV);
  357|   205M|        let (_, carry) = mac(r0, k, MODULUS.0[0], 0);
  358|   205M|        let (r1, carry) = mac(r1, k, MODULUS.0[1], carry);
  359|   205M|        let (r2, carry) = mac(r2, k, MODULUS.0[2], carry);
  360|   205M|        let (r3, carry) = mac(r3, k, MODULUS.0[3], carry);
  361|   205M|        let (r4, carry2) = adc(r4, 0, carry);
  362|       |
  363|   205M|        let k = r1.wrapping_mul(INV);
  364|   205M|        let (_, carry) = mac(r1, k, MODULUS.0[0], 0);
  365|   205M|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  366|   205M|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
  367|   205M|        let (r4, carry) = mac(r4, k, MODULUS.0[3], carry);
  368|   205M|        let (r5, carry2) = adc(r5, carry2, carry);
  369|       |
  370|   205M|        let k = r2.wrapping_mul(INV);
  371|   205M|        let (_, carry) = mac(r2, k, MODULUS.0[0], 0);
  372|   205M|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  373|   205M|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  374|   205M|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  375|   205M|        let (r6, carry2) = adc(r6, carry2, carry);
  376|       |
  377|   205M|        let k = r3.wrapping_mul(INV);
  378|   205M|        let (_, carry) = mac(r3, k, MODULUS.0[0], 0);
  379|   205M|        let (r4, carry) = mac(r4, k, MODULUS.0[1], carry);
  380|   205M|        let (r5, carry) = mac(r5, k, MODULUS.0[2], carry);
  381|   205M|        let (r6, carry) = mac(r6, k, MODULUS.0[3], carry);
  382|   205M|        let (r7, _) = adc(r7, carry2, carry);
  383|       |
  384|       |        // Result may be within MODULUS of the correct value
  385|   205M|        (&Fp([r4, r5, r6, r7])).sub(&MODULUS)
  386|   205M|    }
