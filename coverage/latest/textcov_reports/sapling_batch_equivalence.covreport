  630|  97.8M|        let (t8, t9) = mac(t8, self.0[3], self.0[5], carry);
  631|       |
  632|  97.8M|        let (t9, t10) = mac(t9, self.0[4], self.0[5], 0);
  633|       |
  634|  97.8M|        let t11 = t10 >> 63;
  635|  97.8M|        let t10 = (t10 << 1) | (t9 >> 63);
  636|  97.8M|        let t9 = (t9 << 1) | (t8 >> 63);
  637|  97.8M|        let t8 = (t8 << 1) | (t7 >> 63);
  638|  97.8M|        let t7 = (t7 << 1) | (t6 >> 63);
  639|  97.8M|        let t6 = (t6 << 1) | (t5 >> 63);
  640|  97.8M|        let t5 = (t5 << 1) | (t4 >> 63);
  641|  97.8M|        let t4 = (t4 << 1) | (t3 >> 63);
