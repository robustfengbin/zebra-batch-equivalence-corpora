  607|      8|pub fn pairing(p: &G1Affine, q: &G2Affine) -> Gt {
  608|       |    struct Adder {
  609|       |        cur: G2Projective,
  610|       |        base: G2Affine,
  611|       |        p: G1Affine,
  612|       |    }
  613|       |
  614|       |    impl MillerLoopDriver for Adder {
  615|       |        type Output = Fp12;
