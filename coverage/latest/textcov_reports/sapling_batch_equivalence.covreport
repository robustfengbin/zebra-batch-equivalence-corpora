  613|  97.8M|    pub const fn square(&self) -> Self {
  614|  97.8M|        let (t1, carry) = mac(0, self.0[0], self.0[1], 0);
  615|  97.8M|        let (t2, carry) = mac(0, self.0[0], self.0[2], carry);
  616|  97.8M|        let (t3, carry) = mac(0, self.0[0], self.0[3], carry);
  617|  97.8M|        let (t4, carry) = mac(0, self.0[0], self.0[4], carry);
  618|  97.8M|        let (t5, t6) = mac(0, self.0[0], self.0[5], carry);
  619|       |
  620|  97.8M|        let (t3, carry) = mac(t3, self.0[1], self.0[2], 0);
  621|  97.8M|        let (t4, carry) = mac(t4, self.0[1], self.0[3], carry);
  622|  97.8M|        let (t5, carry) = mac(t5, self.0[1], self.0[4], carry);
  623|  97.8M|        let (t6, t7) = mac(t6, self.0[1], self.0[5], carry);
  624|       |
  625|  97.8M|        let (t5, carry) = mac(t5, self.0[2], self.0[3], 0);
  626|  97.8M|        let (t6, carry) = mac(t6, self.0[2], self.0[4], carry);
  627|  97.8M|        let (t7, t8) = mac(t7, self.0[2], self.0[5], carry);
  628|       |
