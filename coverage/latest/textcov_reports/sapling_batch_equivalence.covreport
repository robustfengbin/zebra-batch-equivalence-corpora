_RNvMsu_NtCsaKH4ngBG85u_9bls12_3812g2NtB5_12G2Projective3add:
  741|   221k|    pub fn add(&self, rhs: &G2Projective) -> G2Projective {
  742|       |        // Algorithm 7, https://eprint.iacr.org/2015/1060.pdf
  743|       |
  744|   221k|        let t0 = self.x * rhs.x;
  745|   221k|        let t1 = self.y * rhs.y;
  746|   221k|        let t2 = self.z * rhs.z;
  747|   221k|        let t3 = self.x + self.y;
  748|   221k|        let t4 = rhs.x + rhs.y;
  749|   221k|        let t3 = t3 * t4;
  750|   221k|        let t4 = t0 + t1;
  751|   221k|        let t3 = t3 - t4;
  752|   221k|        let t4 = self.y + self.z;
  753|   221k|        let x3 = rhs.y + rhs.z;
  754|   221k|        let t4 = t4 * x3;
  755|   221k|        let x3 = t1 + t2;
  756|   221k|        let t4 = t4 - x3;
  757|   221k|        let x3 = self.x + self.z;
  758|   221k|        let y3 = rhs.x + rhs.z;
  759|   221k|        let x3 = x3 * y3;
  760|   221k|        let y3 = t0 + t2;
  761|   221k|        let y3 = x3 - y3;
  762|   221k|        let x3 = t0 + t0;
  763|   221k|        let t0 = x3 + t0;
  764|   221k|        let t2 = mul_by_3b(t2);
  765|   221k|        let z3 = t1 + t2;
  766|   221k|        let t1 = t1 - t2;
  767|   221k|        let y3 = mul_by_3b(y3);
  768|   221k|        let x3 = t4 * y3;
  769|   221k|        let t2 = t3 * t1;
  770|   221k|        let x3 = t2 - x3;
  771|   221k|        let y3 = y3 * t0;
  772|   221k|        let t1 = t1 * z3;
  773|   221k|        let y3 = t1 + y3;
  774|   221k|        let t0 = t0 * t3;
  775|   221k|        let z3 = z3 * t4;
  776|   221k|        let z3 = z3 + t0;
  777|       |
  778|   221k|        G2Projective {
  779|   221k|            x: x3,
  780|   221k|            y: y3,
  781|   221k|            z: z3,
  782|   221k|        }
  783|   221k|    }
