  188|       |        //
  189|       |        // In BLS12-381's F_{p^2}, our \beta is -1 so we
  190|       |        // can modify this formula:
  191|       |        //
  192|       |        // c0' = (c0 + c1) * (c0 - c1)
  193|       |        // c1' = 2 * c0 * c1
  194|       |
  195|  60.6M|        let a = (&self.c0).add(&self.c1);
  196|  60.6M|        let b = (&self.c0).sub(&self.c1);
