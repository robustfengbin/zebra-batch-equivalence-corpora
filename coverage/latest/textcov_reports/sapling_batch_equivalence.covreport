  350|      2|pub fn parse_parameters<R: io::Read>(
  351|      2|    spend_fs: R,
  352|      2|    output_fs: R,
  353|      2|    sprout_fs: Option<R>,
  354|      2|) -> ZcashParameters {
  355|      2|    let mut spend_fs = hashreader::HashReader::new(spend_fs);
  356|      2|    let mut output_fs = hashreader::HashReader::new(output_fs);
  357|      2|    let mut sprout_fs = sprout_fs.map(hashreader::HashReader::new);
  358|       |
  359|       |    // Deserialize params
  360|      2|    let spend_params = SpendParameters::read(&mut spend_fs, false)
  361|      2|        .expect("couldn't deserialize Sapling spend parameters");
  362|      2|    let output_params = OutputParameters::read(&mut output_fs, false)
  363|      2|        .expect("couldn't deserialize Sapling spend parameters");
  364|       |
  365|       |    // We only deserialize the verifying key for the Sprout parameters, which
  366|       |    // appears at the beginning of the parameter file. The rest is loaded
  367|       |    // during proving time.
  368|      2|    let sprout_vk = sprout_fs.as_mut().map(|fs| {
  369|       |        VerifyingKey::<Bls12>::read(fs).expect("couldn't deserialize Sprout Groth16 verifying key")
  370|       |    });
  371|       |
  372|       |    // There is extra stuff (the transcript) at the end of the parameter file which is
  373|       |    // used to verify the parameter validity, but we're not interested in that. We do
  374|       |    // want to read it, though, so that the BLAKE2b computed afterward is consistent
  375|       |    // with `b2sum` on the files.
  376|      2|    let mut sink = io::sink();
  377|       |
  378|       |    // TODO: use the correct paths for Windows and macOS
  379|       |    //       use the actual file paths supplied by the caller
  380|      2|    verify_hash(
  381|      2|        spend_fs,
  382|      2|        &mut sink,
  383|      2|        SAPLING_SPEND_HASH,
  384|       |        SAPLING_SPEND_BYTES,
  385|      2|        SAPLING_SPEND_NAME,
  386|      2|        "a file",
  387|       |    )
  388|      2|    .expect(
  389|      2|        "Sapling spend parameter file is not correct, \
  390|      2|         please clean your `~/.zcash-params/` and re-run `fetch-params`.",
  391|       |    );
  392|       |
  393|      2|    verify_hash(
  394|      2|        output_fs,
  395|      2|        &mut sink,
  396|      2|        SAPLING_OUTPUT_HASH,
  397|       |        SAPLING_OUTPUT_BYTES,
  398|      2|        SAPLING_OUTPUT_NAME,
  399|      2|        "a file",
  400|       |    )
  401|      2|    .expect(
  402|      2|        "Sapling output parameter file is not correct, \
  403|      2|         please clean your `~/.zcash-params/` and re-run `fetch-params`.",
  404|       |    );
  405|       |
  406|      2|    if let Some(sprout_fs) = sprout_fs {
  407|      0|        verify_hash(
  408|      0|            sprout_fs,
  409|      0|            &mut sink,
  410|      0|            SPROUT_HASH,
  411|      0|            SPROUT_BYTES,
  412|      0|            SPROUT_NAME,
  413|      0|            "a file",
  414|      0|        )
  415|      0|        .expect(
  416|      0|            "Sprout groth16 parameter file is not correct, \
  417|      0|             please clean your `~/.zcash-params/` and re-run `fetch-params`.",
  418|      0|        );
  419|      2|    }
  420|       |
  421|       |    // Prepare verifying keys
  422|      2|    let spend_vk = spend_params.prepared_verifying_key();
  423|      2|    let output_vk = output_params.prepared_verifying_key();
  424|      2|    let sprout_vk = sprout_vk.map(|vk| prepare_verifying_key(&vk));
  425|       |
  426|      2|    ZcashParameters {
  427|      2|        spend_params,
  428|      2|        spend_vk,
  429|      2|        output_params,
  430|      2|        output_vk,
  431|      2|        sprout_vk,
  432|      2|    }
  433|      2|}

