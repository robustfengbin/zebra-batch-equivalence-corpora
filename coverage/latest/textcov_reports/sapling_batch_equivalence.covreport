  777|   146k|    fn mul_by_x(&self) -> G1Projective {
  778|   146k|        let mut xself = G1Projective::identity();
  779|       |        // NOTE: in BLS12-381 we can just skip the first bit.
  780|   146k|        let mut x = crate::BLS_X >> 1;
  781|   146k|        let mut tmp = *self;
  782|  9.39M|        while x != 0 {
  783|  9.24M|            tmp = tmp.double();
  784|       |
  785|  9.24M|            if x % 2 == 1 {
  786|   880k|                xself += tmp;
  787|  8.36M|            }
  788|  9.24M|            x >>= 1;
  789|       |        }
  790|       |        // finally, flip the sign
  791|   146k|        if crate::BLS_X_IS_NEGATIVE {
  792|   146k|            xself = -xself;
  793|   146k|        }
  794|   146k|        xself
  795|   146k|    }
