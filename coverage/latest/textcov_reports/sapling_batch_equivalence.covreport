_RNvMsu_NtCsaKH4ngBG85u_9bls12_3812g2NtB5_12G2Projective6double:
  709|  2.32M|    pub fn double(&self) -> G2Projective {
  710|       |        // Algorithm 9, https://eprint.iacr.org/2015/1060.pdf
  711|       |
  712|  2.32M|        let t0 = self.y.square();
  713|  2.32M|        let z3 = t0 + t0;
  714|  2.32M|        let z3 = z3 + z3;
  715|  2.32M|        let z3 = z3 + z3;
