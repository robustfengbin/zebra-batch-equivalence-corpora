  276|   807k|        let infinity_flag_set = Choice::from((bytes[0] >> 6) & 1);
  277|   807k|        let sort_flag_set = Choice::from((bytes[0] >> 5) & 1);
  278|       |
  279|       |        // Attempt to obtain the x-coordinate
  280|   807k|        let x = {
  281|   807k|            let mut tmp = [0; 48];
