  560|  57.1k|        let (r1, carry) = mac(r1, k, MODULUS.0[1], carry);
  561|  57.1k|        let (r2, carry) = mac(r2, k, MODULUS.0[2], carry);
  562|  57.1k|        let (r3, carry) = mac(r3, k, MODULUS.0[3], carry);
  563|  57.1k|        let (r4, carry2) = adc(r4, 0, carry);
  564|       |
  565|  57.1k|        let k = r1.wrapping_mul(INV);
  566|  57.1k|        let (_, carry) = mac(r1, k, MODULUS.0[0], 0);
  567|  57.1k|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  568|  57.1k|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
  569|  57.1k|        let (r4, carry) = mac(r4, k, MODULUS.0[3], carry);
  570|  57.1k|        let (r5, carry2) = adc(r5, carry2, carry);
