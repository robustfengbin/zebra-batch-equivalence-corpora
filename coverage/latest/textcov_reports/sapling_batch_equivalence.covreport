  246|  13.4k|                    [b.c0.c0, b.c0.c1, b20_m_b21, b20_p_b21, b10_m_b11, b10_p_b11],
  247|  13.4k|                ),
  248|  13.4k|                c1: Fp::sum_of_products(
  249|  13.4k|                    [a.c0.c0, a.c0.c1, a.c1.c0, a.c1.c1, a.c2.c0, a.c2.c1],
  250|  13.4k|                    [b.c0.c1, b.c0.c0, b20_p_b21, b20_m_b21, b10_p_b11, b10_m_b11],
  251|  13.4k|                ),
  252|  13.4k|            },
  253|  13.4k|            c1: Fp2 {
  254|  13.4k|                c0: Fp::sum_of_products(
  255|  13.4k|                    [a.c0.c0, -a.c0.c1, a.c1.c0, -a.c1.c1, a.c2.c0, -a.c2.c1],
  256|  13.4k|                    [b.c1.c0, b.c1.c1, b.c0.c0, b.c0.c1, b20_m_b21, b20_p_b21],
  257|  13.4k|                ),
  258|  13.4k|                c1: Fp::sum_of_products(
  259|  13.4k|                    [a.c0.c0, a.c0.c1, a.c1.c0, a.c1.c1, a.c2.c0, a.c2.c1],
  260|  13.4k|                    [b.c1.c1, b.c1.c0, b.c0.c1, b.c0.c0, b20_p_b21, b20_m_b21],
  261|  13.4k|                ),
  262|  13.4k|            },
  263|  13.4k|            c2: Fp2 {
  264|  13.4k|                c0: Fp::sum_of_products(
  265|  13.4k|                    [a.c0.c0, -a.c0.c1, a.c1.c0, -a.c1.c1, a.c2.c0, -a.c2.c1],
  266|  13.4k|                    [b.c2.c0, b.c2.c1, b.c1.c0, b.c1.c1, b.c0.c0, b.c0.c1],
  267|  13.4k|                ),
  268|  13.4k|                c1: Fp::sum_of_products(
  269|  13.4k|                    [a.c0.c0, a.c0.c1, a.c1.c0, a.c1.c1, a.c2.c0, a.c2.c1],
  270|  13.4k|                    [b.c2.c1, b.c2.c0, b.c1.c1, b.c1.c0, b.c0.c1, b.c0.c0],
  271|  13.4k|                ),
  272|  13.4k|            },
  273|  13.4k|        }
