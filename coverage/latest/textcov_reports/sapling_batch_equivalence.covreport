  518|       |    unsafe impl Sync for GuardWrapper {}
  519|       |    static UNPROTECTED: GuardWrapper = GuardWrapper(Guard {
  520|       |        local: core::ptr::null(),
  521|       |    });
  522|      9|    &UNPROTECTED.0
  523|      9|}
