  670|  19.5M|    pub fn add(&self, rhs: &G1Projective) -> G1Projective {
  671|       |        // Algorithm 7, https://eprint.iacr.org/2015/1060.pdf
  672|       |
  673|  19.5M|        let t0 = self.x * rhs.x;
  674|  19.5M|        let t1 = self.y * rhs.y;
  675|  19.5M|        let t2 = self.z * rhs.z;
  676|  19.5M|        let t3 = self.x + self.y;
  677|  19.5M|        let t4 = rhs.x + rhs.y;
  678|  19.5M|        let t3 = t3 * t4;
  679|  19.5M|        let t4 = t0 + t1;
  680|  19.5M|        let t3 = t3 - t4;
  681|  19.5M|        let t4 = self.y + self.z;
  682|  19.5M|        let x3 = rhs.y + rhs.z;
  683|  19.5M|        let t4 = t4 * x3;
  684|  19.5M|        let x3 = t1 + t2;
  685|  19.5M|        let t4 = t4 - x3;
  686|  19.5M|        let x3 = self.x + self.z;
  687|  19.5M|        let y3 = rhs.x + rhs.z;
  688|  19.5M|        let x3 = x3 * y3;
  689|  19.5M|        let y3 = t0 + t2;
  690|  19.5M|        let y3 = x3 - y3;
  691|  19.5M|        let x3 = t0 + t0;
  692|  19.5M|        let t0 = x3 + t0;
  693|  19.5M|        let t2 = mul_by_3b(t2);
  694|  19.5M|        let z3 = t1 + t2;
  695|  19.5M|        let t1 = t1 - t2;
  696|  19.5M|        let y3 = mul_by_3b(y3);
  697|  19.5M|        let x3 = t4 * y3;
  698|  19.5M|        let t2 = t3 * t1;
  699|  19.5M|        let x3 = t2 - x3;
  700|  19.5M|        let y3 = y3 * t0;
  701|  19.5M|        let t1 = t1 * z3;
  702|  19.5M|        let y3 = t1 + y3;
  703|  19.5M|        let t0 = t0 * t3;
  704|  19.5M|        let z3 = z3 * t4;
  705|  19.5M|        let z3 = z3 + t0;
  706|       |
  707|  19.5M|        G1Projective {
  708|  19.5M|            x: x3,
  709|  19.5M|            y: y3,
  710|  19.5M|            z: z3,
  711|  19.5M|        }
  712|  19.5M|    }
