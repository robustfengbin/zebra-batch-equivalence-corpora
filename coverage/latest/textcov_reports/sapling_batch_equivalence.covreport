  709|  2.16M|fn doubling_step(r: &mut G2Projective) -> (Fp2, Fp2, Fp2) {
  710|       |    // Adaptation of Algorithm 26, https://eprint.iacr.org/2010/354.pdf
  711|  2.16M|    let tmp0 = r.x.square();
