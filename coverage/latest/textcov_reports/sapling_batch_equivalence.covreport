_RNvMsa_NtCsaKH4ngBG85u_9bls12_3813fp2NtB5_3Fp225lexicographically_largestB7_:
  171|  36.8k|    pub fn lexicographically_largest(&self) -> Choice {
  172|       |        // If this element's c1 coefficient is lexicographically largest
  173|       |        // then it is lexicographically largest. Otherwise, in the event
  174|       |        // the c1 coefficient is zero and the c0 coefficient is
  175|       |        // lexicographically largest, then this element is lexicographically
  176|       |        // largest.
  177|       |
  178|  36.8k|        self.c1.lexicographically_largest()
  179|  36.8k|            | (self.c1.is_zero() & self.c0.lexicographically_largest())
  180|  36.8k|    }
