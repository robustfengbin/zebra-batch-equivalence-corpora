  574|  57.1k|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  575|  57.1k|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  576|  57.1k|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  577|  57.1k|        let (r6, carry2) = adc(r6, carry2, carry);
  578|       |
  579|  57.1k|        let k = r3.wrapping_mul(INV);
  580|  57.1k|        let (_, carry) = mac(r3, k, MODULUS.0[0], 0);
  581|  57.1k|        let (r4, carry) = mac(r4, k, MODULUS.0[1], carry);
  582|  57.1k|        let (r5, carry) = mac(r5, k, MODULUS.0[2], carry);
  583|  57.1k|        let (r6, carry) = mac(r6, k, MODULUS.0[3], carry);
