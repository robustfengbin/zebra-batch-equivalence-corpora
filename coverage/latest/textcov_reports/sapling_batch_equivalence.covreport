  392|       |
  393|  33.8M|        let (r0, carry) = mac(0, self.0[0], rhs.0[0], 0);
  394|  33.8M|        let (r1, carry) = mac(0, self.0[0], rhs.0[1], carry);
  395|  33.8M|        let (r2, carry) = mac(0, self.0[0], rhs.0[2], carry);
  396|  33.8M|        let (r3, r4) = mac(0, self.0[0], rhs.0[3], carry);
  397|       |
  398|  33.8M|        let (r1, carry) = mac(r1, self.0[1], rhs.0[0], 0);
  399|  33.8M|        let (r2, carry) = mac(r2, self.0[1], rhs.0[1], carry);
  400|  33.8M|        let (r3, carry) = mac(r3, self.0[1], rhs.0[2], carry);
  401|  33.8M|        let (r4, r5) = mac(r4, self.0[1], rhs.0[3], carry);
  402|       |
  403|  33.8M|        let (r2, carry) = mac(r2, self.0[2], rhs.0[0], 0);
  404|  33.8M|        let (r3, carry) = mac(r3, self.0[2], rhs.0[1], carry);
  405|  33.8M|        let (r4, carry) = mac(r4, self.0[2], rhs.0[2], carry);
  406|  33.8M|        let (r5, r6) = mac(r5, self.0[2], rhs.0[3], carry);
  407|       |
  408|  33.8M|        let (r3, carry) = mac(r3, self.0[3], rhs.0[0], 0);
  409|  33.8M|        let (r4, carry) = mac(r4, self.0[3], rhs.0[1], carry);
  410|  33.8M|        let (r5, carry) = mac(r5, self.0[3], rhs.0[2], carry);
  411|  33.8M|        let (r6, r7) = mac(r6, self.0[3], rhs.0[3], carry);
  412|       |
