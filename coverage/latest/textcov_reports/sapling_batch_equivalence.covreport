  743|       |
  744|   250k|        let t0 = self.x * rhs.x;
  745|   250k|        let t1 = self.y * rhs.y;
  746|   250k|        let t2 = self.z * rhs.z;
  747|   250k|        let t3 = self.x + self.y;
  748|   250k|        let t4 = rhs.x + rhs.y;
  749|   250k|        let t3 = t3 * t4;
  750|   250k|        let t4 = t0 + t1;
  751|   250k|        let t3 = t3 - t4;
  752|   250k|        let t4 = self.y + self.z;
  753|   250k|        let x3 = rhs.y + rhs.z;
  754|   250k|        let t4 = t4 * x3;
  755|   250k|        let x3 = t1 + t2;
  756|   250k|        let t4 = t4 - x3;
  757|   250k|        let x3 = self.x + self.z;
  758|   250k|        let y3 = rhs.x + rhs.z;
  759|   250k|        let x3 = x3 * y3;
  760|   250k|        let y3 = t0 + t2;
  761|   250k|        let y3 = x3 - y3;
  762|   250k|        let x3 = t0 + t0;
  763|   250k|        let t0 = x3 + t0;
  764|   250k|        let t2 = mul_by_3b(t2);
  765|   250k|        let z3 = t1 + t2;
  766|   250k|        let t1 = t1 - t2;
  767|   250k|        let y3 = mul_by_3b(y3);
  768|   250k|        let x3 = t4 * y3;
  769|   250k|        let t2 = t3 * t1;
  770|   250k|        let x3 = t2 - x3;
  771|   250k|        let y3 = y3 * t0;
  772|   250k|        let t1 = t1 * z3;
  773|   250k|        let y3 = t1 + y3;
  774|   250k|        let t0 = t0 * t3;
  775|   250k|        let z3 = z3 * t4;
  776|   250k|        let z3 = z3 + t0;
