  647|      8|    let tmp = MillerLoopResult(Fp12::conditional_select(
  648|      8|        &tmp,
  649|      8|        &Fp12::one(),
  650|      8|        either_identity,
  651|      8|    ));
  652|      8|    tmp.final_exponentiation()
  653|      8|}
