  648|  28.9M|        let x3 = t2 * z3;
  649|  28.9M|        let y3 = t0 + t2;
  650|  28.9M|        let z3 = t1 * z3;
  651|  28.9M|        let t1 = t2 + t2;
  652|  28.9M|        let t2 = t1 + t2;
  653|  28.9M|        let t0 = t0 - t2;
  654|  28.9M|        let y3 = t0 * y3;
  655|  28.9M|        let y3 = x3 + y3;
  656|  28.9M|        let t1 = self.x * self.y;
  657|  28.9M|        let x3 = t0 * t1;
  658|  28.9M|        let x3 = x3 + x3;
