  648|  97.8M|        let (t2, carry) = mac(t2, self.0[1], self.0[1], carry);
  649|  97.8M|        let (t3, carry) = adc(t3, 0, carry);
  650|  97.8M|        let (t4, carry) = mac(t4, self.0[2], self.0[2], carry);
  651|  97.8M|        let (t5, carry) = adc(t5, 0, carry);
  652|  97.8M|        let (t6, carry) = mac(t6, self.0[3], self.0[3], carry);
  653|  97.8M|        let (t7, carry) = adc(t7, 0, carry);
  654|  97.8M|        let (t8, carry) = mac(t8, self.0[4], self.0[4], carry);
  655|  97.8M|        let (t9, carry) = adc(t9, 0, carry);
  656|  97.8M|        let (t10, carry) = mac(t10, self.0[5], self.0[5], carry);
