  352|  3.15M|        let r6 = (r6 << 1) | (r5 >> 63);
  353|  3.15M|        let r5 = (r5 << 1) | (r4 >> 63);
  354|  3.15M|        let r4 = (r4 << 1) | (r3 >> 63);
  355|  3.15M|        let r3 = (r3 << 1) | (r2 >> 63);
  356|  3.15M|        let r2 = (r2 << 1) | (r1 >> 63);
  357|  3.15M|        let r1 = r1 << 1;
  358|       |
  359|  3.15M|        let (r0, carry) = mac(0, self.0[0], self.0[0], 0);
  360|  3.15M|        let (r1, carry) = adc(0, r1, carry);
  361|  3.15M|        let (r2, carry) = mac(r2, self.0[1], self.0[1], carry);
  362|  3.15M|        let (r3, carry) = adc(0, r3, carry);
  363|  3.15M|        let (r4, carry) = mac(r4, self.0[2], self.0[2], carry);
  364|  3.15M|        let (r5, carry) = adc(0, r5, carry);
  365|  3.15M|        let (r6, carry) = mac(r6, self.0[3], self.0[3], carry);
  366|  3.15M|        let (r7, _) = adc(0, r7, carry);
  367|       |
  368|  3.15M|        Scalar::montgomery_reduce(r0, r1, r2, r3, r4, r5, r6, r7)
  369|  3.15M|    }
