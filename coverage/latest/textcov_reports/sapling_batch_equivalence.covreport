  342|  3.15M|        let (r1, carry) = mac(0, self.0[0], self.0[1], 0);
  343|  3.15M|        let (r2, carry) = mac(0, self.0[0], self.0[2], carry);
  344|  3.15M|        let (r3, r4) = mac(0, self.0[0], self.0[3], carry);
  345|       |
  346|  3.15M|        let (r3, carry) = mac(r3, self.0[1], self.0[2], 0);
  347|  3.15M|        let (r4, r5) = mac(r4, self.0[1], self.0[3], carry);
  348|       |
  349|  3.15M|        let (r5, r6) = mac(r5, self.0[2], self.0[3], 0);
  350|       |
