   68|   505k|            let mut z4 = f.c0.c1;
   69|   505k|            let mut z3 = f.c0.c2;
   70|   505k|            let mut z2 = f.c1.c0;
   71|   505k|            let mut z1 = f.c1.c1;
   72|   505k|            let mut z5 = f.c1.c2;
