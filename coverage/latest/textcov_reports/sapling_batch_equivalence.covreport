  544|   180k|    fn pow_vartime<S: AsRef<[u64]>>(&self, exp: S) -> Self {
  545|   180k|        let mut res = Self::one();
  546|   180k|        let mut found_one = false;
  547|   720k|        for e in exp.as_ref().iter().rev() {
  548|  46.1M|            for i in (0..64).rev() {
  549|  46.1M|                if found_one {
  550|  45.7M|                    res = res.square();
  551|  45.7M|                }
  552|       |
  553|  46.1M|                if ((*e >> i) & 1) == 1 {
  554|  13.8M|                    found_one = true;
  555|  13.8M|                    res *= self;
  556|  32.2M|                }
  557|       |            }
  558|       |        }
