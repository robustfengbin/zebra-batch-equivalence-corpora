  407|   410M|            as u64)
  408|   410M|            .wrapping_sub(1);
  409|       |
  410|   410M|        Fp([
  411|   410M|            d0 & mask,
  412|   410M|            d1 & mask,
  413|   410M|            d2 & mask,
  414|   410M|            d3 & mask,
  415|   410M|            d4 & mask,
  416|   410M|            d5 & mask,
