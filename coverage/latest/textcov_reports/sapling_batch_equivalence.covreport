  723|  2.16M|    let tmp2 = tmp2 + tmp2;
  724|  2.16M|    let tmp2 = tmp2 + tmp2;
  725|  2.16M|    let tmp2 = tmp2 + tmp2;
  726|  2.16M|    r.y -= tmp2;
