  620|   224k|    pub const fn sub(&self, rhs: &Self) -> Self {
  621|   224k|        let (d0, borrow) = sbb(self.0[0], rhs.0[0], 0);
  622|   224k|        let (d1, borrow) = sbb(self.0[1], rhs.0[1], borrow);
  623|   224k|        let (d2, borrow) = sbb(self.0[2], rhs.0[2], borrow);
