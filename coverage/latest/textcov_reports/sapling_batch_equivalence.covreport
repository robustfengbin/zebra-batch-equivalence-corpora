  506|   279M|    const fn montgomery_reduce(
  507|   279M|        r0: u64,
  508|   279M|        r1: u64,
  509|   279M|        r2: u64,
  510|   279M|        r3: u64,
  511|   279M|        r4: u64,
  512|   279M|        r5: u64,
  513|   279M|        r6: u64,
  514|   279M|        r7: u64,
  515|   279M|    ) -> Self {
  516|       |        // The Montgomery reduction here is based on Algorithm 14.32 in
  517|       |        // Handbook of Applied Cryptography
  518|       |        // <http://cacr.uwaterloo.ca/hac/about/chap14.pdf>.
  519|       |
  520|   279M|        let k = r0.wrapping_mul(INV);
  521|   279M|        let (_, carry) = mac(r0, k, MODULUS.0[0], 0);
  522|   279M|        let (r1, carry) = mac(r1, k, MODULUS.0[1], carry);
  523|   279M|        let (r2, carry) = mac(r2, k, MODULUS.0[2], carry);
  524|   279M|        let (r3, carry) = mac(r3, k, MODULUS.0[3], carry);
  525|   279M|        let (r4, carry2) = adc(r4, 0, carry);
  526|       |
  527|   279M|        let k = r1.wrapping_mul(INV);
  528|   279M|        let (_, carry) = mac(r1, k, MODULUS.0[0], 0);
  529|   279M|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  530|   279M|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
  531|   279M|        let (r4, carry) = mac(r4, k, MODULUS.0[3], carry);
  532|   279M|        let (r5, carry2) = adc(r5, carry2, carry);
  533|       |
  534|   279M|        let k = r2.wrapping_mul(INV);
  535|   279M|        let (_, carry) = mac(r2, k, MODULUS.0[0], 0);
  536|   279M|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  537|   279M|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  538|   279M|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  539|   279M|        let (r6, carry2) = adc(r6, carry2, carry);
  540|       |
  541|   279M|        let k = r3.wrapping_mul(INV);
  542|   279M|        let (_, carry) = mac(r3, k, MODULUS.0[0], 0);
  543|   279M|        let (r4, carry) = mac(r4, k, MODULUS.0[1], carry);
  544|   279M|        let (r5, carry) = mac(r5, k, MODULUS.0[2], carry);
  545|   279M|        let (r6, carry) = mac(r6, k, MODULUS.0[3], carry);
  546|   279M|        let (r7, _) = adc(r7, carry2, carry);
  547|       |
  548|       |        // Result may be within MODULUS of the correct value
  549|   279M|        (&Scalar([r4, r5, r6, r7])).sub(&MODULUS)
  550|   279M|    }
