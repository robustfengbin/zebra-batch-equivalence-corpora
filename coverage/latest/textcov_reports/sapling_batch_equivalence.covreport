  638|  28.9M|    pub fn double(&self) -> G1Projective {
  639|       |        // Algorithm 9, https://eprint.iacr.org/2015/1060.pdf
  640|       |
  641|  28.9M|        let t0 = self.y.square();
  642|  28.9M|        let z3 = t0 + t0;
