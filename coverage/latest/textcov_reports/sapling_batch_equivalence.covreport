   76|       |            // For A
   77|   505k|            z0 = t0 - z0;
   78|   505k|            z0 = z0 + z0 + t0;
   79|       |
   80|   505k|            z1 = t1 + z1;
   81|   505k|            z1 = z1 + z1 + t1;
   82|       |
   83|   505k|            let (mut t0, t1) = fp4_square(z2, z3);
   84|   505k|            let (t2, t3) = fp4_square(z4, z5);
