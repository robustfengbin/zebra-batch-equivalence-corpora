  436|   488k|    pub const fn add(&self, rhs: &Self) -> Self {
  437|   488k|        let (d0, carry) = adc(self.0[0], rhs.0[0], 0);
  438|   488k|        let (d1, carry) = adc(self.0[1], rhs.0[1], carry);
