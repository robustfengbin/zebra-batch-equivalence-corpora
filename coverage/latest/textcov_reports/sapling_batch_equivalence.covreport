  356|   233M|        let k = r0.wrapping_mul(INV);
  357|   233M|        let (_, carry) = mac(r0, k, MODULUS.0[0], 0);
  358|   233M|        let (r1, carry) = mac(r1, k, MODULUS.0[1], carry);
  359|   233M|        let (r2, carry) = mac(r2, k, MODULUS.0[2], carry);
  360|   233M|        let (r3, carry) = mac(r3, k, MODULUS.0[3], carry);
  361|   233M|        let (r4, carry2) = adc(r4, 0, carry);
  362|       |
  363|   233M|        let k = r1.wrapping_mul(INV);
  364|   233M|        let (_, carry) = mac(r1, k, MODULUS.0[0], 0);
  365|   233M|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  366|   233M|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
  367|   233M|        let (r4, carry) = mac(r4, k, MODULUS.0[3], carry);
  368|   233M|        let (r5, carry2) = adc(r5, carry2, carry);
  369|       |
  370|   233M|        let k = r2.wrapping_mul(INV);
  371|   233M|        let (_, carry) = mac(r2, k, MODULUS.0[0], 0);
  372|   233M|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  373|   233M|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  374|   233M|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  375|   233M|        let (r6, carry2) = adc(r6, carry2, carry);
  376|       |
  377|   233M|        let k = r3.wrapping_mul(INV);
  378|   233M|        let (_, carry) = mac(r3, k, MODULUS.0[0], 0);
  379|   233M|        let (r4, carry) = mac(r4, k, MODULUS.0[1], carry);
  380|   233M|        let (r5, carry) = mac(r5, k, MODULUS.0[2], carry);
  381|   233M|        let (r6, carry) = mac(r6, k, MODULUS.0[3], carry);
