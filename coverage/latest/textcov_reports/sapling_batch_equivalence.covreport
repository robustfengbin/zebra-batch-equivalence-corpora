  309|   109k|    pub fn pow_vartime(&self, by: &[u64; 6]) -> Self {
  310|   109k|        let mut res = Self::one();
  311|   657k|        for e in by.iter().rev() {
  312|  42.0M|            for i in (0..64).rev() {
  313|  42.0M|                res = res.square();
  314|       |
  315|  42.0M|                if ((*e >> i) & 1) == 1 {
  316|  25.0M|                    res *= self;
  317|  25.0M|                }
  318|       |            }
  319|       |        }
  320|   109k|        res
  321|   109k|    }
_RNvMs9_NtCsaKH4ngBG85u_9bls12_3812fpNtB5_2Fp17montgomery_reduce:
  487|   649M|    pub(crate) const fn montgomery_reduce(
  488|   649M|        t0: u64,
  489|   649M|        t1: u64,
  490|   649M|        t2: u64,
  491|   649M|        t3: u64,
  492|   649M|        t4: u64,
  493|   649M|        t5: u64,
  494|   649M|        t6: u64,
  495|   649M|        t7: u64,
  496|   649M|        t8: u64,
  497|   649M|        t9: u64,
  498|   649M|        t10: u64,
  499|   649M|        t11: u64,
  500|   649M|    ) -> Self {
  501|       |        // The Montgomery reduction here is based on Algorithm 14.32 in
  502|       |        // Handbook of Applied Cryptography
  503|       |        // <http://cacr.uwaterloo.ca/hac/about/chap14.pdf>.
  504|       |
  505|   649M|        let k = t0.wrapping_mul(INV);
  506|   649M|        let (_, carry) = mac(t0, k, MODULUS[0], 0);
  507|   649M|        let (r1, carry) = mac(t1, k, MODULUS[1], carry);
  508|   649M|        let (r2, carry) = mac(t2, k, MODULUS[2], carry);
  509|   649M|        let (r3, carry) = mac(t3, k, MODULUS[3], carry);
  510|   649M|        let (r4, carry) = mac(t4, k, MODULUS[4], carry);
  511|   649M|        let (r5, carry) = mac(t5, k, MODULUS[5], carry);
  512|   649M|        let (r6, r7) = adc(t6, 0, carry);
  513|       |
  514|   649M|        let k = r1.wrapping_mul(INV);
  515|   649M|        let (_, carry) = mac(r1, k, MODULUS[0], 0);
  516|   649M|        let (r2, carry) = mac(r2, k, MODULUS[1], carry);
  517|   649M|        let (r3, carry) = mac(r3, k, MODULUS[2], carry);
  518|   649M|        let (r4, carry) = mac(r4, k, MODULUS[3], carry);
  519|   649M|        let (r5, carry) = mac(r5, k, MODULUS[4], carry);
  520|   649M|        let (r6, carry) = mac(r6, k, MODULUS[5], carry);
  521|   649M|        let (r7, r8) = adc(t7, r7, carry);
  522|       |
  523|   649M|        let k = r2.wrapping_mul(INV);
  524|   649M|        let (_, carry) = mac(r2, k, MODULUS[0], 0);
  525|   649M|        let (r3, carry) = mac(r3, k, MODULUS[1], carry);
  526|   649M|        let (r4, carry) = mac(r4, k, MODULUS[2], carry);
  527|   649M|        let (r5, carry) = mac(r5, k, MODULUS[3], carry);
  528|   649M|        let (r6, carry) = mac(r6, k, MODULUS[4], carry);
  529|   649M|        let (r7, carry) = mac(r7, k, MODULUS[5], carry);
  530|   649M|        let (r8, r9) = adc(t8, r8, carry);
  531|       |
  532|   649M|        let k = r3.wrapping_mul(INV);
  533|   649M|        let (_, carry) = mac(r3, k, MODULUS[0], 0);
  534|   649M|        let (r4, carry) = mac(r4, k, MODULUS[1], carry);
  535|   649M|        let (r5, carry) = mac(r5, k, MODULUS[2], carry);
  536|   649M|        let (r6, carry) = mac(r6, k, MODULUS[3], carry);
  537|   649M|        let (r7, carry) = mac(r7, k, MODULUS[4], carry);
  538|   649M|        let (r8, carry) = mac(r8, k, MODULUS[5], carry);
  539|   649M|        let (r9, r10) = adc(t9, r9, carry);
  540|       |
  541|   649M|        let k = r4.wrapping_mul(INV);
  542|   649M|        let (_, carry) = mac(r4, k, MODULUS[0], 0);
  543|   649M|        let (r5, carry) = mac(r5, k, MODULUS[1], carry);
  544|   649M|        let (r6, carry) = mac(r6, k, MODULUS[2], carry);
  545|   649M|        let (r7, carry) = mac(r7, k, MODULUS[3], carry);
  546|   649M|        let (r8, carry) = mac(r8, k, MODULUS[4], carry);
  547|   649M|        let (r9, carry) = mac(r9, k, MODULUS[5], carry);
  548|   649M|        let (r10, r11) = adc(t10, r10, carry);
  549|       |
  550|   649M|        let k = r5.wrapping_mul(INV);
  551|   649M|        let (_, carry) = mac(r5, k, MODULUS[0], 0);
  552|   649M|        let (r6, carry) = mac(r6, k, MODULUS[1], carry);
  553|   649M|        let (r7, carry) = mac(r7, k, MODULUS[2], carry);
  554|   649M|        let (r8, carry) = mac(r8, k, MODULUS[3], carry);
  555|   649M|        let (r9, carry) = mac(r9, k, MODULUS[4], carry);
  556|   649M|        let (r10, carry) = mac(r10, k, MODULUS[5], carry);
  557|   649M|        let (r11, _) = adc(t11, r11, carry);
  558|       |
  559|       |        // Attempt to subtract the modulus, to ensure the value
  560|       |        // is smaller than the modulus.
  561|   649M|        (&Fp([r6, r7, r8, r9, r10, r11])).subtract_p()
  562|   649M|    }
