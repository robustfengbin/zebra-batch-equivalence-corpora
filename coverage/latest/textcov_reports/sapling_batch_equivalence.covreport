   95|   505k|            z2 = t0 + z2;
   96|   505k|            z2 = z2 + z2 + t0;
   97|       |
   98|   505k|            z3 = t2 - z3;
   99|   505k|            z3 = z3 + z3 + t2;
  100|       |
  101|   505k|            Fp12 {
  102|   505k|                c0: Fp6 {
  103|   505k|                    c0: z0,
  104|   505k|                    c1: z4,
  105|   505k|                    c2: z3,
  106|   505k|                },
  107|   505k|                c1: Fp6 {
  108|   505k|                    c0: z2,
  109|   505k|                    c1: z1,
  110|   505k|                    c2: z5,
  111|   505k|                },
  112|   505k|            }
  113|   505k|        }
