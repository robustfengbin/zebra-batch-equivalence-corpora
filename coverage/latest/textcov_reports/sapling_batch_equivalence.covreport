  670|  19.4M|    pub fn add(&self, rhs: &G1Projective) -> G1Projective {
  671|       |        // Algorithm 7, https://eprint.iacr.org/2015/1060.pdf
  672|       |
  673|  19.4M|        let t0 = self.x * rhs.x;
  674|  19.4M|        let t1 = self.y * rhs.y;
  675|  19.4M|        let t2 = self.z * rhs.z;
  676|  19.4M|        let t3 = self.x + self.y;
  677|  19.4M|        let t4 = rhs.x + rhs.y;
  678|  19.4M|        let t3 = t3 * t4;
  679|  19.4M|        let t4 = t0 + t1;
  680|  19.4M|        let t3 = t3 - t4;
  681|  19.4M|        let t4 = self.y + self.z;
  682|  19.4M|        let x3 = rhs.y + rhs.z;
  683|  19.4M|        let t4 = t4 * x3;
  684|  19.4M|        let x3 = t1 + t2;
  685|  19.4M|        let t4 = t4 - x3;
  686|  19.4M|        let x3 = self.x + self.z;
  687|  19.4M|        let y3 = rhs.x + rhs.z;
  688|  19.4M|        let x3 = x3 * y3;
  689|  19.4M|        let y3 = t0 + t2;
  690|  19.4M|        let y3 = x3 - y3;
  691|  19.4M|        let x3 = t0 + t0;
  692|  19.4M|        let t0 = x3 + t0;
  693|  19.4M|        let t2 = mul_by_3b(t2);
  694|  19.4M|        let z3 = t1 + t2;
  695|  19.4M|        let t1 = t1 - t2;
  696|  19.4M|        let y3 = mul_by_3b(y3);
  697|  19.4M|        let x3 = t4 * y3;
  698|  19.4M|        let t2 = t3 * t1;
  699|  19.4M|        let x3 = t2 - x3;
  700|  19.4M|        let y3 = y3 * t0;
  701|  19.4M|        let t1 = t1 * z3;
  702|  19.4M|        let y3 = t1 + y3;
  703|  19.4M|        let t0 = t0 * t3;
  704|  19.4M|        let z3 = z3 * t4;
  705|  19.4M|        let z3 = z3 + t0;
  706|       |
  707|  19.4M|        G1Projective {
  708|  19.4M|            x: x3,
  709|  19.4M|            y: y3,
  710|  19.4M|            z: z3,
  711|  19.4M|        }
  712|  19.4M|    }
_RNvMsu_NtCsaKH4ngBG85u_9bls12_3812g1NtB5_12G1Projective6double:
  638|  27.7M|    pub fn double(&self) -> G1Projective {
  639|       |        // Algorithm 9, https://eprint.iacr.org/2015/1060.pdf
  640|       |
  641|  27.7M|        let t0 = self.y.square();
  642|  27.7M|        let z3 = t0 + t0;
  643|  27.7M|        let z3 = z3 + z3;
  644|  27.7M|        let z3 = z3 + z3;
  645|  27.7M|        let t1 = self.y * self.z;
  646|  27.7M|        let t2 = self.z.square();
  647|  27.7M|        let t2 = mul_by_3b(t2);
  648|  27.7M|        let x3 = t2 * z3;
  649|  27.7M|        let y3 = t0 + t2;
  650|  27.7M|        let z3 = t1 * z3;
  651|  27.7M|        let t1 = t2 + t2;
  652|  27.7M|        let t2 = t1 + t2;
  653|  27.7M|        let t0 = t0 - t2;
  654|  27.7M|        let y3 = t0 * y3;
  655|  27.7M|        let y3 = x3 + y3;
  656|  27.7M|        let t1 = self.x * self.y;
  657|  27.7M|        let x3 = t0 * t1;
  658|  27.7M|        let x3 = x3 + x3;
  659|       |
  660|  27.7M|        let tmp = G1Projective {
  661|  27.7M|            x: x3,
  662|  27.7M|            y: y3,
  663|  27.7M|            z: z3,
  664|  27.7M|        };
  665|       |
  666|  27.7M|        G1Projective::conditional_select(&tmp, &G1Projective::identity(), self.is_identity())
  667|  27.7M|    }
