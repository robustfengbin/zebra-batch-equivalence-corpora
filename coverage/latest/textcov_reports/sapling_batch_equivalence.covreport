_RNvMs9_NtCsaKH4ngBG85u_9bls12_3812fpNtB5_2Fp10from_bytes:
  179|  2.29M|    pub fn from_bytes(bytes: &[u8; 48]) -> CtOption<Fp> {
  180|  2.29M|        let mut tmp = Fp([0, 0, 0, 0, 0, 0]);
  181|       |
  182|  2.29M|        tmp.0[5] = u64::from_be_bytes(<[u8; 8]>::try_from(&bytes[0..8]).unwrap());
  183|  2.29M|        tmp.0[4] = u64::from_be_bytes(<[u8; 8]>::try_from(&bytes[8..16]).unwrap());
  184|  2.29M|        tmp.0[3] = u64::from_be_bytes(<[u8; 8]>::try_from(&bytes[16..24]).unwrap());
  185|  2.29M|        tmp.0[2] = u64::from_be_bytes(<[u8; 8]>::try_from(&bytes[24..32]).unwrap());
  186|  2.29M|        tmp.0[1] = u64::from_be_bytes(<[u8; 8]>::try_from(&bytes[32..40]).unwrap());
  187|  2.29M|        tmp.0[0] = u64::from_be_bytes(<[u8; 8]>::try_from(&bytes[40..48]).unwrap());
  188|       |
  189|       |        // Try to subtract the modulus
  190|  2.29M|        let (_, borrow) = sbb(tmp.0[0], MODULUS[0], 0);
  191|  2.29M|        let (_, borrow) = sbb(tmp.0[1], MODULUS[1], borrow);
  192|  2.29M|        let (_, borrow) = sbb(tmp.0[2], MODULUS[2], borrow);
  193|  2.29M|        let (_, borrow) = sbb(tmp.0[3], MODULUS[3], borrow);
  194|  2.29M|        let (_, borrow) = sbb(tmp.0[4], MODULUS[4], borrow);
  195|  2.29M|        let (_, borrow) = sbb(tmp.0[5], MODULUS[5], borrow);
  196|       |
  197|       |        // If the element is smaller than MODULUS then the
  198|       |        // subtraction will underflow, producing a borrow value
  199|       |        // of 0xffff...ffff. Otherwise, it'll be zero.
  200|  2.29M|        let is_some = (borrow as u8) & 1;
  201|       |
  202|       |        // Convert to Montgomery form by computing
  203|       |        // (a.R^0 * R^2) / R = a.R
  204|  2.29M|        tmp *= &R2;
  205|       |
  206|  2.29M|        CtOption::new(tmp, Choice::from(is_some))
  207|  2.29M|    }
_RNvMs9_NtCsaKH4ngBG85u_9bls12_3812fpNtB5_2Fp10subtract_pB7_:
  361|  2.22G|    const fn subtract_p(&self) -> Fp {
  362|  2.22G|        let (r0, borrow) = sbb(self.0[0], MODULUS[0], 0);
  363|  2.22G|        let (r1, borrow) = sbb(self.0[1], MODULUS[1], borrow);
  364|  2.22G|        let (r2, borrow) = sbb(self.0[2], MODULUS[2], borrow);
  365|  2.22G|        let (r3, borrow) = sbb(self.0[3], MODULUS[3], borrow);
  366|  2.22G|        let (r4, borrow) = sbb(self.0[4], MODULUS[4], borrow);
  367|  2.22G|        let (r5, borrow) = sbb(self.0[5], MODULUS[5], borrow);
  368|       |
  369|       |        // If underflow occurred on the final limb, borrow = 0xfff...fff, otherwise
  370|       |        // borrow = 0x000...000. Thus, we use it as a mask!
  371|  2.22G|        let r0 = (self.0[0] & borrow) | (r0 & !borrow);
  372|  2.22G|        let r1 = (self.0[1] & borrow) | (r1 & !borrow);
  373|  2.22G|        let r2 = (self.0[2] & borrow) | (r2 & !borrow);
  374|  2.22G|        let r3 = (self.0[3] & borrow) | (r3 & !borrow);
  375|  2.22G|        let r4 = (self.0[4] & borrow) | (r4 & !borrow);
  376|  2.22G|        let r5 = (self.0[5] & borrow) | (r5 & !borrow);
  377|       |
  378|  2.22G|        Fp([r0, r1, r2, r3, r4, r5])
  379|  2.22G|    }
