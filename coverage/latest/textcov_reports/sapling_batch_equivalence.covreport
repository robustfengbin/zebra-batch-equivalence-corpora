  630|   224k|        let (d2, carry) = adc(d2, MODULUS.0[2] & borrow, carry);
  631|   224k|        let (d3, _) = adc(d3, MODULUS.0[3] & borrow, carry);
  632|       |
  633|   224k|        Fr([d0, d1, d2, d3])
  634|   224k|    }
