  396|   410M|    pub const fn neg(&self) -> Fp {
  397|   410M|        let (d0, borrow) = sbb(MODULUS[0], self.0[0], 0);
  398|   410M|        let (d1, borrow) = sbb(MODULUS[1], self.0[1], borrow);
