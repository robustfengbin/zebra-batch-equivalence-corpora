  342|  47.8M|    const fn montgomery_reduce(
  343|  47.8M|        r0: u64,
  344|  47.8M|        r1: u64,
  345|  47.8M|        r2: u64,
  346|  47.8M|        r3: u64,
  347|  47.8M|        r4: u64,
  348|  47.8M|        r5: u64,
  349|  47.8M|        r6: u64,
  350|  47.8M|        r7: u64,
  351|  47.8M|    ) -> Self {
  352|       |        // The Montgomery reduction here is based on Algorithm 14.32 in
  353|       |        // Handbook of Applied Cryptography
  354|       |        // <http://cacr.uwaterloo.ca/hac/about/chap14.pdf>.
  355|       |
  356|  47.8M|        let k = r0.wrapping_mul(INV);
  357|  47.8M|        let (_, carry) = mac(r0, k, MODULUS.0[0], 0);
  358|  47.8M|        let (r1, carry) = mac(r1, k, MODULUS.0[1], carry);
  359|  47.8M|        let (r2, carry) = mac(r2, k, MODULUS.0[2], carry);
  360|  47.8M|        let (r3, carry) = mac(r3, k, MODULUS.0[3], carry);
  361|  47.8M|        let (r4, carry2) = adc(r4, 0, carry);
  362|       |
  363|  47.8M|        let k = r1.wrapping_mul(INV);
  364|  47.8M|        let (_, carry) = mac(r1, k, MODULUS.0[0], 0);
  365|  47.8M|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  366|  47.8M|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
  367|  47.8M|        let (r4, carry) = mac(r4, k, MODULUS.0[3], carry);
  368|  47.8M|        let (r5, carry2) = adc(r5, carry2, carry);
  369|       |
  370|  47.8M|        let k = r2.wrapping_mul(INV);
  371|  47.8M|        let (_, carry) = mac(r2, k, MODULUS.0[0], 0);
  372|  47.8M|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  373|  47.8M|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  374|  47.8M|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  375|  47.8M|        let (r6, carry2) = adc(r6, carry2, carry);
  376|       |
  377|  47.8M|        let k = r3.wrapping_mul(INV);
  378|  47.8M|        let (_, carry) = mac(r3, k, MODULUS.0[0], 0);
  379|  47.8M|        let (r4, carry) = mac(r4, k, MODULUS.0[1], carry);
  380|  47.8M|        let (r5, carry) = mac(r5, k, MODULUS.0[2], carry);
  381|  47.8M|        let (r6, carry) = mac(r6, k, MODULUS.0[3], carry);
  382|  47.8M|        let (r7, _) = adc(r7, carry2, carry);
  383|       |
