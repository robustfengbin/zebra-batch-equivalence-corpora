   86|  4.42k|pub fn zcash_deserialize_external_count<R: io::Read, T: ZcashDeserialize + TrustedPreallocate>(
   87|  4.42k|    external_count: usize,
   88|  4.42k|    mut reader: R,
   89|  4.42k|) -> Result<Vec<T>, SerializationError> {
   90|  4.42k|    match u64::try_from(external_count) {
   91|  4.42k|        Ok(external_count) if external_count > T::max_allocation() => {
   92|      7|            return Err(SerializationError::Parse(
   93|      7|                "Vector longer than max_allocation",
   94|      7|            ))
   95|       |        }
   96|  4.42k|        Ok(_) => {}
   97|       |        // As of 2021, usize is less than or equal to 64 bits on all (or almost all?) supported Rust platforms.
   98|       |        // So in practice this error is impossible. (But the check is required, because Rust is future-proof
   99|       |        // for 128 bit memory spaces.)
  100|      0|        Err(_) => return Err(SerializationError::Parse("Vector longer than u64::MAX")),
