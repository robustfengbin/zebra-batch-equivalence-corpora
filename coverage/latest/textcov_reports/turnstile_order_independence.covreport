  193|    122|    fn zcash_deserialize<R: io::Read>(mut reader: R) -> Result<Self, SerializationError> {
  194|       |        // # Consensus
  195|       |        //
  196|       |        // > Elements of a JoinSplit description MUST have the types given above
  197|       |        //
  198|       |        // https://zips.z.cash/protocol/protocol.pdf#joinsplitdesc
  199|       |        //
  200|       |        // See comments below for each specific type.
  201|       |        Ok(JoinSplit::<P> {
  202|       |            // Type is `{0 .. MAX_MONEY}`; see [`NonNegative::valid_range()`].
  203|    122|            vpub_old: (&mut reader).zcash_deserialize_into()?,
  204|     88|            vpub_new: (&mut reader).zcash_deserialize_into()?,
  205|       |            // Type is `B^{ℓ^{Sprout}_{Merkle}}` i.e. 32 bytes.
  206|     80|            anchor: tree::Root::from(reader.read_32_bytes()?),
  207|       |            // Types are `B^{ℓ^{Sprout}_{PRF}}` i.e. 32 bytes.
  208|       |            nullifiers: [
  209|     75|                reader.read_32_bytes()?.into(),
  210|     72|                reader.read_32_bytes()?.into(),
  211|       |            ],
  212|       |            // Types are `NoteCommit^{Sprout}.Output`, i.e. `B^{ℓ^{Sprout}_{Merkle}}`,
  213|       |            // i.e. 32 bytes. https://zips.z.cash/protocol/protocol.pdf#abstractcommit
  214|       |            commitments: [
  215|     69|                commitment::NoteCommitment::from(reader.read_32_bytes()?),
  216|     66|                commitment::NoteCommitment::from(reader.read_32_bytes()?),
