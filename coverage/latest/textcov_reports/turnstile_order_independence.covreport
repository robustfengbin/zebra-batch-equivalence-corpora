  378|    335|    pub const fn from_num_days_from_ce_opt(days: i32) -> Option<NaiveDate> {
  379|    335|        let days = try_opt!(days.checked_add(365)); // make December 31, 1 BCE equal to day 0
  380|    335|        let year_div_400 = days.div_euclid(146_097);
  381|    335|        let cycle = days.rem_euclid(146_097);
  382|    335|        let (year_mod_400, ordinal) = cycle_to_yo(cycle as u32);
  383|    335|        let flags = YearFlags::from_year_mod_400(year_mod_400 as i32);
  384|    335|        NaiveDate::from_ordinal_and_flags(year_div_400 * 400 + year_mod_400 as i32, ordinal, flags)
