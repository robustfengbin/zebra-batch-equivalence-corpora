 2422|    244|const fn cycle_to_yo(cycle: u32) -> (u32, u32) {
 2423|    244|    let mut year_mod_400 = cycle / 365;
 2424|    244|    let mut ordinal0 = cycle % 365;
 2425|    244|    let delta = YEAR_DELTAS[year_mod_400 as usize] as u32;
 2426|    244|    if ordinal0 < delta {
 2427|     51|        year_mod_400 -= 1;
 2428|     51|        ordinal0 += 365 - YEAR_DELTAS[year_mod_400 as usize] as u32;
 2429|    193|    } else {
 2430|    193|        ordinal0 -= delta;
 2431|    193|    }
 2432|    244|    (year_mod_400, ordinal0 + 1)
 2433|    244|}

