 2422|    335|const fn cycle_to_yo(cycle: u32) -> (u32, u32) {
 2423|    335|    let mut year_mod_400 = cycle / 365;
 2424|    335|    let mut ordinal0 = cycle % 365;
 2425|    335|    let delta = YEAR_DELTAS[year_mod_400 as usize] as u32;
 2426|    335|    if ordinal0 < delta {
 2427|     35|        year_mod_400 -= 1;
 2428|     35|        ordinal0 += 365 - YEAR_DELTAS[year_mod_400 as usize] as u32;
 2429|    300|    } else {
 2430|    300|        ordinal0 -= delta;
 2431|    300|    }
 2432|    335|    (year_mod_400, ordinal0 + 1)
 2433|    335|}

